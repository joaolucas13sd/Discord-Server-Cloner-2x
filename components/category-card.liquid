{% if category.icon %}
{%- assign total = category.products.size | default: 0 -%}
<a href="/category/{{ category.slug | default: category.id }}" class="swiper-slide kc-tile group">
  <span class="kc-photo">
    <img src="{{ category.icon }}" alt="{{ category.name | default: 'Categoria' }}" class="kc-img" loading="lazy" decoding="async" />
  </span>
  <span class="kc-panel">
    <span class="kc-name">{{ category.name | default: 'Categoria' }}</span>
    <span class="kc-row">
      <span class="kc-sub">
        {%- if total > 0 -%}
          {{ total }} {% if total == 1 %}produto{% else %}produtos{% endif %}
        {%- else -%}
          {{ category.sub_title | default: 'Ver produtos' }}
        {%- endif -%}
      </span>
      <span class="kc-go" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    </span>
  </span>
</a>
{% endif %}
