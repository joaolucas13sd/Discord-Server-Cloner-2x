<a
  href="/product/{{ product.slug | default: product.id }}"
  {% if product.type == 'variante' %}
    data-price="{{ product.variants_values.min.price | default: 0 }}"
    data-comparison="0"
  {% else %}
    data-price="{{ product.price | default: 0 }}"
    data-comparison="{{ product.comparison | default: 0 }}"
  {% endif %}
  class="select-none h-full group bg-neutral-950 border border-neutral-800 hover:border-neutral-500 rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-black/30 flex flex-col"
>
  <div class="relative aspect-[16/9] bg-neutral-900 overflow-hidden">
    <!-- Badge tipo de entrega -->
    {% if product.type != 'variante' %}
      <div class="absolute top-2 left-2 z-10 flex items-center px-1.5 py-1 rounded-full bg-white shadow-md shadow-black/30 transition-all duration-300">
        <span class="flex-shrink-0">
          {% if product.automatic %}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#000000" viewBox="0 0 256 256">
              <path d="M213.85,125.46l-112,120a8,8,0,0,1-13.69-7l14.66-73.33L45.19,143.49a8,8,0,0,1-3-13l112-120a8,8,0,0,1,13.69,7L153.18,90.9l57.63,21.61a8,8,0,0,1,3,12.95Z"></path>
            </svg>
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#000000" viewBox="0 0 256 256">
              <path d="M120,140a12,12,0,0,1-12-12V45l-7.51,7.51a12,12,0,0,1-17-17l28-28a12,12,0,0,1,17,0l28,28a12,12,0,1,1-17,17L132,45v83A12,12,0,0,1,120,140Zm76-18.48V96a20,20,0,0,0-20-20H164a12,12,0,0,0,0,24h8v68.3A32,32,0,0,0,128.29,212c.11.2.23.39.35.58l22.26,34A12,12,0,1,0,171,233.43l-22-33.66a8,8,0,0,1,14-7.77c.11.2.23.39.36.58L174,208.88a12,12,0,0,0,22-6.57V154a70.66,70.66,0,0,1,16,44.61V240a12,12,0,0,0,24,0V198.65A94.91,94.91,0,0,0,196,121.52ZM76,76H64A20,20,0,0,0,44,96V200a12,12,0,0,0,24,0V100h8a12,12,0,0,0,0-24Z"></path>
            </svg>
          {% endif %}
        </span>
        <span class="overflow-hidden max-w-0 group-hover:max-w-[140px] group-hover:ml-1.5 text-[10px] sm:text-xs font-semibold text-black whitespace-nowrap transition-all duration-300">
          {% if product.automatic %}Entrega Automática{% else %}Entrega Manual{% endif %}
        </span>
      </div>
    {% endif %}

    <!-- Imagem do produto -->
    {% if product.images[0] %}
      <img
        src="{{ product.images[0] }}"
        alt="{{ product.name }}"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      >
    {% else %}
      <div class="w-full h-full flex flex-col items-center justify-center gap-2 text-neutral-700">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-12 w-12"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="text-xs">Sem imagem</span>
      </div>
    {% endif %}
  </div>

  <!-- Info do produto -->
  <div class="flex-1 p-2.5 sm:p-3 flex flex-col justify-between">
    <h3 class="text-white font-semibold text-xs sm:text-sm leading-snug group-hover:text-neutral-300 transition-colors line-clamp-2">
      {{ product.name }}
    </h3>

    <div class="flex flex-col">
      <div class="pt-2.5 sm:pt-4 flex items-end justify-between gap-1">
        <!-- Preços -->
        <div class="min-w-0 flex-1">
          {% if product.type == 'variante' and product.variants_values.min %}
            <p class="flex gap-1 items-center text-base sm:text-xl font-extrabold text-white truncate">
              {{ product.variants_values.min.price | priceFormatter }}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#ffffff" viewBox="0 0 256 256">
                <path d="M228,128a12,12,0,0,1-12,12H140v76a12,12,0,0,1-24,0V140H40a12,12,0,0,1,0-24h76V40a12,12,0,0,1,24,0v76h76A12,12,0,0,1,228,128Z"></path>
              </svg>
            </p>
          {% else %}
            {% if product.comparison and product.comparison > 0 and product.price < product.comparison %}
              <div class="flex items-center gap-1.5">
                <p class="text-xs text-neutral-600 line-through truncate">
                  {{ product.comparison | priceFormatter }}
                </p>
                {% if product.discount_percentage and product.discount_percentage > 0 %}
                  <span class="text-[10px] sm:text-xs font-bold text-green-400 px-0.5 py-0.5 rounded-md">
                    -{{ product.discount_percentage }}%
                  </span>
                {% endif %}
              </div>
            {% endif %}

            <div class="flex justify-between gap-2">
              <p class="text-base sm:text-xl font-extrabold text-white truncate">
                {% if product.price == 0 %}
                  <span class="text-neutral-300">Grátis</span>
                {% else %}
                  {{ product.price | priceFormatter }}
                {% endif %}
              </p>

              <!-- Estoque -->
              <div class="text-right flex-shrink-0">
                {% unless product.type == 'variante' %}
                  {% if  product.type != 'texto' %}
                    {% if product.stock_amount > 0 %}
                      <span class="text-[10px] sm:text-xs text-neutral-400 font-medium">
                        {{- product.stock_amount }} estoque</span
                      >
                    {% else %}
                      <span class="text-[10px] sm:text-xs text-neutral-500 font-medium">Indisponível</span>
                    {% endif %}
                  {% else %}
                    <span class="text-[10px] sm:text-xs text-neutral-400 font-medium">Disponível</span>
                  {% endif %}
                {% endunless %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Botão comprar -->
      {% if product.type == 'variante' %}
        <button
          type="button"
          class="mt-2.5 sm:mt-4 w-full py-2 sm:py-2.5 px-3 sm:px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 bg-white hover:bg-neutral-200 text-black hover:shadow-md hover:shadow-black/20"
        >
          Ver Detalhes
        </button>
      {% else %}
        <button
          type="button"
          class="
            mt-2.5 sm:mt-4 w-full py-2 sm:py-2.5 px-3 sm:px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200
            {% if product.stock_amount > 0 %}
              bg-white hover:bg-neutral-200 text-black hover:shadow-md hover:shadow-black/20
            {% else %}
              bg-neutral-900 text-neutral-600 cursor-not-allowed border border-neutral-800
            {% endif %}
          "
          {% if product.stock_amount == 0 %}
            disabled
          {% endif %}
        >
          {% if product.stock_amount > 0 %}Comprar Agora{% else %}Sem estoque{% endif %}
        </button>
      {% endif %}
    </div>
  </div>
</a>
