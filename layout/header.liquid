                  </svg>
                  <span class="font-medium">Compras</span>
                </a>
                {% if cashback.can_earn_balance or cashback.can_use_balance %}
                <a
                  href="/account/cashback"
                  class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-neutral-300 hover:text-white hover:bg-neutral-800/80 transition-all"
                  role="menuitem"
                >
                  <svg class="w-4 h-4 text-neutral-500 group-hover:text-white flex-shrink-0" fill="currentColor" viewBox="0 0 256 256">
                    <path d="M184,89.57V84c0-25.08-37.83-44-88-44S8,58.92,8,84v40c0,20.89,26.25,37.49,64,42.46V172c0,25.08,37.83,44,88,44s88-18.92,88-44V132C248,111.3,222.58,94.68,184,89.57ZM232,132c0,13.22-30.79,28-72,28-3.73,0-7.43-.13-11.08-.37C170.49,151.77,184,139,184,124V105.74C213.87,110.19,232,122.27,232,132ZM72,150.25V126.46A183.74,183.74,0,0,0,96,128a183.74,183.74,0,0,0,24-1.54v23.79A163,163,0,0,1,96,152,163,163,0,0,1,72,150.25Zm96-40.32V124c0,8.39-12.41,17.4-32,22.87V123.5C148.91,120.37,159.84,115.71,168,109.93ZM96,56c41.21,0,72,14.78,72,28s-30.79,28-72,28S24,97.22,24,84,54.79,56,96,56ZM24,124V109.93c8.16,5.78,19.09,10.44,32,13.57v23.37C36.41,141.4,24,132.39,24,124Zm64,48v-4.17c2.63.1,5.29.17,8,.17,3.88,0,7.67-.13,11.39-.35A121.92,121.92,0,0,0,120,171.41v23.46C100.41,189.4,88,180.39,88,172Zm48,26.25V174.4a179.48,179.48,0,0,0,24,1.6,183.74,183.74,0,0,0,24-1.54v23.79a165.45,165.45,0,0,1-48,0Zm64-3.38V171.5c12.91-3.13,23.84-7.79,32-13.57V172C232,180.39,219.59,189.4,200,194.87Z"/>
                  </svg>
                  <span class="font-medium min-w-0 break-words">{{ cashback.program_name | default: 'Cashback' }}</span>
                </a>
                {% endif %}
                <a
                  href="/account/affiliate"
                  class="group flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-neutral-300 hover:text-white hover:bg-neutral-800/80 transition-all"
                  role="menuitem"
                >
                  <svg class="w-4 h-4 text-neutral-500 group-hover:text-white flex-shrink-0" fill="currentColor" viewBox="0 0 256 256">
                    <path d="M244.8,150.4a8,8,0,0,1-11.2-1.6A51.6,51.6,0,0,0,192,128a8,8,0,0,1-7.37-4.89,8,8,0,0,1,0-6.22A8,8,0,0,1,192,112a24,24,0,1,0-23.24-30,8,8,0,1,1-15.5-4A40,40,0,1,1,219,117.51a67.94,67.94,0,0,1,27.43,21.68A8,8,0,0,1,244.8,150.4ZM190.92,212a8,8,0,1,1-13.84,8,57,57,0,0,0-98.16,0,8,8,0,1,1-13.84-8,72.06,72.06,0,0,1,33.74-29.92,48,48,0,1,1,58.36,0A72.06,72.06,0,0,1,190.92,212ZM128,176a32,32,0,1,0-32-32A32,32,0,0,0,128,176ZM72,120a8,8,0,0,0-8-8A24,24,0,1,1,87.24,82a8,8,0,1,0,15.5-4A40,40,0,1,0,37,117.51,67.94,67.94,0,0,0,9.6,139.19a8,8,0,1,0,12.8,9.61A51.6,51.6,0,0,1,64,128,8,8,0,0,0,72,120Z"/>
                  </svg>
                  <span class="font-medium">Afiliado</span>
                </a>

                <div class="my-1 border-t border-neutral-800/80"></div>

                <form action="/api/auth/logout" method="POST" class="m-0">
                  <button
                    type="submit"
                    class="group flex items-center gap-3 w-full text-left px-3 py-2.5 rounded-xl text-sm text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-all"
                    role="menuitem"
                  >
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    <span class="font-medium">Sair</span>
                  </button>
                </form>
              </nav>
            </div>
          </div>

          <script>
            (function () {
              var btn = document.getElementById('user-btn');
              var dropdown = document.getElementById('user-dropdown');
              var chevron = document.getElementById('user-chevron');
              if (!btn || !dropdown) return;

              function setOpen(open) {
                if (open) {
                  dropdown.classList.remove('hidden');
                  btn.setAttribute('aria-expanded', 'true');
                  if (chevron) chevron.style.transform = 'rotate(180deg)';
                } else {
                  dropdown.classList.add('hidden');
                  btn.setAttribute('aria-expanded', 'false');
                  if (chevron) chevron.style.transform = '';
                }
              }

              btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                setOpen(dropdown.classList.contains('hidden'));
              });

              document.addEventListener('click', function (e) {
                if (dropdown.classList.contains('hidden')) return;
                if (e.target.closest('#user-dropdown') || e.target.closest('#user-btn')) return;
                setOpen(false);
              });

              document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !dropdown.classList.contains('hidden')) setOpen(false);
              });
            })();
          </script>
        {% else %}
          <!-- Mobile: login icon (links direto p/ /login) -->
          <a
            href="/login"
            class="sm:hidden p-2 rounded-xl text-neutral-400 hover:text-white hover:bg-neutral-800/80 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-neutral-600"
            aria-label="Entrar"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
          </a>
          <!-- Desktop: botão "Entrar" -->
          <a href="/login" class="hidden sm:flex sm:items-center">
            <button class="bg-white p-1 rounded-full text-black hover:bg-neutral-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-black focus:ring-white px-4 py-2 text-sm transition-colors font-semibold">
              Entrar
            </button>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</header>

<!-- Mobile Search Modal -->
<div id="mobile-search-modal" class="fixed inset-0 z-[60] hidden">
  <!-- Backdrop -->
  <div
    id="mobile-search-backdrop"
    class="absolute inset-0 bg-black/90 backdrop-blur-sm transition-opacity duration-300 opacity-0"
  ></div>

  <!-- Content -->
  <div
    id="mobile-search-content"
    class="relative bg-neutral-950 h-full flex flex-col transform translate-y-full transition-transform duration-300 ease-out"
  >
    <div class="flex items-center px-4 py-3 gap-3 border-b border-neutral-900">
      <button
        id="mobile-search-close"
        class="p-1 text-neutral-400 hover:text-white transition-colors"
        aria-label="Voltar"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      </button>
      <div class="flex-1 relative">
        <input
          id="mobile-search-input"
          type="text"
          placeholder="Pesquisar..."
          class="w-full bg-neutral-900 border border-neutral-800 rounded-xl py-2.5 pl-4 pr-10 text-white text-sm focus:outline-none focus:ring-2 focus:ring-white/20 transition-all"
          autocomplete="off"
        >
        <button
          id="mobile-search-clear"
          class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-neutral-500 hover:text-white"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-search-results" class="flex-1 overflow-y-auto px-4 py-4">
      <div class="mb-4">
        <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Resultados</span>
      </div>
      <div id="mobile-search-results-container" class="space-y-3">
        <!-- Results injected here -->
      </div>
      <div id="mobile-search-empty-state" class="hidden py-16 text-center">
        <svg class="w-12 h-12 text-neutral-800 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="text-neutral-400 font-medium">Ops! Nada encontrado</p>
        <p class="text-neutral-600 text-sm mt-1">Tente pesquisar por outro nome.</p>
      </div>
    </div>
  </div>
</div>
