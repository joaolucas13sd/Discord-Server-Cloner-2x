          <div class="relative text-neutral-400 focus-within:text-white transition-all duration-300">
            <div class="pointer-events-none absolute inset-y-0 left-0 pl-3 flex items-center">
              <svg class="hdr-ico text-neutral-400" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
