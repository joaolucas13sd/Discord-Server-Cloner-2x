              <div id="cart-items-container" class="p-2 space-y-2"></div>
            </div>

            <!-- Dropdown Footer -->
            <div
              id="cart-dropdown-footer"
              class="border-t border-neutral-800 px-4 py-3 bg-neutral-950/95 space-y-2.5"
              style="display:none;"
            >
              <div class="flex items-center justify-between">
                <span class="text-xs text-neutral-500 font-medium uppercase tracking-wide">Total</span>
                <span id="cart-total-price" class="text-lg font-extrabold text-white">R$ 0,00</span>
              </div>
              <button
                id="cart-checkout-btn"
                class="w-full flex items-center justify-center gap-2 py-2.5 bg-white hover:bg-neutral-200 active:bg-neutral-300 text-black font-bold rounded-xl shadow-lg shadow-black/30 transition-all duration-200 text-sm focus:outline-none"
              >
                Finalizar Compra
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        {% if user.name %}
          <!-- User Profile Button (wrapper for dropdown positioning) -->
          <div class="relative" id="user-wrapper">
            <button
              id="user-btn"
              class="flex items-center gap-2 p-1.5 sm:pl-2 sm:pr-2.5 rounded-xl text-neutral-300 hover:text-white hover:bg-neutral-800/80 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-neutral-600"
              aria-label="Perfil"
              aria-haspopup="menu"
              aria-expanded="false"
