<style>
  :root {
    /* ── Paleta base ─────────────────────────────────────── */
    --color-accent:        #FF422A;   /* vermelho/laranja principal */
    --color-accent-hover:  #FF5A45;
    --color-accent-active: #E5361F;
    --color-accent-soft:   rgba(255,66,42,0.12);
    --color-accent-glow:   rgba(255,66,42,0.35);
    --gradient-accent:     linear-gradient(135deg, #FF6B3D 0%, #FF422A 55%, #E5361F 100%);
    --gradient-accent-hover: linear-gradient(135deg, #FF7D52 0%, #FF5A45 55%, #FF422A 100%);

    /* ── Backgrounds ─────────────────────────────────────── */
    --color-bg-base:       #000000;   /* fundo principal */
    --color-bg-surface:    #0c0908;   /* cards, painéis */
    --color-bg-subtle:     #161110;   /* inputs, preço, variantes */
    --color-bg-muted:      #241917;   /* hover, badges, thumbs */
    --color-bg-faint:      #3a2724;   /* quantity, foco */

    /* ── Borders ─────────────────────────────────────────── */
    --color-border:        #261c1a;
    --color-border-subtle: #3a2a27;
    --color-border-focus:  #FF422A;

    /* ── Text ────────────────────────────────────────────── */
    --color-text-primary:  #ffffff;
    --color-text-secondary:#e5e5e5;
    --color-text-muted:    #a8a3a2;
    --color-text-faint:    #7a7271;
    --color-text-disabled: #544c4b;

    /* ── CTA / Ação principal ────────────────────────────── */
    --color-cta-bg:        #FF422A;
    --color-cta-bg-hover:  #FF5A45;
    --color-cta-text:      #ffffff;

    /* ── Botão secundário (vidro escuro, como "Chat With Us") ─ */
    --color-btn-secondary-bg:       #161110;
    --color-btn-secondary-bg-hover: #241917;
    --color-btn-secondary-text:     #ffffff;

    /* ── Acentos semânticos ──────────────────────────────── */
    --color-success:  #4ade80;
    --color-warning:  #FF8A3D;   /* estrelas em laranja, combinando com a paleta */
    --color-error:    #FF422A;
    --color-info:     #60a5fa;

    /* ── Overlay / Glassmorphism ─────────────────────────── */
    --color-overlay:        rgba(0,0,0,0.80);
    --color-surface-alpha:  rgba(22,17,16,0.45);
    --color-surface-alpha2: rgba(22,17,16,0.65);

    /* ── Gradientes ──────────────────────────────────────── */
    --gradient-overlay-bottom: linear-gradient(to top, rgba(0,0,0,0.90), rgba(0,0,0,0.30), transparent);
    --gradient-overlay-right:  linear-gradient(to right, #000000, rgba(0,0,0,0.80), transparent);
    --gradient-glow-page:      radial-gradient(ellipse 90% 55% at 50% -12%, rgba(255,66,42,0.28), rgba(255,66,42,0.06) 45%, transparent 75%);

    /* ── Sombras ─────────────────────────────────────────── */
    --shadow-card:   0 20px 25px -5px rgba(0,0,0,0.5), 0 8px 10px -6px rgba(0,0,0,0.5);
    --shadow-cta:    0 10px 25px -6px rgba(255,66,42,0.55);

    /* ── Border Radius ───────────────────────────────────── */
    --radius-sm:   0.5rem;
    --radius-md:   0.75rem;
    --radius-lg:   1rem;
    --radius-xl:   1.5rem;

    /* ── Transição padrão ────────────────────────────────── */
    --transition: 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ================================================================
     THEME OVERRIDES — mapeia classes Tailwind → variáveis CSS root
     Altere apenas as variáveis acima para recolorir toda a loja.
     ================================================================ */

  /* -- Backgrounds ------------------------------------------------- */
  .bg-black                { background-color: var(--color-bg-base)    !important; }
  .bg-neutral-950          { background-color: var(--color-bg-surface)  !important; }
  .bg-neutral-900          { background-color: var(--color-bg-subtle)   !important; }
  .bg-neutral-800          { background-color: var(--color-bg-muted)    !important; }
  .bg-neutral-700          { background-color: var(--color-bg-faint)    !important; }
  .bg-white                { background-color: var(--color-cta-bg)      !important; }

  /* alpha/opacity variants */
  .bg-neutral-900\/40      { background-color: var(--color-surface-alpha)  !important; }
  .bg-neutral-900\/60      { background-color: var(--color-surface-alpha2) !important; }
  .bg-neutral-950\/80      { background-color: color-mix(in srgb, var(--color-bg-surface) 80%, transparent) !important; }
  .bg-black\/80            { background-color: var(--color-overlay) !important; }
  .bg-black\/70            { background-color: rgba(0,0,0,0.70)    !important; }
  .bg-black\/50            { background-color: rgba(0,0,0,0.50)    !important; }
  .bg-white\/5             { background-color: rgba(255,255,255,0.05) !important; }
  .bg-white\/10            { background-color: rgba(255,255,255,0.10) !important; }

  /* -- Text -------------------------------------------------------- */
  .text-white              { color: var(--color-text-primary)   !important; }
  .text-neutral-200        { color: var(--color-text-secondary) !important; }
  .text-neutral-300        { color: var(--color-text-secondary) !important; }
  .text-neutral-400        { color: var(--color-text-muted)     !important; }
  .text-neutral-500        { color: var(--color-text-faint)     !important; }
  .text-neutral-600        { color: var(--color-text-disabled)  !important; }
  .text-neutral-700        { color: var(--color-text-disabled)  !important; }
  .text-neutral-800        { color: var(--color-text-disabled)  !important; }
  .text-black              { color: var(--color-cta-text)       !important; }
  .text-green-400          { color: var(--color-success)        !important; }
  .text-yellow-400         { color: var(--color-warning)        !important; }
  .text-red-500            { color: var(--color-error)          !important; }
  .text-blue-400           { color: var(--color-info)           !important; }

  /* -- Borders ----------------------------------------------------- */
  .border-neutral-800      { border-color: var(--color-border)        !important; }
  .border-neutral-700      { border-color: var(--color-border-subtle) !important; }
  .border-neutral-600      { border-color: var(--color-border-subtle) !important; }
  .border-neutral-500      { border-color: var(--color-border-focus)  !important; }
  .border-neutral-900      { border-color: var(--color-bg-subtle)     !important; }
  .border-white            { border-color: var(--color-cta-bg)        !important; }

  /* border-b active tab */
  .border-b-white          { border-bottom-color: var(--color-cta-bg) !important; }

  /* border alpha */
  .border-neutral-700\/30  { border-color: rgba(64,64,64,0.30) !important; }
  .border-neutral-700\/20  { border-color: rgba(64,64,64,0.20) !important; }
  .border-neutral-800\/40  { border-color: rgba(38,38,38,0.40) !important; }
  .border-neutral-800\/60  { border-color: rgba(38,38,38,0.60) !important; }
  .border-dashed           { } /* preserva estilo dashed */

  /* divide */
  .divide-neutral-800 > * + * { border-color: var(--color-border) !important; }

  /* -- Hover: backgrounds ------------------------------------------ */
  .hover\:bg-neutral-200:hover { background-color: var(--color-cta-bg-hover)              !important; }
  .hover\:bg-neutral-800:hover { background-color: var(--color-btn-secondary-bg-hover)    !important; }
  .hover\:bg-neutral-900:hover { background-color: var(--color-btn-secondary-bg)          !important; }
  .hover\:bg-neutral-700:hover { background-color: var(--color-bg-faint)                  !important; }

  /* -- Hover: text ------------------------------------------------- */
  .hover\:text-white:hover      { color: var(--color-text-primary)   !important; }
  .hover\:text-neutral-200:hover{ color: var(--color-text-secondary) !important; }
  .hover\:text-neutral-300:hover{ color: var(--color-text-secondary) !important; }

  /* -- Hover: borders ---------------------------------------------- */
  .hover\:border-neutral-500:hover { border-color: var(--color-border-focus)  !important; }
  .hover\:border-neutral-700:hover { border-color: var(--color-border-subtle) !important; }
  .hover\:border-neutral-600:hover { border-color: var(--color-border-subtle) !important; }

  /* -- Focus rings ------------------------------------------------- */
  .focus\:ring-neutral-600:focus { --tw-ring-color: var(--color-border-focus)  !important; }
  .focus\:ring-neutral-700:focus { --tw-ring-color: var(--color-border-subtle) !important; }
  .focus\:border-neutral-500:focus { border-color: var(--color-border-focus)   !important; }

  /* -- Gradients: hero-banner, category-card, index banner --------- */
  .from-black\/80  { --tw-gradient-from: rgba(0,0,0,0.80) !important; }
  .from-black\/90  { --tw-gradient-from: rgba(0,0,0,0.90) !important; }
  .via-black\/80   { --tw-gradient-via:  rgba(0,0,0,0.80) !important; }
  .via-black\/20   { --tw-gradient-via:  rgba(0,0,0,0.20) !important; }
  .via-black\/30   { --tw-gradient-via:  rgba(0,0,0,0.30) !important; }

  /* -- Swiper accent (product page) -------------------------------- */
  .related-products-swiper .swiper-pagination-bullet-active {
    background: var(--color-cta-bg) !important;
  }
  .related-products-swiper .swiper-button-next:hover,
  .related-products-swiper .swiper-button-prev:hover {
    background-color: var(--color-cta-bg-hover) !important;
    color: var(--color-cta-text) !important;
  }

  /* -- Star ratings ------------------------------------------------ */
  .text-yellow-400 { color: var(--color-warning) !important; }

  /* -- Sidebar active indicator (category page) -------------------- */
  .sidebar-link::before { background: var(--color-accent); }
  .sidebar-link.active  { background: var(--color-accent-soft); }
  .sidebar-link:hover   { background: rgba(255,255,255,0.04); }

  /* ================================================================
     ACCENT #FF422A — estilo da referência (glow vermelho + CTAs em gradiente)
     ================================================================ */

  /* brilho vermelho no topo da página */
  main.bg-black {
    background-image: var(--gradient-glow-page) !important;
    background-repeat: no-repeat !important;
  }

  /* CTAs: gradiente vermelho com glow */
  .bg-white {
    background-image: var(--gradient-accent) !important;
  }
  .bg-white.text-black,
  .bg-white .text-black {
    box-shadow: var(--shadow-cta);
  }
  .hover\:bg-neutral-200:hover,
  .group:hover .group-hover\:bg-neutral-200 {
    background-color: var(--color-cta-bg-hover) !important;
    background-image: var(--gradient-accent-hover) !important;
  }
  .active\:bg-neutral-300:active {
    background-color: var(--color-accent-active) !important;
    background-image: none !important;
  }
  .shadow-white\/20 { --tw-shadow-color: var(--color-accent-glow) !important; }
  .hover\:bg-white\/20:hover { background-color: var(--color-accent-soft) !important; }

  /* focos em vermelho */
  .focus\:border-white:focus     { border-color: var(--color-accent) !important; }
  .focus\:ring-white\/30:focus   { --tw-ring-color: var(--color-accent-glow) !important; }
  .focus\:ring-white:focus       { --tw-ring-color: var(--color-accent) !important; }
  input:focus, textarea:focus, select:focus { caret-color: var(--color-accent); }

  /* botões secundários com efeito vidro */
  .bg-neutral-900.border,
  .bg-neutral-900\/50 {
    background-color: rgba(22,17,16,0.55) !important;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  /* links e hovers de texto com toque de destaque */
  .hover\:text-white:hover { color: var(--color-accent-hover) !important; }

  ::selection { background: var(--color-accent); color: #fff; }

  /* scrollbar */
  * { scrollbar-color: var(--color-bg-faint) transparent; }

  /* ================================================================
     V2 — botões em pílula, mais branco e mistura de cores
     ================================================================ */

  /* Botões e chips em formato pílula (como na referência) */
  :is(a, button, span)[class*="px-"][class*="py-"]:is(.bg-white, .bg-neutral-900, .bg-neutral-950, .bg-neutral-800, .bg-neutral-900\/50, .inline-flex):not(.sort-option),
  button[class*="py-"].rounded-xl,
  button[class*="py-"].rounded-lg,
  input[class*="rounded-"]:not([type="checkbox"]):not([type="radio"]) {
    border-radius: 9999px !important;
  }

  /* Gradiente do CTA mais rico: laranja → vermelho → vinho */
  :root {
    --gradient-accent:       linear-gradient(120deg, #FF8A3D 0%, #FF422A 50%, #C42415 100%);
    --gradient-accent-hover: linear-gradient(120deg, #FFA15C 0%, #FF5A45 50%, #E5361F 100%);
  }

  /* Botões secundários: vidro com borda branca (mais branco) */
  :is(a, button)[class*="py-"]:is(.bg-neutral-900, .bg-neutral-950, .bg-neutral-900\/50).border {
    background-color: rgba(255,255,255,0.06) !important;
    border-color: rgba(255,255,255,0.22) !important;
    color: #ffffff !important;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  :is(a, button)[class*="py-"]:is(.bg-neutral-900, .bg-neutral-950, .bg-neutral-900\/50).border:hover {
    background-color: rgba(255,255,255,0.12) !important;
    border-color: rgba(255,255,255,0.45) !important;
  }

  /* Bolinhas/ícones redondos em branco puro com texto preto */
  .bg-white.rounded-full:not([class*="px-"]) {
    background-color: #ffffff !important;
    background-image: none !important;
    color: #000000 !important;
    box-shadow: 0 0 0 3px rgba(255,66,42,0.25), 0 6px 18px rgba(255,66,42,0.35) !important;
  }
  .bg-white.rounded-full:not([class*="px-"]) .text-black,
  .bg-white.rounded-full:not([class*="px-"]).text-black { color: #000000 !important; }

  /* Barras de avaliação: vermelho → laranja → branco */
  .h-full.bg-white.rounded-full {
    background-image: linear-gradient(90deg, #FF422A 0%, #FF8A3D 60%, #ffffff 100%) !important;
    box-shadow: none !important;
  }

  /* Títulos de seção: branco com acento vermelho */
  main h2.font-extrabold { position: relative; }
  main h2.font-extrabold::after {
    content: ""; display: block; width: 2.25rem; height: 3px; margin-top: .5rem;
    border-radius: 9999px; background: linear-gradient(90deg, #FF422A, #ffffff);
  }
  main h1 {
    background: linear-gradient(100deg, #ffffff 0%, #ffffff 55%, #FF8A3D 80%, #FF422A 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Cards: fundo com leve degradê vermelho → preto e borda clara */
  .bg-neutral-950.border, .rounded-2xl.border.bg-neutral-950 {
    background-image: linear-gradient(145deg, rgba(255,66,42,0.10) 0%, rgba(255,255,255,0.02) 40%, transparent 70%) !important;
    border-color: rgba(255,255,255,0.09) !important;
  }

  /* Segundo brilho no rodapé da página (laranja), misturando as cores */
  main.bg-black {
    background-image:
      radial-gradient(ellipse 90% 55% at 50% -12%, rgba(255,66,42,0.30), rgba(255,66,42,0.06) 45%, transparent 75%),
      radial-gradient(ellipse 70% 40% at 100% 100%, rgba(255,138,61,0.14), transparent 70%),
      radial-gradient(ellipse 60% 35% at 0% 60%, rgba(255,255,255,0.04), transparent 70%) !important;
  }

  /* Ícones de redes do rodapé: hover branco */
  footer a.rounded-full:hover { background-color: #ffffff !important; color: #000000 !important; }
</style>