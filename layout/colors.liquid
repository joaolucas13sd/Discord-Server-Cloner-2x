  .kc-photo { aspect-ratio: 1.08 / 1; }
  .pc-photo { aspect-ratio: 16 / 9; }
  .kc-img, .pc-img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.8,.2,1); }
  .kc-img { object-position: 50% 0%; }
  .kc-tile:hover .kc-img, .pc-tile:hover .pc-img { transform: scale(1.06); }
  .kc-photo::after, .pc-photo::after { content: ""; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 -34px 40px -22px rgba(0,0,0,.75), inset 0 0 0 1px rgba(0,0,0,.4); }

  .kc-panel, .pc-panel { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; padding: 14px 6px 6px; }
  .kc-name, .pc-name {
    font-family: 'Anton', Impact, 'Arial Narrow', sans-serif; font-weight: 400; line-height: 1; letter-spacing: .01em;
    text-transform: uppercase; color: #fff;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .kc-name { font-size: 26px; }
  .pc-name { font-size: 22px; }
  .kc-row, .pc-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .kc-sub { min-width: 0; font-size: 12px; color: rgba(255,255,255,.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pc-price-wrap { min-width: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 7px; }
  .pc-price { font-size: 17px; font-weight: 800; color: #fff; }
  .pc-old { font-size: 12px; color: rgba(255,255,255,.45); }
  .pc-from { width: 100%; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.55); }
  .pc-out { font-size: 10.5px; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; color: #FF6B55; }
  .kc-go, .pc-go {
    flex-shrink: 0; width: 32px; height: 32px; border: 1.6px solid rgba(255,255,255,.92); border-radius: 9999px;
    display: inline-flex; align-items: center; justify-content: center; color: #fff;
    transition: background .25s ease, border-color .25s ease, transform .3s ease;
  }
  .kc-go svg, .pc-go svg { width: 16px; height: 16px; }
  .kc-tile:hover .kc-go, .pc-tile:hover .pc-go { background: #FF422A; border-color: #FF422A; transform: translateX(2px); }

  .pc-off {
    position: absolute; top: 9px; right: 9px; z-index: 2; padding: 3px 7px; border-radius: 4px;
    font-size: 11px; font-weight: 900; color: #fff; background: #FF422A; box-shadow: 0 4px 12px -4px rgba(255,66,42,.85);
  }
  .pc-noimg { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: rgba(255,255,255,.3); font-size: 12px; }
  .pc-tile.is-out .pc-img { filter: grayscale(.85) brightness(.7); }

  @media (max-width: 639px) {
    .kc-tile, .pc-tile { padding: 5px; }
    .kc-panel, .pc-panel { padding: 10px 4px 4px; gap: 8px; }
    .kc-name { font-size: 19px; }
    .pc-name { font-size: 17px; }
    .kc-sub { font-size: 10.5px; }
    .pc-price { font-size: 14px; }
    .pc-old { font-size: 10.5px; }
    .kc-go, .pc-go { width: 26px; height: 26px; }
    .kc-go svg, .pc-go svg { width: 13px; height: 13px; }
  }

  /* Acessibilidade: quem pede menos transparência recebe vidro opaco */
  @media (prefers-reduced-transparency: reduce) {
    :root { --lg-tint: rgba(20,13,12,.9); --lg-tint-solid: rgba(14,9,8,.97); }
  }
  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    :root { --lg-tint: rgba(20,13,12,.86); --lg-tint-solid: rgba(14,9,8,.96); }
  }
</style>