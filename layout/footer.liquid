    </div>

    <!-- Quick Links -->
    <div>
      <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-6">Navegação</h3>
      <ul class="space-y-4 text-sm p-0">
        <li><a href="/" class="hover:text-white transition-colors duration-200 flex items-center gap-2">Início</a></li>
        <li><a href="/categories" class="hover:text-white transition-colors duration-200 flex items-center gap-2">Catálogo</a></li>
        <li><a href="/terms" class="hover:text-white transition-colors duration-200 flex items-center gap-2">Termos de Uso</a></li>
      </ul>
    </div>

  </div>

  <!-- Bottom Bar -->
  <div class="pt-8 border-t border-neutral-800 flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex flex-col items-center md:items-start gap-2">
      <p class="text-xs">
        &copy; {{ dates.year }} {{ store.name }}. Todos os direitos reservados.
      </p>
    </div>
    
    <div class="flex flex-col items-center gap-4">

      <!-- Ereemby Credit -->
      <div class="flex items-center gap-2 pl-6 h-6">
        <span class="text-[12px]">Powered by</span>
        <a href="https://ereemby.com" target="_blank" class="text-white text-xs hover:opacity-80">Ereemby</a>
      </div>
    </div>
  </div>
</footer>
