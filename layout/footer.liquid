<footer class="bg-black border-t border-neutral-800 pt-16 pb-8 text-neutral-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-[auto_auto] gap-12 mb-10">
      <!-- Brand Section -->
      <div class="space-y-6">
        <span class="text-2xl font-bold text-white">{{ store.name }}</span>
        <p class="text-sm leading-relaxed">
          {{ store.description | default: 'Sua loja favorita para produtos de alta qualidade e atendimento excepcional.' }}
        </p>
        <div class="flex space-x-4">
          {% if social.facebook %}
            <a href="{{ social.facebook }}" class="w-10 h-10 rounded-full bg-neutral-900 flex items-center justify-center hover:bg-neutral-800 hover:text-white transition-all duration-300" aria-label="Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
