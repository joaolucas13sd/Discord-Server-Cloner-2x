{% comment %}
  Regulamento do cashback (/cashback): o texto da API, regulation.text (o texto do lojista ou o
  modelo padrão, com as variáveis já trocadas), na estrutura da página de termos (terms.liquid).
  regulation.updated_date é a data da versão, já em DD/MM/AAAA ('' sem data). O texto chega como a API
  manda e sai sem filtro, então HTML no texto vira HTML na página. O `| escape` do Liquid não serve
  aqui: ele conta cada caractere no limite de memória do render, e um regulamento longo derrubaria a página.
{% endcomment %}
<section class="bg-black text-white">
  <div class="max-w-4xl mx-auto p-4 sm:p-6">

    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-sm text-neutral-500 mb-4 sm:mb-6">
      <a href="/" class="hover:text-white transition-colors">Início</a>
      <svg class="w-4 h-4 min-w-[16px] min-h-[16px]" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/></svg>
      <span class="text-neutral-200 font-medium">Regulamento do Cashback</span>
    </nav>

    {% if regulation.text != '' %}
      <!-- Header -->
      <header class="mb-8 sm:mb-10 pb-6 border-b border-neutral-800">
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">Regulamento do Cashback</h1>

        {% if regulation.updated_date != '' %}
          <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 bg-neutral-950 border border-neutral-800 rounded-full text-xs sm:text-sm text-neutral-400">
            <svg class="w-4 h-4 text-neutral-500" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z"/></svg>
            <span>
              Última atualização:
              <strong class="text-neutral-200 font-semibold ml-1">{{ regulation.updated_date }}</strong>
            </span>
          </div>
        {% endif %}
      </header>

      <!-- Content -->
      <article class="rounded-2xl border border-neutral-800 bg-neutral-950 p-5 sm:p-8">
        <div class="whitespace-pre-wrap break-words text-base leading-7 text-neutral-300">{{ regulation.text }}</div>
      </article>

      <!-- Footer / Back link -->
      <div class="mt-10 sm:mt-14 pt-6 border-t border-neutral-800">
        <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-950 hover:bg-neutral-900 border border-neutral-800 hover:border-white/30 text-neutral-300 hover:text-white text-sm font-medium rounded-xl transition-all">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"/></svg>
          Voltar para a Loja
        </a>
      </div>
    {% else %}
      <div class="flex flex-col items-center justify-center py-20 sm:py-28 text-center">
        <svg class="w-10 h-10 text-neutral-700 mb-4" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z"/></svg>
        <h2 class="text-base sm:text-lg font-semibold text-neutral-300 mb-1.5">Nenhum regulamento publicado</h2>
        <p class="text-neutral-500 text-sm max-w-[260px]">O regulamento do cashback aparece aqui quando for publicado.</p>
        <div class="mt-6 h-px w-12 bg-neutral-800"></div>
      </div>
    {% endif %}

  </div>
</section>
