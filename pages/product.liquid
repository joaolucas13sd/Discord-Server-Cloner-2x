{% unless product.id %}
  <div class="flex-1 bg-black flex flex-col items-center justify-center px-4 text-center">
    <div class="relative mb-6">
      <div class="absolute inset-0 bg-white/5 blur-2xl rounded-full scale-125"></div>
      <svg
        class="w-20 h-20 text-neutral-800 relative z-10 mx-auto"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
      </svg>
    </div>
    <h1 class="text-2xl font-bold text-white mb-2 tracking-tight">Produto não encontrado</h1>
    <p class="text-neutral-500 max-w-xs mx-auto mb-8 text-sm">
      O produto que você está procurando não existe ou foi removido.
    </p>
    <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-white hover:bg-neutral-200 text-black text-xs font-bold rounded-xl transition-all duration-300 shadow-lg shadow-white/5">
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Voltar para a Loja
    </a>
  </div>
  {% break %}
{% endunless %}

{% if product.type == 'variante' and product.variants.size > 0 %}
  {% assign _v0 = product.variants[0] %}
  {% assign display_price = _v0.price %}
  {% assign display_comparison = _v0.comparison %}
  {% assign display_stock = _v0.stock_amount %}
  {% assign display_qty_min = _v0.quantity.min %}
  {% assign display_qty_max = _v0.quantity.max %}
  {% assign display_discount_percentage = _v0.discount_percentage %}
  {% assign display_cashback = _v0.cashback %}
{% else %}
  {% assign display_price = product.price %}
  {% assign display_comparison = product.comparison %}
  {% assign display_stock = product.stock_amount %}
  {% assign display_qty_min = product.quantity.min %}
  {% assign display_qty_max = product.quantity.max %}
  {% assign display_discount_percentage = product.discount_percentage %}
  {% assign display_cashback = product.cashback %}
{% endif %}

{% comment %} "Ganhe R$ X de {programa}" ou "Ganhe 237 {saldo}": earn_amount já vem na unidade do saldo (pontos ou reais). Com reais, o nome do programa; com pontos, o nome do saldo depois da quantidade, "Pontos" sem nome definido (pedido de 17 nov) {% endcomment %}
{% assign show_cashback = false %}
{% if cashback.can_earn_balance and display_cashback.earn_amount > 0 %}
  {% assign show_cashback = true %}
{% endif %}

{% if product.type == 'variante' and product.variants.size > 0 %}
  {% assign effective_type = _v0.type %}
  {% assign effective_automatic = _v0.automatic %}
  {% if _v0.embed_video and _v0.embed_video != '' %}
    {% assign effective_embed = _v0.embed_video %}
  {% else %}
    {% assign effective_embed = product.embed_video %}
  {% endif %}
{% else %}
  {% assign effective_type = product.type %}
  {% assign effective_automatic = product.automatic %}
  {% assign effective_embed = product.embed_video %}
{% endif %}

{% comment %} Normalize embed URL for YouTube / Vimeo {% endcomment %}
{% assign embed_src = '' %}
{% if effective_embed and effective_embed != '' %}
  {% if effective_embed contains 'youtube.com/watch' %}
    {% assign _yt = effective_embed | split: 'v=' | last | split: '&' | first %}
    {% assign embed_src = 'https://www.youtube.com/embed/' | append: _yt %}
  {% elsif effective_embed contains 'youtu.be/' %}
    {% assign _yt = effective_embed | split: 'youtu.be/' | last | split: '?' | first %}
    {% assign embed_src = 'https://www.youtube.com/embed/' | append: _yt %}
  {% elsif effective_embed contains 'youtube.com/embed/' %}
    {% assign embed_src = effective_embed %}
  {% elsif effective_embed contains 'youtube.com/shorts/' %}
    {% assign _yt = effective_embed | split: 'shorts/' | last | split: '?' | first %}
    {% assign embed_src = 'https://www.youtube.com/embed/' | append: _yt %}
  {% elsif effective_embed contains 'vimeo.com' %}
    {% assign _vm = effective_embed | split: 'vimeo.com/' | last | split: '?' | first %}
    {% assign embed_src = 'https://player.vimeo.com/video/' | append: _vm %}
  {% else %}
    {% assign embed_src = effective_embed %}
  {% endif %}
{% endif %}

{% if effective_type == 'texto' %}
  {% assign is_out_of_stock = false %}
{% elsif display_stock <= 0 %}
  {% assign is_out_of_stock = true %}
{% else %}
  {% assign is_out_of_stock = false %}
{% endif %}

<script>
    window.PRODUCT_DATA = {
      id:            {{ product.id | json }},
      category_id:   {{ product.category_id | json }},
      title:         {{ product.name | json }},
      price:         {{ product.price | json }},
      originalPrice: {{ product.comparison | json }},
      description:   {{ product.description | json }},
      images:        {{ product.images | json }},
      stock_amount:  {{ product.stock_amount | json }},
      type:          {{ product.type | json }},
      variants:      {{ product.variants | json }},
      quantity:      {{ product.quantity | json }},
      embed_video:   {{ product.embed_video | json }},
      cashback:      {{ cashback | json }},
    };
</script>

<script id="product-data" type="application/json">
  {{ product | json }}
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="{{ 'product.js' | asset_url }}"></script>
<script src="{{ 'feedback.js' | asset_url }}"></script>

<style>
  .related-products-nav-wrapper {
    position: relative;
  }
  .related-products-nav-prev,
  .related-products-nav-next {
    top: 50%;
    transform: translateY(-50%);
    display: flex !important;
    align-items: center;
    justify-content: center;
  }
  .related-products-nav-prev::after,
  .related-products-nav-next::after {
    display: none !important;
  }
  .related-products-nav-prev {
    left: -20px;
  }
  .related-products-nav-next {
    right: -20px;
  }
  @media (max-width: 639px) {
    .related-products-nav-prev,
    .related-products-nav-next {
      display: none !important;
    }
  }
  .related-products-nav-prev.swiper-button-lock,
  .related-products-nav-next.swiper-button-lock {
    display: none !important;
  }
  .related-products-swiper .swiper-pagination-lock {
    display: none !important;
  }
  .related-products-swiper .swiper-pagination-bullet {
    background: #444 !important;
    opacity: 1;
  }
  .related-products-swiper .swiper-pagination-bullet-active {
    background: #fff !important;
  }
  .related-products-swiper .swiper-slide {
    height: auto !important;
  }
  .related-products-swiper .swiper-slide > a {
    height: 100% !important;
  }

  .related-products-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    flex-wrap: nowrap;
    overflow: hidden;
    gap: 24px;
  }
  .related-products-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% - 12px) / 1.8);
    min-width: 0;
  }
  @media (min-width: 640px) {
    .related-products-swiper:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc(50% - 10px);
    }
  }
  @media (min-width: 1024px) {
    .related-products-swiper:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc(25% - 18px);
    }
  }
</style>

<div class="min-h-screen bg-black">

  <!-- Product Section -->
  <div class="max-w-7xl mx-auto p-4 sm:p-6">

    <nav class="flex items-center space-x-2 text-sm text-neutral-500 sm:mb-6 mb-4">
      <a href="/" class="hover:text-white transition-colors">Início</a>
      <svg
        class="w-4 h-4 min-w-[16px] min-h-[16px]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7" /></svg>
      <a href="/category/{{ product.category_id }}" class="hover:text-white transition-colors">Produtos</a>
      <svg
        class="w-4 h-4 min-w-[16px] min-h-[16px]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7" /></svg>
      <span class="text-neutral-200 font-medium line-clamp-1">{{ product.name }}</span>
    </nav>

    <div class="bg-neutral-950 rounded-2xl shadow-xl shadow-black/40 overflow-hidden border border-neutral-800">
      <div class="lg:grid lg:grid-cols-2 lg:gap-0">

        <!-- Image Gallery -->
        <div class="p-4 sm:p-6 lg:p-10">
          <!-- Main Image -->
          <div class="relative rounded-xl overflow-hidden bg-neutral-950 shadow-md mb-4 border border-neutral-800" style="aspect-ratio: 16 / 9;">
            {% if product.images[0] %}
              <img
                id="main-product-image"
                src="{{ product.images[0] }}"
                alt="{{ product.name }}"
                class="w-full h-full object-cover transition-opacity duration-300" />
            {% else %}
              <div class="w-full h-full flex flex-col items-center justify-center bg-neutral-950 text-neutral-500">
                <div class="relative">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-20 h-20 opacity-10"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-8 h-8 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                  </svg>
                </div>
                <span class="text-xs font-bold tracking-widest uppercase opacity-30 mt-2">Sem Imagem</span>
              </div>
            {% endif %}
          </div>

          <!-- Thumbnails -->
          {% if product.images.size > 1 %}
            <div class="grid grid-cols-4 gap-3">
              {% for image in product.images %}
                <button
                  style="aspect-ratio: 16 / 9;"
                  data-src="{{ image }}"
                  class="product-thumb {% if forloop.first %}active-thumb border-white{% else %}border-transparent{% endif %} rounded-lg overflow-hidden border-2 aspect-square bg-neutral-950 shadow-sm transition-all duration-300">
                  <img
                    src="{{ image }}"
                    class="w-full h-full object-cover"
                    alt="Imagem {{ forloop.index }}" />
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <!-- Product Details -->
        <div class="p-4 sm:p-6 lg:p-8 flex flex-col">

          <!-- Brand & Title -->
          <div class="mb-4">
            <h1 data-liquid="title" class="mt-1 text-xl sm:text-2xl font-bold text-white leading-tight">{{ product.name }}</h1>
            {% if options.feedback_status %}
              <div class="mt-2 flex items-center gap-3">
                {% assign hdr_total = product.feedback.stats.total | default: 0 %}
                {% assign hdr_avg = product.feedback.stats.average | default: 0 %}
                {% assign hdr_avg_floor = hdr_avg | floor %}
                  {% if hdr_total > 0 %}
                  <!-- Stars -->
                  <div class="flex items-center gap-2 text-sm">
                    <span class="text-sm text-neutral-400">{{ hdr_avg }}</span>
                    <div class="flex items-center gap-0.5">
                      {% for i in (1..5) %}
                        <svg
                          class="w-4 h-4 {% if i <= hdr_avg_floor %}text-yellow-400{% else %}text-neutral-700{% endif %}"
                          fill="currentColor"
                          viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      {% endfor %}
                    </div>
                    <span class="text-neutral-400">{{ hdr_total }} avaliações</span>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <!-- Price -->
          <div class="bg-neutral-900 rounded-xl p-4 mb-4 border border-neutral-800">
            {% if display_comparison > display_price %}
              <span data-liquid="original-price" class="block text-base text-neutral-400 line-through mb-1">{{ display_comparison | priceFormatter }}</span>
            {% else %}
              <span data-liquid="original-price" class="block text-base text-neutral-400 line-through mb-1 hidden"></span>
            {% endif %}
            <div class="flex items-center gap-2 flex-wrap">
              <span data-liquid="price" class="text-2xl sm:text-3xl font-bold text-white">{{ display_price | priceFormatter }}</span>
              {% if display_discount_percentage and display_discount_percentage > 0 %}
                <span id="discount-badge" class="inline-flex items-center text-xs sm:text-sm font-bold text-green-400 px-0.5 py-1 rounded-md">
                  <span id="discount-label">-{{ display_discount_percentage }}% OFF</span>
                </span>
              {% else %}
                <span id="discount-badge" class="hidden inline-flex items-center text-xs sm:text-sm font-bold text-green-400 px-0.5 py-1 rounded-md">
                  <span id="discount-label"></span>
                </span>
              {% endif %}
            </div>
            <p class="text-sm text-neutral-400 font-medium mt-1">À vista no Pix</p>
            <div id="cashback-earn" class="{% unless show_cashback %}hidden {% endunless %}mt-3 pt-3 border-t border-neutral-800">
              <p id="cashback-earn-line" class="flex items-center gap-1.5 text-sm font-medium text-emerald-300">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true">
                  <path d="M184,89.57V84c0-25.08-37.83-44-88-44S8,58.92,8,84v40c0,20.89,26.25,37.49,64,42.46V172c0,25.08,37.83,44,88,44s88-18.92,88-44V132C248,111.3,222.58,94.68,184,89.57ZM232,132c0,13.22-30.79,28-72,28-3.73,0-7.43-.13-11.08-.37C170.49,151.77,184,139,184,124V105.74C213.87,110.19,232,122.27,232,132ZM72,150.25V126.46A183.74,183.74,0,0,0,96,128a183.74,183.74,0,0,0,24-1.54v23.79A163,163,0,0,1,96,152,163,163,0,0,1,72,150.25Zm96-40.32V124c0,8.39-12.41,17.4-32,22.87V123.5C148.91,120.37,159.84,115.71,168,109.93ZM96,56c41.21,0,72,14.78,72,28s-30.79,28-72,28S24,97.22,24,84,54.79,56,96,56ZM24,124V109.93c8.16,5.78,19.09,10.44,32,13.57v23.37C36.41,141.4,24,132.39,24,124Zm64,48v-4.17c2.63.1,5.29.17,8,.17,3.88,0,7.67-.13,11.39-.35A121.92,121.92,0,0,0,120,171.41v23.46C100.41,189.4,88,180.39,88,172Zm48,26.25V174.4a179.48,179.48,0,0,0,24,1.6,183.74,183.74,0,0,0,24-1.54v23.79a165.45,165.45,0,0,1-48,0Zm64-3.38V171.5c12.91-3.13,23.84-7.79,32-13.57V172C232,180.39,219.59,189.4,200,194.87Z"/>
                </svg>
                <span id="cashback-earn-label" class="min-w-0 break-words">{% if show_cashback %}{% if cashback.balance_type == 'points' %}Ganhe {{ display_cashback.earn_amount | numberFormatter }} {{ cashback.balance_name | default: 'Pontos' }}{% else %}Ganhe {{ display_cashback.earn_amount | priceFormatter }} de {{ cashback.program_name | default: cashback.balance_name }}{% endif %}{% endif %}</span>
              </p>
              <p class="mt-1 text-xs text-neutral-500">Crédito para a próxima compra. <a href="/cashback" class="underline hover:text-neutral-300">Regulamento</a></p>
            </div>
          </div>

          <!-- Delivery type marker -->
          <div class="mb-4">
            <span id="delivery-marker"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-semibold leading-none whitespace-nowrap
                         {% if effective_automatic %}bg-blue-500/10 border-blue-500/25 text-blue-300{% else %}bg-yellow-500/10 border-yellow-500/25 text-yellow-300{% endif %}">
              <svg id="delivery-icon" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 256 256">
                {% if effective_automatic %}
                  <path d="M213.85,125.46l-112,120a8,8,0,0,1-13.69-7l14.66-73.33L45.19,143.49a8,8,0,0,1-3-13l112-120a8,8,0,0,1,13.69,7L153.18,90.9l57.63,21.61a8,8,0,0,1,3,12.95Z"/>
                {% else %}
                  <path d="M120,140a12,12,0,0,1-12-12V45l-7.51,7.51a12,12,0,0,1-17-17l28-28a12,12,0,0,1,17,0l28,28a12,12,0,1,1-17,17L132,45v83A12,12,0,0,1,120,140Zm76-18.48V96a20,20,0,0,0-20-20H164a12,12,0,0,0,0,24h8v68.3A32,32,0,0,0,128.29,212c.11.2.23.39.35.58l22.26,34A12,12,0,1,0,171,233.43l-22-33.66a8,8,0,0,1,14-7.77c.11.2.23.39.36.58L174,208.88a12,12,0,0,0,22-6.57V154a70.66,70.66,0,0,1,16,44.61V240a12,12,0,0,0,24,0V198.65A94.91,94.91,0,0,0,196,121.52ZM76,76H64A20,20,0,0,0,44,96V200a12,12,0,0,0,24,0V100h8a12,12,0,0,0,0-24Z"/>
                {% endif %}
              </svg>
              <span id="delivery-label">
                {% if effective_automatic %}Entrega automática{% else %}Entrega manual{% endif %}
              </span>
            </span>
          </div>

          <!-- Variants -->
          {% if product.type == 'variante' and product.variants.size > 0 %}
            <div class="mb-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-semibold text-neutral-300">Variantes</span>
                <span class="text-xs text-neutral-600">{{ product.variants.size }} opções</span>
              </div>
              <div id="variants-list" class="flex flex-col gap-1.5 max-h-52 overflow-y-auto pr-1">
                {% for variant in product.variants %}
                  {% if variant.type == 'texto' %}
                    {% assign _v_out = false %}
                  {% elsif variant.stock_amount <= 0 %}
                    {% assign _v_out = true %}
                  {% else %}
                    {% assign _v_out = false %}
                  {% endif %}

                  <button class="variant-btn group w-full flex items-center gap-3 px-4 py-3 rounded-xl border transition-all duration-150 text-left
                  {% if forloop.first %}border-neutral-600 bg-neutral-800 text-white{% else %}border-neutral-800 text-neutral-400 hover:border-neutral-700 hover:bg-neutral-900 hover:text-neutral-200{% endif %}{% if _v_out %} opacity-60{% endif %}" data-variant-index="{{ forloop.index0 }}">
                    <!-- Ícone ou placeholder -->
                    {% if variant.icon %}
                      <img
                        src="{{ variant.icon }}"
                        class="w-8 h-8 rounded-lg object-cover flex-shrink-0 border border-neutral-700"
                        alt="{{ variant.name }}" />
                    {% else %}
                      <div class="w-8 h-8 rounded-lg bg-neutral-800 border border-neutral-700 flex-shrink-0 flex items-center justify-center">
                        <svg
                          class="w-4 h-4 text-neutral-600"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10" />
                        </svg>
                      </div>
                    {% endif %}

                    <!-- Nome e preço -->
                    <div class="flex-1 min-w-0">
                      <p class="text-sm leading-tight font-semibold text-neutral-100 truncate">{{ variant.name }}</p>
                      {% if variant.price %}
                        <div class="variant-price-label flex flex-wrap items-center gap-1 text-xs mt-0.5 text-neutral-300">
                          <span>{{ variant.price | priceFormatter }}</span>
                          {% if variant.comparison > variant.price %}
                            <span class="line-through text-neutral-500">{{ variant.comparison | priceFormatter }}</span>
                          {% endif %}
                          {% if variant.type == 'texto' %}
                            <span class="font-medium">Disponível</span>
                          {% elsif _v_out %}
                            <span class="text-red-400 font-medium">Esgotado</span>
                          {% else %}
                            <span class="font-medium">{{ variant.stock_amount }} Disponível</span>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                      
                    <!-- Check de selecionado -->
                    <div class="variant-check flex-shrink-0 w-5 h-5 rounded-full border-2 flex items-center justify-center transition-all
                {% if forloop.first %}border-white bg-white{% else %}border-neutral-700 bg-transparent{% endif %}">
                      <svg
                        class="w-3 h-3 {% if forloop.first %}text-black{% else %}hidden{% endif %} variant-check-icon"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                          d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}


          {% if effective_type == 'texto' %}
            {% assign _stock_label = 'Disponível' %}
            {% assign _stock_color_class = 'text-green-400' %}
            {% assign _stock_dot_class = 'bg-green-400' %}
            {% assign _stock_pulse = true %}
          {% elsif is_out_of_stock %}
            {% assign _stock_label = 'Esgotado' %}
            {% assign _stock_color_class = 'text-red-400' %}
            {% assign _stock_dot_class = 'bg-red-500' %}
            {% assign _stock_pulse = false %}
          {% else %}
            {% assign _stock_label = display_stock | append: ' em estoque' %}
            {% assign _stock_color_class = 'text-green-400' %}
            {% assign _stock_dot_class = 'bg-green-400' %}
            {% assign _stock_pulse = true %}
          {% endif %}

          <!-- Quantity -->
          <div id="qty-section" class="mb-6{% if is_out_of_stock %} hidden{% endif %}">
            <div class="flex items-center justify-between mb-2 gap-3">
              <span class="text-sm font-semibold text-neutral-300">Quantidade</span>
              <div class="flex items-center gap-1.5 ">
                <span class="relative inline-flex w-2 h-2 flex-shrink-0">
                  <span id="stock-dot-ping" class="absolute inset-0 rounded-full {{ _stock_dot_class }} opacity-60 animate-ping{% unless _stock_pulse %} hidden{% endunless %}"></span>
                  <span id="stock-dot" class="relative inline-flex w-2 h-2 rounded-full {{ _stock_dot_class }}"></span>
                </span>
                <span id="stock-display" class="text-[11px] sm:text-xs font-semibold {{ _stock_color_class }}">{{ _stock_label }}</span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex items-center border-2 border-neutral-700 rounded-xl overflow-hidden bg-neutral-900">
                <button id="btn-decrease" class="w-11 h-11 flex items-center justify-center text-neutral-400 hover:bg-neutral-800 hover:text-white text-xl font-bold transition-colors focus:outline-none">
                  −
                </button>
                <input
                  id="qty-input"
                  type="text"
                  value="{% if display_qty_min > 1 %}{{ display_qty_min }}{% else %}1{% endif %}"
                  class="w-14 text-center text-lg font-bold text-white bg-neutral-900 focus:outline-none border-x-2 border-neutral-700 h-11" />
                <button id="btn-increase" class="w-11 h-11 flex items-center justify-center text-neutral-400 hover:bg-neutral-800 hover:text-white text-xl font-bold transition-colors focus:outline-none">
                  +
                </button>
              </div>
              {% if display_qty_max > 0 %}
                <span id="qty-max-label" class="text-sm text-neutral-600">Máx. {{ display_qty_max }} unidades por pedido</span>
              {% else %}
                <span id="qty-max-label" class="text-sm text-neutral-600 hidden"></span>
              {% endif %}
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-3 mb-6">
            {% unless is_out_of_stock %}
              <button id="btn-buy-now" class="flex-1 flex items-center justify-center gap-2 px-5 py-3 bg-white hover:bg-neutral-200 active:bg-neutral-300 text-black font-semibold rounded-xl shadow-lg shadow-black/40 transition-all duration-200 text-sm focus:outline-none focus:ring-4 focus:ring-neutral-600">
                Comprar Agora
              </button>
              <button id="btn-add-cart" class="flex-1 flex items-center justify-center gap-2 px-5 py-3 bg-neutral-900 hover:bg-neutral-800 text-white font-semibold rounded-xl border border-neutral-700 transition-all duration-200 text-sm focus:outline-none focus:ring-4 focus:ring-neutral-700">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                Adicionar ao Carrinho
              </button>
            {% else %}
              <button id="btn-buy-now" disabled class="flex-1 flex items-center justify-center gap-2 px-5 py-3 bg-neutral-800 text-neutral-500 font-semibold rounded-xl cursor-not-allowed text-sm">
                Produto Esgotado
              </button>
              <button id="btn-add-cart" disabled class="flex-1 flex items-center justify-center gap-2 px-5 py-3 bg-neutral-900 text-neutral-600 font-semibold rounded-xl border border-neutral-800 cursor-not-allowed text-sm">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                Indisponível
              </button>
            {% endunless %}
          </div>

          <!-- Wishlist & Share -->
          <div class="flex items-center gap-4 justify-center sm:justify-start">
            <button id="btn-wishlist" class="flex items-center gap-1.5 text-sm text-neutral-500 hover:text-white transition-colors focus:outline-none">
              <svg
                id="heart-icon"
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
              <span class="sm:hidden">Favoritar</span>
              <span class="hidden sm:inline">Adicionar aos Favoritos</span>
            </button>
            <span class="text-neutral-700">|</span>
            <button id="btn-share" class="flex items-center gap-1.5 text-sm text-neutral-500 hover:text-white transition-colors focus:outline-none">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
              Compartilhar
            </button>
          </div>

        </div>
      </div>
    </div>

    <!-- Tabs: Description / Specs / Reviews -->
    <div class="mt-6 sm:mt-8 bg-neutral-950 rounded-2xl shadow-xl shadow-black/40 border border-neutral-800">
      <div class="border-b border-neutral-800">
        <nav class="flex" id="product-tabs">
          <button id="tab-desc" class="product-tab active-tab px-4 sm:px-6 py-3 sm:py-4 text-sm font-semibold border-b-2 border-white text-white focus:outline-none">
            Descrição
          </button>
          {% if options.feedback_status %}
            <button id="tab-rev" class="product-tab px-4 sm:px-6 py-3 sm:py-4 text-sm font-semibold border-b-2 border-transparent text-neutral-500 hover:text-neutral-300 hover:border-neutral-600 focus:outline-none transition-colors">
              Avaliações ({{ product.feedback.stats.total }})
            </button>
          {% endif %}
        </nav>
      </div>

      <div class="p-4 sm:p-6 lg:p-8">
        <!-- Description Tab -->
        <div id="tab-content-desc">
          <div data-liquid="description" class="reset-content-css">{{ product.description }}</div>

          <!-- Embedded Video -->
          <div id="embed-video-wrapper" class="mt-6{% if embed_src == '' %} hidden{% endif %}">
            <div class="relative w-full max-w-xl overflow-hidden rounded-xl border border-neutral-800 bg-black" style="aspect-ratio: 16 / 9;">
              <iframe
                id="embed-video-frame"
                src="{{ embed_src }}"
                title="Vídeo do produto"
                class="absolute inset-0 w-full h-full"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
                loading="lazy"
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Reviews Tab -->
        {% if options.feedback_status %}
          <div id="tab-content-rev" class="hidden">
            {% render 'feedback', product: product %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="max-w-7xl mx-auto flex flex-col gap-10 mt-10">

      {% assign current_category_id = product.category_id %}
      {% assign current_product_name = product.name %}

      {% for category in catalog.categories %}

        {% if category.id == current_category_id %}
          {% assign related_count = 0 %}
          {% for item in category.products %}
            {% if item.id != product.id %}
              {% assign related_count = related_count | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% if related_count > 0 %}
            <div>
              <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-6 sm:mb-10 gap-3 sm:gap-4">
                <div>
                  <p class="text-neutral-500 text-xs sm:text-sm font-semibold uppercase tracking-widest mb-1">Catálogo</p>
                  <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Produtos Relacionados</h2>
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm text-neutral-500">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 20 20"
                    fill="currentColor">
                    <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
                  </svg>
                  {{ related_count }} produtos
                </span>
              </div>

              <!-- Slider de produtos da mesma categoria -->
              <div class="related-products-nav-wrapper">
                <div class="swiper related-products-swiper !pb-12">
                  <div class="swiper-wrapper">
                    {% for item in category.products %}
                      {% if item.id != product.id %}
                        <div class="swiper-slide !h-auto">
                          {% render 'product-card', product: item %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
                <div class="related-products-nav-prev swiper-button-prev !w-10 !h-10 !bg-white !rounded-full">
                  <svg class="!w-5 !h-5" xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="#000000" viewBox="0 0 256 256"><path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"></path></svg>
                </div>
                <div class="related-products-nav-next swiper-button-next !w-10 !h-10 !bg-white !rounded-full">
                  <svg class="!w-5 !h-5" xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="#000000" viewBox="0 0 256 256"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"></path></svg>
                </div>
              </div>
            </div>
          {% endif %}

          {% break %}
        {% endif %}

      {% endfor %}

    </div>

  </div>

  <!-- ===================== SHARE SHEET / MODAL ===================== -->
  <style>
    @keyframes shareBackdropIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes shareSheetUp {
      from { transform: translateY(100%); }
      to   { transform: translateY(0); }
    }
    @keyframes shareModalIn {
      from { opacity: 0; transform: translateY(10px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    #share-backdrop.open { animation: shareBackdropIn .25s ease-out forwards; }
    #share-panel.open    { animation: shareSheetUp .35s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    @media (min-width: 640px) {
      #share-panel.open  { animation: shareModalIn .25s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    }
    .share-option:active { transform: scale(0.93); }
  </style>

  <div id="share-root" class="hidden">
    <!-- Backdrop -->
    <div id="share-backdrop" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[200]"></div>

    <!-- Panel: bottom-sheet on mobile, centered modal on sm+ -->
    <div
      id="share-panel"
      class="fixed left-0 right-0 bottom-0 z-[201] bg-neutral-950 border-t border-neutral-800 rounded-t-3xl shadow-2xl shadow-black/80
             sm:top-1/2 sm:left-1/2 sm:bottom-auto sm:right-auto sm:-translate-x-1/2 sm:-translate-y-1/2
             sm:w-[440px] sm:max-w-[92vw] sm:rounded-2xl sm:border sm:border-neutral-800"
      role="dialog"
      aria-modal="true"
      aria-labelledby="share-title"
    >
      <!-- Drag handle (mobile only) -->
      <div class="sm:hidden flex justify-center pt-3 pb-1">
        <div class="w-10 h-1 rounded-full bg-neutral-700"></div>
      </div>

      <!-- Header -->
      <div class="flex items-center justify-between px-5 pt-3 pb-2 sm:pt-5">
        <div>
          <p class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-neutral-500 mb-0.5">Compartilhar</p>
          <h3 id="share-title" class="text-base sm:text-lg font-bold text-white line-clamp-1">{{ product.name }}</h3>
        </div>
        <button id="share-close" type="button" class="p-2 rounded-xl hover:bg-neutral-900 text-neutral-400 hover:text-white transition-colors" aria-label="Fechar">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Network grid -->
      <div class="px-4 sm:px-5 pt-2 pb-3">
        <div class="grid grid-cols-4 gap-2">
          <button class="share-option flex flex-col items-center justify-center gap-1.5 py-3 rounded-xl hover:bg-neutral-900 transition-colors group" data-share="whatsapp" aria-label="WhatsApp">
            <span class="w-11 h-11 rounded-full flex items-center justify-center bg-[#25D366]">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            </span>
            <span class="text-[10px] sm:text-xs text-neutral-400 group-hover:text-white transition-colors">WhatsApp</span>
          </button>

          <button class="share-option flex flex-col items-center justify-center gap-1.5 py-3 rounded-xl hover:bg-neutral-900 transition-colors group" data-share="telegram" aria-label="Telegram">
            <span class="w-11 h-11 rounded-full flex items-center justify-center bg-[#229ED9]">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            </span>
            <span class="text-[10px] sm:text-xs text-neutral-400 group-hover:text-white transition-colors">Telegram</span>
          </button>

          <button class="share-option flex flex-col items-center justify-center gap-1.5 py-3 rounded-xl hover:bg-neutral-900 transition-colors group" data-share="x" aria-label="X (Twitter)">
            <span class="w-11 h-11 rounded-full flex items-center justify-center bg-black border border-neutral-700">
              <svg class="w-[18px] h-[18px] text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </span>
            <span class="text-[10px] sm:text-xs text-neutral-400 group-hover:text-white transition-colors">X</span>
          </button>

          <button class="share-option flex flex-col items-center justify-center gap-1.5 py-3 rounded-xl hover:bg-neutral-900 transition-colors group" data-share="facebook" aria-label="Facebook">
            <span class="w-11 h-11 rounded-full flex items-center justify-center bg-[#1877F2]">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </span>
            <span class="text-[10px] sm:text-xs text-neutral-400 group-hover:text-white transition-colors">Facebook</span>
          </button>

          <button class="share-option flex flex-col items-center justify-center gap-1.5 py-3 rounded-xl hover:bg-neutral-900 transition-colors group" data-share="linkedin" aria-label="LinkedIn">
            <span class="w-11 h-11 rounded-full flex items-center justify-center bg-[#0A66C2]">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </span>
            <span class="text-[10px] sm:text-xs text-neutral-400 group-hover:text-white transition-colors">LinkedIn</span>
          </button>

          <button class="share-option flex flex-col items-center justify-center gap-1.5 py-3 rounded-xl hover:bg-neutral-900 transition-colors group" data-share="pinterest" aria-label="Pinterest">
            <span class="w-11 h-11 rounded-full flex items-center justify-center bg-[#E60023]">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.347-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.747-1.378l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/></svg>
            </span>
            <span class="text-[10px] sm:text-xs text-neutral-400 group-hover:text-white transition-colors">Pinterest</span>
          </button>

          <button class="share-option flex flex-col items-center justify-center gap-1.5 py-3 rounded-xl hover:bg-neutral-900 transition-colors group" data-share="reddit" aria-label="Reddit">
            <span class="w-11 h-11 rounded-full flex items-center justify-center bg-[#FF4500]">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 01-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.04 1.605a3.32 3.32 0 01.045.45c0 2.293-2.677 4.152-5.978 4.152-3.301 0-5.979-1.859-5.979-4.152 0-.151.016-.3.041-.449-.61-.271-1.044-.888-1.044-1.605 0-.968.786-1.754 1.754-1.754.477 0 .898.182 1.207.49 1.207-.86 2.878-1.424 4.744-1.493l.899-4.206a.342.342 0 01.434-.244l2.953.628a1.25 1.25 0 011.221-.949zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 00-.231.094.33.33 0 000 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 00.029-.463.33.33 0 00-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 00-.232-.095z"/></svg>
            </span>
            <span class="text-[10px] sm:text-xs text-neutral-400 group-hover:text-white transition-colors">Reddit</span>
          </button>

          <button class="share-option flex flex-col items-center justify-center gap-1.5 py-3 rounded-xl hover:bg-neutral-900 transition-colors group" data-share="email" aria-label="Email">
            <span class="w-11 h-11 rounded-full flex items-center justify-center bg-neutral-800">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </span>
            <span class="text-[10px] sm:text-xs text-neutral-400 group-hover:text-white transition-colors">E-mail</span>
          </button>
        </div>
      </div>

      <!-- Copy link bar -->
      <div class="px-4 sm:px-5 pb-5 sm:pb-5 pt-1" style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom));">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-500 mb-2">Link do produto</p>
        <div class="flex items-stretch gap-2 bg-neutral-900 border border-neutral-800 rounded-xl p-1.5">
          <input
            id="share-url-input"
            type="text"
            readonly
            class="flex-1 bg-transparent text-xs sm:text-sm text-neutral-300 px-2 focus:outline-none truncate"
            value=""
          >
          <button id="share-copy" type="button" class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 sm:px-4 py-2 bg-white hover:bg-neutral-200 text-black text-xs sm:text-sm font-bold rounded-lg transition-colors active:scale-95">
            <svg id="share-copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="share-copy-label">Copiar</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function initShare() {
      var btn = document.getElementById('btn-share');
      var root = document.getElementById('share-root');
      var backdrop = document.getElementById('share-backdrop');
      var panel = document.getElementById('share-panel');
      var closeBtn = document.getElementById('share-close');
      var copyBtn = document.getElementById('share-copy');
      var copyLabel = document.getElementById('share-copy-label');
      var urlInput = document.getElementById('share-url-input');
      if (!btn || !root) return;

      var productTitle = (window.PRODUCT_DATA && window.PRODUCT_DATA.title) || document.title || '';
      var productImage = (window.PRODUCT_DATA && window.PRODUCT_DATA.images && window.PRODUCT_DATA.images[0]) || '';
      var shareText = productTitle ? ('Confira: ' + productTitle) : 'Confira este produto';

      function getUrl() { return window.location.href; }

      function openSheet() {
        var url = getUrl();
        if (urlInput) urlInput.value = url;
        root.classList.remove('hidden');
        // Force reflow then animate
        requestAnimationFrame(function () {
          backdrop.classList.add('open');
          panel.classList.add('open');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeSheet() {
        backdrop.classList.remove('open');
        panel.classList.remove('open');
        document.body.style.overflow = '';
        setTimeout(function () { root.classList.add('hidden'); }, 250);
      }

      function tryNativeShare() {
        if (navigator.share) {
          navigator.share({ title: productTitle, text: shareText, url: getUrl() })
            .catch(function () { openSheet(); });
          return true;
        }
        return false;
      }

      btn.addEventListener('click', function () {
        if (!tryNativeShare()) openSheet();
      });

      closeBtn.addEventListener('click', closeSheet);
      backdrop.addEventListener('click', closeSheet);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !root.classList.contains('hidden')) closeSheet();
      });

      var targets = {
        whatsapp:  function (u, t) { return 'https://wa.me/?text=' + encodeURIComponent(t + ' ' + u); },
        telegram:  function (u, t) { return 'https://t.me/share/url?url=' + encodeURIComponent(u) + '&text=' + encodeURIComponent(t); },
        x:         function (u, t) { return 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(t) + '&url=' + encodeURIComponent(u); },
        facebook:  function (u)    { return 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(u); },
        linkedin:  function (u)    { return 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(u); },
        pinterest: function (u, t, img) { return 'https://pinterest.com/pin/create/button/?url=' + encodeURIComponent(u) + '&description=' + encodeURIComponent(t) + (img ? '&media=' + encodeURIComponent(img) : ''); },
        reddit:    function (u, t) { return 'https://reddit.com/submit?url=' + encodeURIComponent(u) + '&title=' + encodeURIComponent(t); },
        email:     function (u, t) { return 'mailto:?subject=' + encodeURIComponent(t) + '&body=' + encodeURIComponent(t + '\n\n' + u); },
      };

      document.querySelectorAll('.share-option').forEach(function (opt) {
        opt.addEventListener('click', function () {
          var key = opt.getAttribute('data-share');
          var fn = targets[key];
          if (!fn) return;
          var href = fn(getUrl(), shareText, productImage);
          if (key === 'email') {
            window.location.href = href;
          } else {
            window.open(href, '_blank', 'noopener,noreferrer');
          }
          setTimeout(closeSheet, 150);
        });
      });

      function copyToClipboard(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
          try {
            urlInput.removeAttribute('readonly');
            urlInput.select();
            urlInput.setSelectionRange(0, 99999);
            document.execCommand('copy');
            urlInput.setAttribute('readonly', '');
            urlInput.blur();
            resolve();
          } catch (err) { reject(err); }
        });
      }

      copyBtn.addEventListener('click', function () {
        copyToClipboard(getUrl()).then(function () {
          var prev = copyLabel.textContent;
          copyLabel.textContent = 'Copiado!';
          copyBtn.classList.add('!bg-green-500', 'hover:!bg-green-500');
          setTimeout(function () {
            copyLabel.textContent = prev;
            copyBtn.classList.remove('!bg-green-500', 'hover:!bg-green-500');
          }, 1500);
        }).catch(function () {
          copyLabel.textContent = 'Erro';
          setTimeout(function () { copyLabel.textContent = 'Copiar'; }, 1500);
        });
      });
    })();
  </script>

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 hidden">
    <div class="flex items-center gap-3 bg-neutral-900 border border-neutral-700 text-neutral-100 px-5 py-3.5 rounded-xl shadow-2xl shadow-black/60 text-sm font-medium">
      <svg
        class="w-5 h-5 text-white flex-shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 13l4 4L19 7" />
        </svg>
      <span id="toast-message">Produto adicionado ao carrinho!</span>
    </div>
  </div>

</div>