<div class="min-h-screen bg-black text-white">
  <!-- ===================== DESTAQUES (HERO NATIVO): JOGOS STEAM + FILMES ===================== -->
  <link rel="preconnect" href="https://shared.akamai.steamstatic.com">
  <link rel="preconnect" href="https://image.tmdb.org">
  <section class="nh" id="nh" aria-roledescription="carrossel" aria-label="Destaques do momento">
    <div class="nh-slides" id="nh-slides"></div>
    <div class="nh-dots" id="nh-dots" role="tablist" aria-label="Escolher destaque"></div>
  </section>

  <style>
    /* cada categoria só é desenhada perto da tela; o recuo dá espaço ao brilho do título */
    #produtos > div > div { content-visibility: auto; contain-intrinsic-size: auto 760px; padding: 24px 16px 0; margin: -24px -16px 0; }

    /* Destaque: arte de ponta a ponta, por trás do header; faixa de vitrine na base */
    .nh {
      position: relative; margin-top: -64px; height: clamp(560px, 82vh, 780px);
      overflow: hidden; isolation: isolate; color: #fff; touch-action: pan-y; --nh-band: 150px;
    }
    .nh-slides { position: absolute; inset: 0; }
    .nh-slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .9s ease, visibility 0s linear .9s; }
    .nh-slide.is-active { opacity: 1; visibility: visible; z-index: 1; transition: opacity .9s ease; }
    .nh-media { position: absolute; inset: 0; }
    .nh-bg {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 68% 28%;
      opacity: 0; transition: opacity .7s ease;
    }
    .nh-bg.is-ready { opacity: 1; }
    @media (min-width: 1024px) and (hover: hover) {
      .nh-slide:not(.is-movie) .nh-bg { transform: scale(1.04); transition: opacity .7s ease, transform 8s cubic-bezier(.2,.6,.2,1); }
      .nh-slide.is-active:not(.is-movie) .nh-bg { transform: scale(1); }
    }
    .nh-slide.is-movie .nh-bg { filter: blur(22px) saturate(1.4) brightness(.5); transform: scale(1.2); }
    .nh-art {
      position: absolute; top: 0; bottom: 0; right: max(0px, calc((100vw - 80rem) / 2)); height: 100%; width: auto; aspect-ratio: 2 / 3;
      object-fit: cover; opacity: 0; transition: opacity .7s ease;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 28%, #000 84%, transparent 100%);
              mask-image: linear-gradient(90deg, transparent 0%, #000 28%, #000 84%, transparent 100%);
    }
    .nh-art.is-ready { opacity: 1; }
    .nh-shade {
      position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 22%), linear-gradient(0deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,0) 46%);
    }

    /* Faixa */
    .nh-band {
      position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; height: var(--nh-band);
      background: linear-gradient(180deg, rgba(10,6,5,.6), rgba(10,6,5,.76));
      border-top: 1px solid rgba(255,255,255,.12);
    }
    @media (min-width: 1024px) and (hover: hover) {
      .nh-band { background: linear-gradient(180deg, rgba(10,6,5,.44), rgba(10,6,5,.62)); -webkit-backdrop-filter: blur(12px) saturate(150%); backdrop-filter: blur(12px) saturate(150%); }
    }
    .nh-band-in { height: 100%; max-width: 80rem; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
    .nh-txt { min-width: 0; flex: 1; }
    .nh-label {
      display: inline-flex; align-items: center; gap: 10px; margin-bottom: 8px;
      font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.88);
    }
    .nh-label .fc-brand { height: 17px; width: auto; display: block; flex-shrink: 0; }
    .nh-label .fc-brand-hbo { height: 12px; }
    .nh-label .fc-brand-img { height: 19px; filter: brightness(0) invert(1); }
    .nh-label .nh-dot-sep { width: 4px; height: 4px; border-radius: 9999px; background: #FF422A; box-shadow: 0 0 10px #FF422A; }
    .nh-name {
      margin: 0; font-size: clamp(30px, 3.4vw, 48px); font-weight: 900; line-height: 1; letter-spacing: -.02em; text-transform: uppercase;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 4px 24px rgba(0,0,0,.4);
    }
    .nh-name.is-long { font-size: clamp(22px, 2.3vw, 34px); line-height: 1.04; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .nh-name.is-long + .nh-desc { display: none; }
    .nh-desc { margin: 8px 0 0; max-width: 720px; font-size: 14px; color: rgba(255,255,255,.76); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nh-acts { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .nh-cta, .nh-alt {
      position: relative; display: inline-flex; align-items: center; gap: 12px; height: 52px; border-radius: 8px;
      color: #fff; font-size: 14px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; white-space: nowrap;
    }
    .nh-cta {
      padding: 0 10px 0 22px;
      background: linear-gradient(135deg, #FF8A3D 0%, #FF422A 55%, #D92F1A 100%);
      box-shadow: inset 0 1px 1px rgba(255,255,255,.5), 0 14px 30px -12px rgba(255,66,42,.8);
      transition: transform .4s cubic-bezier(.34,1.56,.64,1), box-shadow .25s ease;
    }
    .nh-cta:hover { transform: translateY(-2px); box-shadow: inset 0 1px 1px rgba(255,255,255,.6), 0 18px 36px -12px rgba(255,66,42,.95); }
    .nh-sq { width: 32px; height: 32px; border: 1.5px solid rgba(255,255,255,.92); border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; transition: transform .3s ease; }
    .nh-sq svg { width: 16px; height: 16px; }
    .nh-cta:hover .nh-sq { transform: translateX(3px); }
    .nh-alt { padding: 0 20px; gap: 10px; }
    .nh-alt svg, .nh-alt .fc-brand { position: relative; z-index: 2; width: auto; height: 18px; display: block; flex-shrink: 0; }
    .nh-alt > svg { width: 18px; }
    .nh-alt .fc-brand-hbo { height: 13px; }
    .nh-alt-txt { position: relative; z-index: 2; }

    /* Entrada suave a cada troca */
    .nh-slide.is-active .nh-txt > *, .nh-slide.is-active .nh-acts { animation: nhUp .8s cubic-bezier(.2,.8,.2,1) both; }
    .nh-slide.is-active .nh-txt > :nth-child(2) { animation-delay: .06s; }
    .nh-slide.is-active .nh-txt > :nth-child(3) { animation-delay: .12s; }
    .nh-slide.is-active .nh-acts { animation-delay: .16s; }
    @keyframes nhUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

    /* Indicadores logo acima da faixa */
    .nh-dots {
      position: absolute; z-index: 3; left: 0; right: 0; bottom: calc(var(--nh-band) + 14px);
      max-width: 80rem; margin: 0 auto; padding: 0 32px; display: flex; gap: 6px;
    }
    .nh-dot { position: relative; width: 30px; height: 22px; padding: 0; border: 0; background: none; cursor: pointer; transition: width .45s var(--lg-spring, ease); }
    .nh-dot .bar { position: absolute; left: 0; right: 0; top: 50%; height: 4px; margin-top: -2px; border-radius: 9999px; overflow: hidden; background: rgba(255,255,255,.3); box-shadow: inset 0 1px 0 rgba(255,255,255,.2); }
    .nh-dot .fill { position: absolute; inset: 0; border-radius: inherit; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, #FF8A3D, #FF422A); box-shadow: 0 0 10px rgba(255,66,42,.8); }
    .nh-dot.is-active { width: 52px; }
    .nh-dot.is-active .fill { animation: nhFill var(--nh-dur, 7s) linear forwards; }
    .nh.is-paused .nh-dot.is-active .fill { animation-play-state: paused; }
    .nh-dot:focus-visible { outline: 2px solid #FF422A; outline-offset: 2px; border-radius: 6px; }
    @keyframes nhFill { to { transform: scaleX(1); } }
    @media (prefers-reduced-motion: reduce) {
      .nh-dot.is-active .fill { animation: none; transform: scaleX(1); }
      .nh-slide.is-active .nh-txt > *, .nh-slide.is-active .nh-acts { animation: none; }
      .nh-slide:not(.is-movie) .nh-bg { transform: none !important; }
    }

    @media (min-width: 640px) and (max-width: 1023px) {
      .nh { height: clamp(500px, 70vh, 620px); --nh-band: 140px; }
      .nh-band-in, .nh-dots { padding-left: 24px; padding-right: 24px; }
      .nh-desc { display: none; }
    }

    /* Celular: faixa com título em até 2 linhas e botões embaixo */
    @media (max-width: 639px) {
      .nh { height: clamp(440px, calc(64px + 100vw), 600px); --nh-band: 156px; }
      .nh-bg { object-position: 72% 30%; }
      .nh-art { right: -10%; }
      .nh-band-in { padding: 14px 16px; flex-direction: column; align-items: stretch; justify-content: center; gap: 12px; }
      .nh-txt { flex: none; }
      .nh-label { font-size: 10px; letter-spacing: .12em; gap: 7px; margin-bottom: 6px; }
      .nh-label .fc-brand { height: 14px; } .nh-label .fc-brand-hbo { height: 10px; } .nh-label .fc-brand-img { height: 15px; }
      .nh-name { font-size: 22px; line-height: 1.02; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
      .nh-name.is-long { font-size: 19px; }
      .nh-desc { display: none; }
      .nh-acts { gap: 8px; }
      .nh-cta { flex: 1; height: 42px; padding: 0 8px 0 16px; font-size: 12.5px; justify-content: space-between; }
      .nh-sq { width: 26px; height: 26px; } .nh-sq svg { width: 13px; height: 13px; }
      .nh-alt { width: 42px; height: 42px; padding: 0; justify-content: center; }
      .nh-alt-txt { display: none; }
      .nh-dots { bottom: calc(var(--nh-band) + 10px); padding: 0 16px; }
      .nh-dot { width: 22px; } .nh-dot.is-active { width: 40px; }
    }
  </style>

  <script>
  (function () {
    /* ============================================================
       EDITE AQUI os destaques.
       JOGOS: aparecem sempre (mais vendidos da Steam). "id" é o número do jogo na Steam.
       FILMES: só aparecem os do app de streaming que a loja VENDE.
         O carrossel procura no catálogo um produto com o nome do app
         (ex.: "Netflix", "Disney+") e liga o botão a esse produto.
       ============================================================ */
    var STEAM = 'https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/';
    var TMDB = 'https://image.tmdb.org/t/p/w780/';
    var JOGOS = [
      { id: 1174180, nome: 'Red Dead Redemption 2', tag: 'Mais vendido na Steam',
        texto: 'Arthur Morgan e a gangue Van der Linde em fuga pelo coração da América. Um dos jogos mais vendidos da Steam agora.', link: '/categories' },
      { id: 1091500, nome: 'Cyberpunk 2077', tag: 'Em alta na Steam',
        texto: 'Um RPG de ação em mundo aberto em Night City, a megalópole obcecada por poder, glamour e modificações corporais.', link: '/categories' },
      { id: 3240220, nome: 'Grand Theft Auto V Enhanced', tag: 'Mais vendido na Steam',
        texto: 'Grand Theft Auto V e GTA Online, agora com visuais aprimorados para a nova geração.', link: '/categories' },
      { id: 1593500, nome: 'God of War', tag: 'Em alta na Steam',
        texto: 'Kratos e Atreus em uma jornada pelos reinos nórdicos, enfrentando deuses e monstros.', link: '/categories' }
    ];

    /* Palavras usadas para reconhecer cada app no nome dos produtos */
    var APPS = {
      'Netflix':     ['netflix'],
      'Prime Video': ['prime video', 'amazon prime', 'primevideo'],
      'Disney+':     ['disney'],
      'HBO Max':     ['hbo'],
      'Globoplay':   ['globoplay', 'globo play'],
      'Paramount+':  ['paramount'],
      'Apple TV':    ['apple tv', 'appletv']
    };

    /* Filmes disponíveis em cada app no Brasil (fonte: TMDB/JustWatch, nov/2026) */
    var FILMES = {
      'Netflix': [
        { nome: "Demon Slayer: Kimetsu no Yaiba Castelo Infinito", poster: TMDB + '41XdjOXGQoH0HTDNqEfwKGvGgwm.jpg' },
        { nome: "Godzilla Minus One", poster: TMDB + '9XSOyim1pivuSHQqlrDj5gj2J5w.jpg' },
        { nome: "A Viagem de Chihiro", poster: TMDB + 'hhoKhsyJ3hFaxEm5pMdZRiTu2lJ.jpg' }
      ],
      'Prime Video': [
        { nome: "A Guerra dos Mundos", poster: TMDB + 'yY5CbfXBxsPvYi0TzmaCP7uunnn.jpg' },
        { nome: "Interestelar", poster: TMDB + 'tR1XVa5bxgdh2bRw2u0DzrgkO2l.jpg' },
        { nome: "Apocalipse Z: Novo Mundo", poster: TMDB + 'tzk90shtAI6WaoDIjLLVten7oov.jpg' }
      ],
      'Disney+': [
        { nome: "Vingadores: Ultimato", poster: TMDB + 'q6725aR8Zs4IwGMXzZT8aC8lh41.jpg' },
        { nome: "Deadpool & Wolverine", poster: TMDB + 'cJFqqiDYprqExaXatu4AaoMzDG2.jpg' },
        { nome: "Quarteto Fantástico: Primeiros Passos", poster: TMDB + '8F2vIxWycANHW763lnx2hJVtjDC.jpg' }
      ],
      'HBO Max': [
        { nome: "Duna: Parte Dois", poster: TMDB + 'VMy4UGsI2u3f4fALGeCqCdsQBb.jpg' },
        { nome: "Batman: O Cavaleiro das Trevas", poster: TMDB + 'dutnVGV9ljCZh84bkTE1TVZ4s4Y.jpg' },
        { nome: "Matrix", poster: TMDB + 'lDqMDI3xpbB9UQRyeXfei0MXhqb.jpg' }
      ],
      'Globoplay': [
        { nome: "Cidade de Deus", poster: TMDB + 'gfnXixcGC060QcG6JPxN6AMdVsq.jpg' },
        { nome: "Crepúsculo", poster: TMDB + 'o4ki1gYHkP6IWNdwjHvI9vzfpuC.jpg' },
        { nome: "Eu Sou a Lenda", poster: TMDB + 'cepvL7hPsaLXORlnGX4bk3JeKHd.jpg' }
      ],
      'Paramount+': [
        { nome: "Top Gun: Maverick", poster: TMDB + 'kPbuLGVSJHATkW9fX9L3h1wM0Pa.jpg' },
        { nome: "Gladiador 2", poster: TMDB + '342bly9MqveL65TnEFzx8TTUxcL.jpg' },
        { nome: "Sonic 3: O Filme", poster: TMDB + 'tfM1T6tAivjvy0sLwt6Y9WvlmzB.jpg' }
      ],
      'Apple TV': [
        { nome: "F1: O Filme", poster: TMDB + 'fMcY5hpVZQ0cLKHvFM1mo6GrAr0.jpg' },
        { nome: "Assassinos da Lua das Flores", poster: TMDB + 'kBLMPD5BCmcrHKIhjZ86uWHZG5K.jpg' },
        { nome: "Mad Max: Estrada da Fúria", poster: TMDB + 'tH64gzAHDFg7EFcgfkkZyHdGM5P.jpg' }
      ]
    };

    function norm(t) { return String(t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
    function produtoDoApp(app) {
      var keys = APPS[app], prods = window.CATALOG_PRODUCTS || [], vars = window.CATALOG_VARIANTS || [];
      function hit(n) { n = norm(n); return keys.some(function (k) { return n.indexOf(k) !== -1; }); }
      for (var i = 0; i < prods.length; i++) if (hit(prods[i].name)) return prods[i];
      for (var j = 0; j < vars.length; j++) {
        if (!hit(vars[j].name)) continue;
        var pid = vars[j].product_id || vars[j].productId;
        for (var k = 0; k < prods.length; k++) if (String(prods[k].id) === String(pid)) return prods[k];
      }
      return null;
    }

    // Monta os slides de filme apenas para os apps vendidos na loja
    var filmeSlides = [], porApp = [];
    Object.keys(FILMES).forEach(function (app) {
      var p = produtoDoApp(app);
      if (!p) return;
      var link = '/product/' + (p.slug || p.id);
      porApp.push(FILMES[app].map(function (f) {
        return { tipo: 'filme', app: app, nome: f.nome, tag: 'Disponível no ' + app,
          titulo: f.nome, texto: 'Assista agora no ' + app + '. A assinatura está disponível aqui na loja.',
          poster: f.poster, link: link, cta: 'Assinar ' + app };
      }));
    });
    // alterna entre os apps e limita a 6 filmes
    for (var r = 0; filmeSlides.length < 6 && porApp.some(function (l) { return l.length; }); r++) {
      porApp.forEach(function (l) { if (l.length && filmeSlides.length < 6) filmeSlides.push(l.shift()); });
    }
    // intercala jogo, filme, jogo, filme...
    var SLIDES = [], gi = 0, fi = 0;
    while (gi < JOGOS.length || fi < filmeSlides.length) {
      if (gi < JOGOS.length) SLIDES.push(Object.assign({ tipo: 'jogo' }, JOGOS[gi++]));
      if (fi < filmeSlides.length) SLIDES.push(filmeSlides[fi++]);
    }

    /* Símbolos oficiais das plataformas (vetores do Simple Icons) */
