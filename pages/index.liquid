    .nh-slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .9s ease, visibility 0s linear .9s; }
    .nh-slide.is-active { opacity: 1; visibility: visible; z-index: 1; transition: opacity .9s ease; }
    .nh-media { position: absolute; inset: 0; }
    .nh-bg {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 68% 28%;
      opacity: 0; transition: opacity .7s ease;
    }
    .nh-bg.is-ready { opacity: 1; }
    @media (min-width: 1024px) and (hover: hover) {
      .nh-slide:not(.is-movie) .nh-bg { transform: scale(1.04); transition: opacity .7s ease, transform 8s cubic-bezier(.2,.6,.2,1); }
      .nh-slide.is-active:not(.is-movie) .nh-bg { transform: scale(1); }
    }
    .nh-slide.is-movie .nh-bg { filter: blur(22px) saturate(1.4) brightness(.5); transform: scale(1.2); }
    .nh-art {
      position: absolute; top: 0; bottom: 0; right: max(0px, calc((100vw - 80rem) / 2)); height: 100%; width: auto; aspect-ratio: 2 / 3;
      object-fit: cover; opacity: 0; transition: opacity .7s ease;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 28%, #000 84%, transparent 100%);
              mask-image: linear-gradient(90deg, transparent 0%, #000 28%, #000 84%, transparent 100%);
    }
    .nh-art.is-ready { opacity: 1; }
    .nh-shade {
      position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,0) 22%), linear-gradient(0deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,0) 46%);
    }

    /* Faixa */
    .nh-band {
      position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; height: var(--nh-band);
      background: linear-gradient(180deg, rgba(10,6,5,.6), rgba(10,6,5,.76));
      border-top: 1px solid rgba(255,255,255,.12);
    }
    @media (min-width: 1024px) and (hover: hover) {
      .nh-band { background: linear-gradient(180deg, rgba(10,6,5,.44), rgba(10,6,5,.62)); -webkit-backdrop-filter: blur(12px) saturate(150%); backdrop-filter: blur(12px) saturate(150%); }
    }
    .nh-band-in { height: 100%; max-width: 80rem; margin: 0 auto; padding: 0 32px var(--nh-tear); display: flex; align-items: center; justify-content: space-between; gap: 28px; }
    .nh-txt { min-width: 0; flex: 1; }
    .nh-label {
      display: inline-flex; align-items: center; gap: 10px; margin-bottom: 8px;
      font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.88);
    }
    .nh-label .fc-brand { height: 17px; width: auto; display: block; flex-shrink: 0; }
    .nh-label .fc-brand-hbo { height: 12px; }
    .nh-label .fc-brand-img { height: 19px; filter: brightness(0) invert(1); }
    .nh-label .nh-dot-sep { width: 4px; height: 4px; border-radius: 9999px; background: #FF422A; box-shadow: 0 0 10px #FF422A; }
    .nh-name {
      margin: 0; font-size: clamp(30px, 3.4vw, 48px); font-weight: 900; line-height: 1; letter-spacing: -.02em; text-transform: uppercase;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 4px 24px rgba(0,0,0,.4);
    }
    .nh-name.is-long { font-size: clamp(22px, 2.3vw, 34px); line-height: 1.04; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .nh-name.is-long + .nh-desc { display: none; }
    .nh-desc { margin: 8px 0 0; max-width: 720px; font-size: 14px; color: rgba(255,255,255,.76); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nh-acts { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .nh-cta, .nh-alt {
      position: relative; display: inline-flex; align-items: center; gap: 12px; height: 52px; border-radius: 8px;
      color: #fff; font-size: 14px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; white-space: nowrap;
    }
    .nh-cta {
      padding: 0 10px 0 22px;
      background: linear-gradient(135deg, #FF8A3D 0%, #FF422A 55%, #D92F1A 100%);
      box-shadow: inset 0 1px 1px rgba(255,255,255,.5), 0 14px 30px -12px rgba(255,66,42,.8);
      transition: transform .4s cubic-bezier(.34,1.56,.64,1), box-shadow .25s ease;
    }
    .nh-cta:hover { transform: translateY(-2px); box-shadow: inset 0 1px 1px rgba(255,255,255,.6), 0 18px 36px -12px rgba(255,66,42,.95); }
    .nh-sq { width: 32px; height: 32px; border: 1.5px solid rgba(255,255,255,.92); border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; transition: transform .3s ease; }
    .nh-sq svg { width: 16px; height: 16px; }
    .nh-cta:hover .nh-sq { transform: translateX(3px); }
    .nh-alt { padding: 0 20px; gap: 10px; }
    .nh-alt svg, .nh-alt .fc-brand { position: relative; z-index: 2; width: auto; height: 18px; display: block; flex-shrink: 0; }
    .nh-alt > svg { width: 18px; }
    .nh-alt .fc-brand-hbo { height: 13px; }
    .nh-alt-txt { position: relative; z-index: 2; }

    /* Entrada suave a cada troca */
    .nh-slide.is-active .nh-txt > *, .nh-slide.is-active .nh-acts { animation: nhUp .8s cubic-bezier(.2,.8,.2,1) both; }
    .nh-slide.is-active .nh-txt > :nth-child(2) { animation-delay: .06s; }
    .nh-slide.is-active .nh-txt > :nth-child(3) { animation-delay: .12s; }
    .nh-slide.is-active .nh-acts { animation-delay: .16s; }
    @keyframes nhUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

    /* Indicadores logo acima da faixa */
    .nh-dots {
      position: absolute; z-index: 3; left: 0; right: 0; bottom: calc(var(--nh-band) + 14px);
      max-width: 80rem; margin: 0 auto; padding: 0 32px; display: flex; gap: 6px;
    }
    .nh-dot { position: relative; width: 30px; height: 22px; padding: 0; border: 0; background: none; cursor: pointer; transition: width .45s var(--lg-spring, ease); }
