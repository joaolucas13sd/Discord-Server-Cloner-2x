      d.setAttribute('role', 'tab');
      d.setAttribute('aria-label', 'Ir para ' + s.nome);
      d.addEventListener('click', function () { go(i); restart(); });
      dots.appendChild(d);
    });

    track.querySelectorAll('img.is-loading').forEach(function (img) {
      function done() { img.classList.remove('is-loading'); }
      if (img.complete && img.naturalWidth) done(); else { img.addEventListener('load', done); img.addEventListener('error', done); }
    });
    var slides = track.children, current = 0, timer = null;
    function preload(i) {
      var el = slides[(i + slides.length) % slides.length];
      if (el) el.querySelectorAll('img[loading="lazy"]').forEach(function (img) { img.loading = 'eager'; });
    }
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

    function mark(i) {
