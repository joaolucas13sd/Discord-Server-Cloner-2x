0.24,46 L0.27,40.89 L1.65,35.78 L1.73,30.67 L1.57,25.56 L1.3,20.44 L1.37,15.33 L0.55,10.22 L0.01,5.11 Z' fill='%23000'/%3E%3C/svg%3E"); }
      .kc-img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; transition: transform .6s cubic-bezier(.2,.8,.2,1); }
      .kc-tile:hover .kc-img { transform: scale(1.06); }
      .kc-photo::after { content: ""; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 -34px 40px -22px rgba(0,0,0,.75), inset 0 0 0 1px rgba(0,0,0,.4); }
      .kc-panel { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; padding: 14px 6px 6px; }
      .categories-swiper .swiper-slide.kc-tile { height: auto; }
      .categories-swiper .swiper-wrapper { align-items: stretch; }
      .kc-name {
        font-family: 'Anton', Impact, 'Arial Narrow', sans-serif; font-weight: 400; font-size: 26px; line-height: 1; letter-spacing: .01em;
        text-transform: uppercase; color: #fff;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .kc-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
      .kc-sub { min-width: 0; font-size: 12px; color: rgba(255,255,255,.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .kc-go {
        flex-shrink: 0; width: 32px; height: 32px; border: 1.6px solid rgba(255,255,255,.92); border-radius: 9999px;
        display: inline-flex; align-items: center; justify-content: center; color: #fff;
        transition: background .25s ease, border-color .25s ease, transform .3s ease;
      }
      .kc-go svg { width: 16px; height: 16px; }
      .kc-tile:hover .kc-go { background: #FF422A; border-color: #FF422A; transform: translateX(2px); }
      @media (max-width: 639px) {
        .kc-tile { padding: 5px; }
        .kc-panel { padding: 10px 4px 4px; gap: 8px; }
        .kc-name { font-size: 19px; }
        .kc-sub { font-size: 10.5px; }
        .kc-go { width: 26px; height: 26px; } .kc-go svg { width: 13px; height: 13px; }
      }

      /* Antes do Swiper carregar */
      .categories-swiper:not(.swiper-initialized) .swiper-wrapper { display: flex; gap: 12px; overflow: hidden; }
      .categories-swiper:not(.swiper-initialized) .swiper-slide { flex-shrink: 0; width: calc((100% - 12px * 1.15) / 2.15); }
      @media (min-width: 480px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 14px * 1.6) / 2.6); } }
      @media (min-width: 640px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 16px * 2.2) / 3.2); } }
      @media (min-width: 768px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 16px * 2.8) / 3.8); } }
      @media (min-width: 1024px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 18px * 3.6) / 4.6); } }
      @media (min-width: 1280px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 18px * 4) / 5); } }
    </style>

    <section id="categorias" class="py-10 sm:py-14 sm:pb-0 pb-0 bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="cat-head mb-6 sm:mb-9">
          <h2 class="sec-title">Categorias</h2>
          <div class="cat-actions">
            <a href="/categories" class="cat-all">Ver todas
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <div class="cat-nav">
              <button type="button" class="categories-nav-prev cat-nav-btn lg-glass" aria-label="Categorias anteriores">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button type="button" class="categories-nav-next cat-nav-btn lg-glass" aria-label="Próximas categorias">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="categories-nav-wrapper">
          <div class="swiper categories-swiper">
            <div class="swiper-wrapper">
              {% for category in catalog.categories %}
                {% if category.icon != '' and category.icon != null %}
                  {% render 'category-card', category: category %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      (function initCategoriesSwiper() {
        if (typeof Swiper === 'undefined') return setTimeout(initCategoriesSwiper, 50);
        new Swiper('.categories-swiper', {
          slidesPerView: 2.15,
          spaceBetween: 12,
          grabCursor: true,
          watchOverflow: true,
          breakpoints: {
            480: { slidesPerView: 2.6, spaceBetween: 14 },
            640: { slidesPerView: 3.2, spaceBetween: 16 },
            768: { slidesPerView: 3.8, spaceBetween: 16 },
            1024: { slidesPerView: 4.6, spaceBetween: 18 },
            1280: { slidesPerView: 5, spaceBetween: 18 },
          },
          navigation: {
            prevEl: '.categories-nav-prev',
            nextEl: '.categories-nav-next',
          },
          pagination: {
            el: '.categories-swiper .swiper-pagination',
            clickable: true,
          },
        });
      })();
    </script>
  {% endif %}

  <!-- ===================== PRODUTOS EM DESTAQUE ===================== -->
  <section id="produtos" class="py-10 sm:py-16 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-8 sm:gap-10">
      <!-- Título da seção -->
      {% for category in catalog.categories %}
        <div>
          <h2 class="sec-title">{{ category.name | default: 'Sem nome' }}</h2>

          <!-- Grid de produtos -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4">
            {% for product in category.products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>

          {% if category.products == empty %}
            <div class="text-center py-20">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-16 w-16 text-neutral-800 mx-auto mb-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
              </svg>
              <p class="text-neutral-600 text-lg">Nenhum produto cadastrado ainda.</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>

  <!-- ===================== BANNER LOJA ===================== -->
  {% if store.banner %}
    <section class="py-6 sm:py-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border border-neutral-800">
          <img
            src="{{ store.banner }}"
            alt="{{ store.name }}"
            class="w-full sm:h-48 md:h-64 object-cover opacity-30 h-[270px]"
          >
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4">
            <p class="text-xs sm:text-sm text-neutral-400 font-semibold uppercase tracking-widest mb-1 sm:mb-2">
              Conheça
            </p>
            <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white line-clamp-2">{{ store.name }}</h3>
            {% if store.description %}
              <p class="mt-1 sm:mt-2 text-sm text-neutral-300 max-w-xs sm:max-w-md line-clamp-2">
                {{ store.description }}
              </p>
            {% endif %}
            <a
              href="/categories"
              class="mt-4 sm:mt-6 inline-flex items-center gap-2 px-5 sm:px-6 py-2 sm:py-2.5 bg-white hover:bg-neutral-200 text-black rounded-xl font-semibold text-sm transition-colors"
            >
              Ver catálogo completo
            </a>
          </div>
        </div>
      </div>
    </section>
  {% endif %}
</div>
