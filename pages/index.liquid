          : '<img class="fc-bg is-loading" src="' + esc(s.imagem) + '" srcset="' + esc(s.imagem) + ' 1920w, ' + esc(hd(s.imagem)) + ' 3840w" sizes="(max-width: 639px) 180vw, (max-width: 1280px) 100vw, 1280px" alt="" decoding="async" ' + lazy(i) + '>') +
        '<div class="fc-shade"></div>' +
        (movie ? '<img class="fc-poster is-loading" src="' + tmdb(s.poster, 'w780') + '" srcset="' + tmdb(s.poster, 'w500') + ' 500w, ' + tmdb(s.poster, 'w780') + ' 780w, ' + tmdb(s.poster, 'w1280') + ' 1280w, ' + tmdb(s.poster, 'original') + ' 2000w" sizes="(max-width: 639px) 120px, 300px" alt="Pôster de ' + esc(s.nome) + '" decoding="async" ' + lazy(i) + '>' : '') +
        '<div class="fc-content">' +
          (s.logo ? '<img class="fc-logo is-loading" src="' + esc(s.logo) + '" srcset="' + esc(s.logo) + ' 1x, ' + esc(hd(s.logo)) + ' 2x" alt="' + esc(s.nome) + '" decoding="async" ' + lazy(i) + ' onerror="this.remove()">' : '') +
          '<span class="fc-tag">' + esc(s.tag) + '</span>' +
          '<h2 class="fc-title">' + (movie ? esc(s.titulo) : s.titulo.replace(/<br>/g, ' <br>')) + '</h2>' +
          '<p class="fc-sub">' + esc(s.texto) + '</p>' +
        '</div>' +
        '<div class="fc-bottom">' +
          '<span class="fc-platform">' + marca(movie ? s.app : 'Steam') + '<span class="fc-sep"></span><span class="fc-name">' + esc(s.nome) + '</span></span>' +
          '<a class="fc-cta" href="' + esc(s.link || '/categories') + '">' + esc(s.cta || 'Ver ofertas') + ' ' + ICON_ARROW + '</a>' +
        '</div>';
