    document.addEventListener('visibilitychange', function () { pause(document.hidden); });

    // deslizar com o dedo
    var sx = 0, sy = 0, tracking = false;
    root.addEventListener('touchstart', function (e) { var t = e.touches[0]; sx = t.clientX; sy = t.clientY; tracking = true; pause(true); }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (!tracking) return; tracking = false; pause(false);
      var t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.3) show(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });
    // setas do teclado
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { show(cur + 1); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { show(cur - 1); e.preventDefault(); }
    });

    if (window.lgScan) window.lgScan();
  })();
  </script>

  <!-- ===================== CATEGORIAS MASTER ===================== -->

  {% include 'master-categories' %}

  <!-- ===================== CATEGORIAS ===================== -->
  {% assign tem_categorias = false %}
  {% for category in catalog.categories %}
    {% if category.icon != '' and category.icon != null %}
      {% assign tem_categorias = true %}
    {% endif %}
  {% endfor %}

  {% if tem_categorias %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <style>
      .cat-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
      .cat-actions { display: flex; align-items: center; gap: 14px; padding-bottom: 4px; }
      .cat-all { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: rgba(255,255,255,.72); text-decoration: none; white-space: nowrap; transition: color .2s, gap .25s; }
      .cat-all:hover { color: #fff; gap: 10px; }
      .cat-all svg { width: 16px; height: 16px; }
      .cat-nav { display: none; gap: 8px; }
      @media (min-width: 768px) { .cat-nav { display: flex; } }
      .cat-nav-btn { position: relative; width: 40px; height: 40px; border-radius: 9999px; display: inline-flex; align-items: center; justify-content: center; color: #fff; cursor: pointer; }
      .cat-nav-btn svg { position: relative; z-index: 2; width: 18px; height: 18px; }
      .cat-nav-btn.swiper-button-disabled { opacity: .35; pointer-events: none; }
      .cat-nav-btn.swiper-button-lock { display: none; }
      .categories-swiper { padding: 6px 2px 16px !important; margin: -6px -2px 0 !important; }

      /* Antes do Swiper carregar */
      .categories-swiper:not(.swiper-initialized) .swiper-wrapper { display: flex; gap: 12px; overflow: hidden; }
      .categories-swiper:not(.swiper-initialized) .swiper-slide { flex-shrink: 0; width: calc((100% - 12px * .6) / 1.6); }
      @media (min-width: 480px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 14px * 1.2) / 2.2); } }
      @media (min-width: 640px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 16px * 1.8) / 2.8); } }
      @media (min-width: 768px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 16px * 2.2) / 3.2); } }
      @media (min-width: 1024px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 16px * 3.2) / 4.2); } }
      @media (min-width: 1280px) { .categories-swiper:not(.swiper-initialized) .swiper-slide { width: calc((100% - 16px * 4) / 5); } }
    </style>

    <section id="categorias" class="py-10 sm:py-14 sm:pb-0 pb-0 bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="cat-head mb-6 sm:mb-9">
          <h2 class="sec-title">Categorias</h2>
          <div class="cat-actions">
            <a href="/categories" class="cat-all">Ver todas
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <div class="cat-nav">
              <button type="button" class="categories-nav-prev cat-nav-btn lg-glass" aria-label="Categorias anteriores">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button type="button" class="categories-nav-next cat-nav-btn lg-glass" aria-label="Próximas categorias">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="categories-nav-wrapper">
          <div class="swiper categories-swiper">
            <div class="swiper-wrapper">
              {% for category in catalog.categories %}
                {% if category.icon != '' and category.icon != null %}
                  {% render 'category-card', category: category %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      (function initCategoriesSwiper() {
        if (typeof Swiper === 'undefined') return setTimeout(initCategoriesSwiper, 50);
        new Swiper('.categories-swiper', {
          slidesPerView: 1.6,
          spaceBetween: 12,
          grabCursor: true,
          watchOverflow: true,
          breakpoints: {
            480: { slidesPerView: 2.2, spaceBetween: 14 },
            640: { slidesPerView: 2.8, spaceBetween: 16 },
            768: { slidesPerView: 3.2, spaceBetween: 16 },
            1024: { slidesPerView: 4.2, spaceBetween: 16 },
            1280: { slidesPerView: 5, spaceBetween: 16 },
          },
          navigation: {
            prevEl: '.categories-nav-prev',
            nextEl: '.categories-nav-next',
          },
          pagination: {
            el: '.categories-swiper .swiper-pagination',
            clickable: true,
          },
        });
      })();
    </script>
  {% endif %}

  <!-- ===================== PRODUTOS EM DESTAQUE ===================== -->
  <section id="produtos" class="py-10 sm:py-16 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-8 sm:gap-10">
      <!-- Título da seção -->
      {% for category in catalog.categories %}
        <div>
          <h2 class="sec-title">{{ category.name | default: 'Sem nome' }}</h2>

          <!-- Grid de produtos -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4">
            {% for product in category.products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>

          {% if category.products == empty %}
            <div class="text-center py-20">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-16 w-16 text-neutral-800 mx-auto mb-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
              </svg>
              <p class="text-neutral-600 text-lg">Nenhum produto cadastrado ainda.</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>

  <!-- ===================== BANNER LOJA ===================== -->
  {% if store.banner %}
    <section class="py-6 sm:py-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border border-neutral-800">
          <img
            src="{{ store.banner }}"
            alt="{{ store.name }}"
            class="w-full sm:h-48 md:h-64 object-cover opacity-30 h-[270px]"
          >
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4">
            <p class="text-xs sm:text-sm text-neutral-400 font-semibold uppercase tracking-widest mb-1 sm:mb-2">
              Conheça
            </p>
            <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white line-clamp-2">{{ store.name }}</h3>
            {% if store.description %}
              <p class="mt-1 sm:mt-2 text-sm text-neutral-300 max-w-xs sm:max-w-md line-clamp-2">
                {{ store.description }}
              </p>
            {% endif %}
            <a
              href="/categories"
              class="mt-4 sm:mt-6 inline-flex items-center gap-2 px-5 sm:px-6 py-2 sm:py-2.5 bg-white hover:bg-neutral-200 text-black rounded-xl font-semibold text-sm transition-colors"
            >
              Ver catálogo completo
            </a>
          </div>
        </div>
      </div>
    </section>
  {% endif %}
</div>
