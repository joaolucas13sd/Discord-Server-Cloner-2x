      if (!reduce) timer = setInterval(function () { go(current + 1); }, 6000);
    }
    document.getElementById('fc-prev').addEventListener('click', function () { go(current - 1); restart(); });
    document.getElementById('fc-next').addEventListener('click', function () { go(current + 1); restart(); });
    var vp = track.parentNode;
    vp.addEventListener('mouseenter', function () { clearInterval(timer); });
    vp.addEventListener('mouseleave', restart);
