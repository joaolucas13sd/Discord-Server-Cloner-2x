    var DISNEY_LOGO = 'https://upload.wikimedia.org/wikipedia/commons/3/3e/Disney%2B_logo.svg';
    var ICON_PLAY = '<svg class="fc-brand" style="aspect-ratio:1/1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4Z" fill="currentColor"/></svg>';
    function simbolo(k, label) {
      var s = SIMBOLOS[k];
      return '<svg class="fc-brand fc-brand-' + k + '" style="aspect-ratio:' + s.ar + '" viewBox="' + s.vb + '" fill="' + s.cor + '" role="img" aria-label="' + label + '"><path d="' + s.d + '"/></svg>';
    }
    /* Como cada plataforma aparece: símbolo oficial (+ nome quando o símbolo não traz o nome) */
    function marca(app) {
      switch (app) {
        case 'Steam':       return simbolo('steam', 'Steam') + '<span>Steam</span>';
        case 'Netflix':     return simbolo('netflix', 'Netflix') + '<span>Netflix</span>';
        case 'Prime Video': return simbolo('primevideo', 'Prime Video');
        case 'HBO Max':     return simbolo('hbo', 'HBO') + '<span>Max</span>';
        case 'Paramount+':  return simbolo('paramountplus', 'Paramount+') + '<span>Paramount+</span>';
        case 'Apple TV':    return simbolo('appletv', 'Apple TV');
        case 'Disney+':     return '<img class="fc-brand fc-brand-img" src="' + DISNEY_LOGO + '" alt="Disney+" onerror="this.outerHTML=\'<span>Disney+</span>\'">';
        default:            return ICON_PLAY + '<span>' + esc(app) + '</span>';
      }
    }
    var ICON_ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

    var track = document.getElementById('fc-track');
    var dots = document.getElementById('fc-dots');
    if (!track) return;
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

    function hd(u) { return String(u).replace(/(library_hero|logo)\.(jpg|png)$/, '$1_2x.$2'); }
    function tmdb(u, size) { return esc(String(u).replace(/\/t\/p\/[^/]+\//, '/t/p/' + size + '/')); }
    function lazy(i) { return i < 2 ? (i ? 'loading="eager"' : 'loading="eager" fetchpriority="high"') : 'loading="lazy"'; }

