    };
    var DISNEY_LOGO = 'https://upload.wikimedia.org/wikipedia/commons/3/3e/Disney%2B_logo.svg';
    var ICON_PLAY = '<svg class="fc-brand" style="aspect-ratio:1/1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4Z" fill="currentColor"/></svg>';
    function simbolo(k, label) {
      var s = SIMBOLOS[k];
      return '<svg class="fc-brand fc-brand-' + k + '" style="aspect-ratio:' + s.ar + '" viewBox="' + s.vb + '" fill="' + s.cor + '" role="img" aria-label="' + label + '"><path d="' + s.d + '"/></svg>';
    }
    /* Como cada plataforma aparece: símbolo oficial (+ nome quando o símbolo não traz o nome) */
    function marca(app) {
      switch (app) {
        case 'Steam':       return simbolo('steam', 'Steam') + '<span>Steam</span>';
        case 'Netflix':     return simbolo('netflix', 'Netflix') + '<span>Netflix</span>';
        case 'Prime Video': return simbolo('primevideo', 'Prime Video');
        case 'HBO Max':     return simbolo('hbo', 'HBO') + '<span>Max</span>';
        case 'Paramount+':  return simbolo('paramountplus', 'Paramount+') + '<span>Paramount+</span>';
        case 'Apple TV':    return simbolo('appletv', 'Apple TV');
        case 'Disney+':     return '<img class="fc-brand fc-brand-img" src="' + DISNEY_LOGO + '" alt="Disney+" onerror="this.outerHTML=\'<span>Disney+</span>\'">';
        default:            return ICON_PLAY + '<span>' + esc(app) + '</span>';
      }
    }

    function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function tmdb(u, size) { return esc(String(u).replace(/\/t\/p\/[^/]+\//, '/t/p/' + size + '/')); }
    function soSimbolo(app) { return marca(app).replace(/<span>[^<]*<\/span>/g, ''); }
    var ICON_ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
    var ICON_GRID = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>';

    var root = document.getElementById('nh');
    var wrap = document.getElementById('nh-slides');
    var dots = document.getElementById('nh-dots');
    if (!root || !SLIDES.length) { if (root) root.remove(); return; }

    SLIDES.forEach(function (s, i) {
      var movie = s.tipo === 'filme';
      var app = movie ? s.app : 'Steam';
      var el = document.createElement('article');
      el.className = 'nh-slide' + (movie ? ' is-movie' : '');
      el.setAttribute('aria-roledescription', 'slide');
      el.setAttribute('aria-label', (i + 1) + ' de ' + SLIDES.length + ': ' + s.nome);
      var bg = movie
        ? 'data-src="' + tmdb(s.poster, 'w92') + '"'
        : 'data-src="' + STEAM + s.id + '/library_hero.jpg" data-srcset="' + STEAM + s.id + '/library_hero.jpg 1920w, ' + STEAM + s.id + '/library_hero_2x.jpg 3840w" sizes="100vw"';
      var secundario = movie
        ? '<a class="nh-alt lg-glass" href="/categories" aria-label="Ver todos os planos">' + ICON_GRID + '<span class="nh-alt-txt">Todos os planos</span></a>'
        : '<a class="nh-alt lg-glass" href="https://store.steampowered.com/app/' + s.id + '/" target="_blank" rel="noopener" aria-label="Ver na Steam">' + soSimbolo('Steam') + '<span class="nh-alt-txt">Ver na Steam</span></a>';
      el.innerHTML =
        '<div class="nh-media"><img class="nh-bg" ' + bg + ' alt="" decoding="async">' +
          (movie ? '<img class="nh-art" data-src="' + tmdb(s.poster, 'w780') + '" data-srcset="' + tmdb(s.poster, 'w342') + ' 342w, ' + tmdb(s.poster, 'w500') + ' 500w, ' + tmdb(s.poster, 'w780') + ' 780w, ' + tmdb(s.poster, 'w1280') + ' 1280w" sizes="(max-width: 639px) 60vw, 34vw" alt="Pôster de ' + esc(s.nome) + '" decoding="async">' : '') +
        '</div>' +
        '<div class="nh-shade"></div>' +
        '<div class="nh-band"><div class="nh-band-in">' +
          '<div class="nh-txt">' +
            '<span class="nh-label">' + soSimbolo(app) + '<i class="nh-dot-sep"></i>' + esc(s.tag) + '</span>' +
            '<h2 class="nh-name' + (s.nome.length > 26 ? ' is-long' : '') + '">' + esc(s.nome) + '</h2>' +
            '<p class="nh-desc">' + esc(s.texto) + '</p>' +
          '</div>' +
          '<div class="nh-acts">' + secundario +
            '<a class="nh-cta" href="' + esc(s.link || '/categories') + '">' + esc(s.cta || 'Ver ofertas') + '<span class="nh-sq">' + ICON_ARROW + '</span></a>' +
          '</div>' +
        '</div></div>';
      wrap.appendChild(el);

      var d = document.createElement('button');
      d.type = 'button'; d.className = 'nh-dot';
      d.setAttribute('role', 'tab');
      d.setAttribute('aria-label', 'Destaque ' + (i + 1) + ': ' + s.nome);
      d.innerHTML = '<span class="bar"><span class="fill"></span></span>';
      d.addEventListener('click', function () { show(i); });
      d.querySelector('.fill').addEventListener('animationend', function () { if (i === cur) show(cur + 1); });
      dots.appendChild(d);
    });

    var slides = wrap.children, n = slides.length, cur = -1;

    function hydrate(i, then) {
      var el = slides[(i + n) % n];
      if (!el) return;
      if (then) { if (el.__ready) then(); else (el.__wait = el.__wait || []).push(then); }
      if (el.__ok) return;
      el.__ok = 1;
      var bg = el.querySelector('.nh-bg');
      el.querySelectorAll('img[data-src]').forEach(function (img) {
        var fired = false;
        function done() {
          if (fired) return; fired = true;
          img.classList.add('is-ready');
          if (img === bg) { el.__ready = 1; var w = el.__wait || []; el.__wait = []; w.forEach(function (f) { f(); }); }
        }
        img.addEventListener('load', done);
        img.addEventListener('error', function () {
          if (img.classList.contains('nh-logo') && img.parentNode) { img.parentNode.outerHTML = '<span class="nh-title">' + esc(img.alt) + '</span>'; return; }
          done();
        });
        if (img.dataset.srcset) img.srcset = img.dataset.srcset;
        img.src = img.dataset.src;
        if (img.complete && img.naturalWidth) done();
      });
    }
    var idle = window.requestIdleCallback ? function (f) { requestIdleCallback(f, { timeout: 2500 }); } : function (f) { setTimeout(f, 900); };
    function show(i) {
      i = (i + n) % n;
      if (i === cur) return;
      if (cur > -1) {
        slides[cur].classList.remove('is-active');
        slides[cur].setAttribute('aria-hidden', 'true');
        dots.children[cur].classList.remove('is-active');
        dots.children[cur].setAttribute('aria-selected', 'false');
      }
      cur = i;
      // só o banner atual carrega; o próximo é baixado depois, com a página ociosa
      hydrate(i, function () { idle(function () { hydrate(i + 1); }); });
      slides[i].classList.add('is-active');
      slides[i].removeAttribute('aria-hidden');
      dots.children[i].classList.add('is-active');
      dots.children[i].setAttribute('aria-selected', 'true');
    }
    for (var j = 0; j < n; j++) slides[j].setAttribute('aria-hidden', 'true');
    var first = slides[0].querySelector('.nh-bg'); if (first) first.setAttribute('fetchpriority', 'high');
    show(0);

    // pausa ao passar o mouse, focar ou trocar de aba
    function pause(on) { root.classList.toggle('is-paused', on); }
    root.addEventListener('mouseenter', function () { pause(true); });
    root.addEventListener('mouseleave', function () { pause(false); });
    root.addEventListener('focusin', function () { pause(true); });
    root.addEventListener('focusout', function () { pause(false); });
    document.addEventListener('visibilitychange', function () { pause(document.hidden); });

    // deslizar com o dedo
    var sx = 0, sy = 0, tracking = false;
    root.addEventListener('touchstart', function (e) { var t = e.touches[0]; sx = t.clientX; sy = t.clientY; tracking = true; pause(true); }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (!tracking) return; tracking = false; pause(false);
      var t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.3) show(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });
    // setas do teclado
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { show(cur + 1); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { show(cur - 1); e.preventDefault(); }
    });

    if (window.lgScan) window.lgScan();
  })();
  </script>

