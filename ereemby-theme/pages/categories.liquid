<div class="bg-black">
  <section class="max-w-7xl mx-auto p-4 sm:p-6">
    <!-- Rei dos Nitros: topo da página de categorias -->
    <section class="rn-cats-hero">
      <svg class="rn-cats-hero__star rn-cats-hero__star--1" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.6 6.6 5.4 11.4 12 12-6.6.6-11.4 5.4-12 12-.6-6.6-5.4-11.4-12-12C6.6 11.4 11.4 6.6 12 0Z"/></svg>
      <svg class="rn-cats-hero__star rn-cats-hero__star--2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.6 6.6 5.4 11.4 12 12-6.6.6-11.4 5.4-12 12-.6-6.6-5.4-11.4-12-12C6.6 11.4 11.4 6.6 12 0Z"/></svg>
      <svg class="rn-cats-hero__star rn-cats-hero__star--3" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.6 6.6 5.4 11.4 12 12-6.6.6-11.4 5.4-12 12-.6-6.6-5.4-11.4-12-12C6.6 11.4 11.4 6.6 12 0Z"/></svg>
      <nav class="rn-cat__crumb" aria-label="Caminho"><a href="/">Início</a><span aria-hidden="true">›</span><span class="rn-cat__here">Categorias</span></nav>
      <h1 class="rn-cats-hero__title">Todas as categorias</h1>
      <p class="rn-cats-hero__txt">Escolha por onde começar: Discord Nitro, decorações, jogos da Steam, assinaturas e muito mais.</p>
      <label class="rn-cats-hero__search">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" id="rn-cat-busca" placeholder="Buscar categoria" autocomplete="off" aria-label="Buscar categoria">
      </label>
    </section>
    <p class="rn-cats-vazio" id="rn-cats-vazio" hidden>Nenhuma categoria encontrada. Tente outro nome.</p>

    <!-- ===================== CATEGORIAS MASTER ===================== -->

    {% assign has_category_with_subs = false %}
    {% for category in catalog.categories_all %}
      {% if category.sub_categories and category.sub_categories.size > 0 %}
        {% assign has_category_with_subs = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_category_with_subs %}
      <section id="categorias-pai" class="py-10 sm:py-14">
        <div class="flex items-center justify-between mb-6 sm:mb-10">
          <div>
            <p class="text-neutral-500 text-xs sm:text-sm font-semibold uppercase tracking-widest mb-1">Explore</p>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Categorias</h2>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
          {% for category in catalog.categories_all %}
            {% if category.sub_categories and category.sub_categories.size > 0 %}
              <a
                href="/category/{{ category.slug | default: category.id }}"
                data-rn-nome="{{ category.name | downcase }} {{ category.sub_title | downcase }}"
                class="group relative flex items-center gap-4 p-4 bg-neutral-950 border border-neutral-800 hover:border-neutral-500 rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-black/30 hover:-translate-y-1"
              >
                {% if category.banner %}
                  <div
                    class="absolute inset-0 w-full h-full opacity-20 group-hover:opacity-30 group-hover:scale-105 transition-all duration-500"
                    style="background-image: url('{{ category.banner }}'); background-size: cover; background-position: center; background-repeat: no-repeat;"
                  ></div>
                  <div
                    class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/80 to-transparent"
                  ></div>
                {% endif %}

                <div class="relative shrink-0 w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden bg-neutral-900 border border-neutral-800 flex items-center justify-center">
                  {% if category.icon != '' and category.icon != null %}
                    <img
                      src="{{ category.icon }}"
                      alt="{{ category.name | default: 'Categoria' }}"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    >
                  {% else %}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-10 h-10 text-neutral-500 group-hover:text-neutral-300 group-hover:scale-110 transition-all duration-500"
                      viewBox="0 0 256 256"
                      fill="currentColor"
                    >
                      <path d="M104,40H56A16,16,0,0,0,40,56v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V56A16,16,0,0,0,104,40Zm0,64H56V56h48v48Zm96-64H152a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V56A16,16,0,0,0,200,40Zm0,64H152V56h48v48Zm-96,32H56a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V152A16,16,0,0,0,104,136Zm0,64H56V152h48v48Zm96-64H152a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V152A16,16,0,0,0,200,136Zm0,64H152V152h48v48Z"></path>
                    </svg>
                  {% endif %}
                </div>

                <div class="relative flex-1 min-w-0 flex flex-col gap-2">
                  <div class="min-w-0">
                    <h3 class="text-white font-extrabold text-base sm:text-lg leading-tight truncate group-hover:text-neutral-200 transition-colors">
                      {{ category.name | default: 'Sem nome' }}
                    </h3>
                    <p class="mt-1 text-xs sm:text-sm text-neutral-400 line-clamp-2">
                      Visualizar produtos da categoria
                    </p>
                  </div>
                  <span class="inline-flex items-center gap-1.5 w-fit px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl bg-white text-black text-xs sm:text-sm font-semibold transition-colors group-hover:bg-neutral-200">
                    Ver produtos
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 256 256" fill="currentColor">
                      <path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path>
                    </svg>
                  </span>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- ===================== CATEGORIAS ===================== -->
    {% if catalog.categories.size > 0 %}
      <div class="py-4 sm:py-6" id="rn-cats-grade">

        <div class="grid gap-3 sm:gap-4 grid-cols-2 min-[480px]:grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6">
          {% for category in catalog.categories %}
            <a
              href="/category/{{ category.slug | default: category.id }}"
              data-rn-nome="{{ category.name | downcase }} {{ category.sub_title | downcase }}"
              style="aspect-ratio: 180 / 250;"
              class="swiper-slide block w-full group relative bg-neutral-950 border border-neutral-800 hover:border-neutral-500 rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-black/30 hover:-translate-y-1"
            >
              {% if category.icon != '' and category.icon != null %}
                <img
                  src="{{ category.icon }}"
                  alt="{{ category.name | default: 'Categoria' }}"
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                >
                {% if category.sub_title %}
                  <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent px-3 py-3">
                    <p class="text-white text-xs font-semibold uppercase">
                      {{ category.sub_title }}
                    </p>
                  </div>
                {% endif %}
              {% else %}
                <div class="absolute inset-0 w-full h-full flex flex-col items-center justify-center gap-3 bg-neutral-900 p-4">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-16 h-16 sm:w-20 sm:h-20 text-neutral-600 group-hover:text-neutral-400 group-hover:scale-110 transition-all duration-500"
                    viewBox="0 0 256 256"
                    fill="currentColor"
                  >
                    <path d="M104,40H56A16,16,0,0,0,40,56v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V56A16,16,0,0,0,104,40Zm0,64H56V56h48v48Zm96-64H152a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V56A16,16,0,0,0,200,40Zm0,64H152V56h48v48Zm-96,32H56a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V152A16,16,0,0,0,104,136Zm0,64H56V152h48v48Zm96-64H152a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16h48a16,16,0,0,0,16-16V152A16,16,0,0,0,200,136Zm0,64H152V152h48v48Z"></path>
                  </svg>
                </div>
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent px-3 py-3">
                  <p class="text-white text-xs font-semibold uppercase">
                    {{ category.sub_title | default: category.name }}
                  </p>
                </div>
              {% endif %}
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </section>
</div>

<script>
  (function () {
    var input = document.getElementById('rn-cat-busca');
    if (!input) return;
    function norm(t) { return (t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
    input.addEventListener('input', function () {
      var q = norm(input.value.trim()), vis = 0, total = 0;
      document.querySelectorAll('[data-rn-nome]').forEach(function (a) {
        total++;
        var ok = !q || norm(a.getAttribute('data-rn-nome')).indexOf(q) !== -1;
        a.style.display = ok ? '' : 'none';
        if (ok) vis++;
      });
      document.getElementById('rn-cats-vazio').hidden = !(total && vis === 0);
    });
  })();
</script>
