<section class="bg-black text-white">
  <div class="max-w-4xl mx-auto p-4 sm:p-6">

    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-sm text-neutral-500 mb-4 sm:mb-6">
      <a href="/" class="hover:text-white transition-colors">Início</a>
      <svg class="w-4 h-4 min-w-[16px] min-h-[16px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-neutral-200 font-medium">Termos de Uso</span>
    </nav>

    <!-- Content -->
    {% if term.content and term.content != '' %}
      <!-- Header -->
      <header class="mb-8 sm:mb-10 pb-6 border-b border-neutral-800">
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">Termos de Uso</h1>

        {% if term.updated_date %}
          <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 bg-neutral-950 border border-neutral-800 rounded-full text-xs sm:text-sm text-neutral-400">
            <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>
              Última atualização:
              <strong class="text-neutral-200 font-semibold ml-1">
                {{ term.updated_date | date: '%d/%m/%Y' }}
              </strong>
            </span>
          </div>
        {% endif %}
      </header>

      <article class="reset-content-css">
        {{ term.content }}
      </article>
    {% else %}
      <div class="flex flex-col items-center justify-center py-20 sm:py-28 text-center">
        <svg class="w-10 h-10 text-neutral-700 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M9 12h6m-6 4h4m4 5H7a2 2 0 01-2-2V5a2 2 0 012-2h7l5 5v12a2 2 0 01-2 2z"/>
        </svg>
        <h2 class="text-base sm:text-lg font-semibold text-neutral-300 mb-1.5">Nenhum termo publicado</h2>
        <p class="text-neutral-500 text-sm max-w-[260px]">Esta loja ainda não cadastrou os termos de uso.</p>
        <div class="mt-6 h-px w-12 bg-neutral-800"></div>
      </div>
    {% endif %}

    <!-- Footer / Back link -->
    {% if term.content and term.content != '' %}
      <div class="mt-10 sm:mt-14 pt-6 border-t border-neutral-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <p class="text-xs sm:text-sm text-neutral-500">
          Em caso de dúvidas sobre estes termos, entre em contato com a loja.
        </p>
        <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-950 hover:bg-neutral-900 border border-neutral-800 hover:border-white/30 text-neutral-300 hover:text-white text-sm font-medium rounded-xl transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Voltar para a Loja
        </a>
      </div>
    {% endif %}

  </div>
</section>
