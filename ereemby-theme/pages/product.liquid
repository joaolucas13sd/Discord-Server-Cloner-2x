{% unless product.id %}
  {% comment %} Rei dos Nitros: produto não encontrado, com sugestões (os mais vendidos primeiro, depois o resto do catálogo) {% endcomment %}
  <style>
    .rn-nf { width: 100%; max-width: 980px; margin: 0 auto; padding: 34px 16px 120px; box-sizing: border-box; color: #fff; text-align: center; }
    .rn-nf__ico { position: relative; display: grid; place-items: center; width: 92px; height: 92px; margin: 0 auto 18px; border-radius: 28px; background: radial-gradient(circle at 30% 25%, rgba(34,242,106,.25), rgba(34,242,106,.04) 70%); border: 1px solid #1f5a37; color: #22f26a; animation: rnNfFlutua 3.2s ease-in-out infinite; }
    @keyframes rnNfFlutua { 50% { transform: translateY(-6px) rotate(-3deg); } }
    .rn-nf__t { margin: 0 0 8px; font-family: var(--rn-font-round, inherit); font-size: clamp(24px, 6.5vw, 34px); font-weight: 800; line-height: 1.1; }
    .rn-nf__t span { color: #22f26a; }
    .rn-nf__p { max-width: 430px; margin: 0 auto; color: #a1a2a8; font-size: 15px; line-height: 1.55; }
    .rn-nf__acoes { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 22px 0 34px; }
    .rn-nf__b { display: inline-flex; align-items: center; gap: 8px; padding: 13px 20px; border-radius: 14px; font: inherit; font-size: 15px; font-weight: 800; text-decoration: none !important; cursor: pointer; }
    .rn-nf__b--1 { border: 0; background: #22f26a; color: #04140a !important; box-shadow: 0 5px 0 #0d6b34; }
    .rn-nf__b--2 { border: 1.5px solid #3a3b42; background: transparent; color: #fff !important; }
    .rn-nf__k { margin: 0 0 4px; color: #22f26a; font-size: 12px; font-weight: 800; letter-spacing: .14em; }
    .rn-nf__h { margin: 0 0 14px; font-family: var(--rn-font-round, inherit); font-size: 22px; font-weight: 800; }
    .rn-nf__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; text-align: left; }
    @media (min-width: 720px) { .rn-nf__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .rn-nf__c { display: flex; flex-direction: column; gap: 6px; padding: 8px; border: 1px solid #23242a; border-radius: 16px; background: #0f1012; color: #fff !important; text-decoration: none !important; transition: border-color .15s, transform .15s; animation: rnNfEntra .45s ease both; }
    .rn-nf__c:hover { border-color: #22f26a; transform: translateY(-2px); }
    @keyframes rnNfEntra { from { opacity: 0; transform: translateY(10px); } }
    .rn-nf__img { display: block; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: #18191c; }
    .rn-nf__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .rn-nf__n { font-size: 14px; font-weight: 800; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .rn-nf__pr { margin-top: auto; color: #8d8e93; font-size: 12px; }
    .rn-nf__pr b { display: block; color: #22f26a; font-size: 15px; }
  </style>
  <div class="rn-nf">
    <div class="rn-nf__ico" aria-hidden="true"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M8.5 9.5h.01M13.5 9.5h.01M8.8 13.6a3.2 3.2 0 0 1 4.4 0"/></svg></div>
    <h1 class="rn-nf__t">Ops! Esse produto <span>não está aqui</span></h1>
    <p class="rn-nf__p">Ele pode ter mudado de endereço ou saído da loja. Mas calma: separamos alguns produtos que talvez você goste.</p>
    <div class="rn-nf__acoes">
      <a class="rn-nf__b rn-nf__b--1" href="/"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>Voltar para a loja</a>
      <a class="rn-nf__b rn-nf__b--2" href="/categories"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg>Ver categorias</a>
    </div>
    <p class="rn-nf__k">TALVEZ VOCÊ TENHA INTERESSE</p>
    <h2 class="rn-nf__h">Os favoritos da Rei dos Nitros</h2>
    <div class="rn-nf__grid">
      {% assign rn_nf_pri = 'Discord Nitro|Conta Nitrada|Decorações de Perfil|Jogos Steam|Netflix|Combo Assinaturas|Impulsos Servidor|Spotify' | split: '|' %}
      {% assign rn_nf_n = 0 %}
      {% for nome in rn_nf_pri %}
        {% for p in catalog.products %}
          {% if p.name == nome and rn_nf_n < 8 %}
            {% assign rn_nf_n = rn_nf_n | plus: 1 %}
            {% assign rn_nf_preco = p.price %}
            {% if p.variants_values.min %}{% assign rn_nf_preco = p.variants_values.min.price %}{% endif %}
            <a class="rn-nf__c" href="/product/{{ p.id }}" style="animation-delay: {{ rn_nf_n | times: 60 }}ms">
              <span class="rn-nf__img">{% if p.images.size > 0 %}<img src="{{ p.images[0] }}" alt="" loading="lazy">{% endif %}</span>
              <span class="rn-nf__n">{{ p.name }}</span>
              <span class="rn-nf__pr">{% if p.variants.size > 1 %}a partir de{% endif %}<b>{{ rn_nf_preco | priceFormatter }}</b></span>
            </a>
          {% endif %}
        {% endfor %}
      {% endfor %}
      {% for p in catalog.products %}
        {% if rn_nf_n >= 8 %}{% break %}{% endif %}
        {% unless rn_nf_pri contains p.name %}
          {% if p.images.size > 0 %}
            {% assign rn_nf_n = rn_nf_n | plus: 1 %}
            {% assign rn_nf_preco = p.price %}
            {% if p.variants_values.min %}{% assign rn_nf_preco = p.variants_values.min.price %}{% endif %}
            <a class="rn-nf__c" href="/product/{{ p.id }}" style="animation-delay: {{ rn_nf_n | times: 60 }}ms">
              <span class="rn-nf__img"><img src="{{ p.images[0] }}" alt="" loading="lazy"></span>
              <span class="rn-nf__n">{{ p.name }}</span>
              <span class="rn-nf__pr">{% if p.variants.size > 1 %}a partir de{% endif %}<b>{{ rn_nf_preco | priceFormatter }}</b></span>
            </a>
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>
  </div>
  {% break %}
{% endunless %}

{% if product.type == 'variante' and product.variants.size > 0 %}
  {% assign _v0 = product.variants[0] %}
  {% assign display_price = _v0.price %}
  {% assign display_comparison = _v0.comparison %}
  {% assign display_stock = _v0.stock_amount %}
  {% assign display_qty_min = _v0.quantity.min %}
  {% assign display_qty_max = _v0.quantity.max %}
  {% assign display_discount_percentage = _v0.discount_percentage %}
{% else %}
  {% assign display_price = product.price %}
  {% assign display_comparison = product.comparison %}
  {% assign display_stock = product.stock_amount %}
  {% assign display_qty_min = product.quantity.min %}
  {% assign display_qty_max = product.quantity.max %}
  {% assign display_discount_percentage = product.discount_percentage %}
{% endif %}

{% if product.type == 'variante' and product.variants.size > 0 %}
  {% assign effective_type = _v0.type %}
  {% assign effective_automatic = _v0.automatic %}
  {% if _v0.embed_video and _v0.embed_video != '' %}
    {% assign effective_embed = _v0.embed_video %}
  {% else %}
    {% assign effective_embed = product.embed_video %}
  {% endif %}
{% else %}
  {% assign effective_type = product.type %}
  {% assign effective_automatic = product.automatic %}
  {% assign effective_embed = product.embed_video %}
{% endif %}

{% comment %} Normalize embed URL for YouTube / Vimeo {% endcomment %}
{% assign embed_src = '' %}
{% if effective_embed and effective_embed != '' %}
  {% if effective_embed contains 'youtube.com/watch' %}
    {% assign _yt = effective_embed | split: 'v=' | last | split: '&' | first %}
    {% assign embed_src = 'https://www.youtube.com/embed/' | append: _yt %}
  {% elsif effective_embed contains 'youtu.be/' %}
    {% assign _yt = effective_embed | split: 'youtu.be/' | last | split: '?' | first %}
    {% assign embed_src = 'https://www.youtube.com/embed/' | append: _yt %}
  {% elsif effective_embed contains 'youtube.com/embed/' %}
    {% assign embed_src = effective_embed %}
  {% elsif effective_embed contains 'youtube.com/shorts/' %}
    {% assign _yt = effective_embed | split: 'shorts/' | last | split: '?' | first %}
    {% assign embed_src = 'https://www.youtube.com/embed/' | append: _yt %}
  {% elsif effective_embed contains 'vimeo.com' %}
    {% assign _vm = effective_embed | split: 'vimeo.com/' | last | split: '?' | first %}
    {% assign embed_src = 'https://player.vimeo.com/video/' | append: _vm %}
  {% else %}
    {% assign embed_src = effective_embed %}
  {% endif %}
{% endif %}

{% if effective_type == 'texto' %}
  {% assign is_out_of_stock = false %}
{% elsif display_stock <= 0 %}
  {% assign is_out_of_stock = true %}
{% else %}
  {% assign is_out_of_stock = false %}
{% endif %}

{% comment %} Rei dos Nitros: dados estruturados para o Google mostrar preço, estoque e nota no resultado da busca {% endcomment %}
{% assign _ld_total = product.feedback.stats.total | default: 0 %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","name":{{ product.name | json }},"image":{{ product.images | json }},"brand":{"@type":"Brand","name":{{ store.name | json }}},
"offers":{"@type":"Offer","priceCurrency":"BRL","price":{{ display_price | json }},"availability":"https://schema.org/{% if is_out_of_stock %}OutOfStock{% else %}InStock{% endif %}","seller":{"@type":"Organization","name":{{ store.name | json }}}}{% if options.feedback_status and _ld_total > 0 %},
"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ product.feedback.stats.average | json }},"reviewCount":{{ _ld_total | json }}}{% endif %}}
</script>

<script>
    window.PRODUCT_DATA = {
      id:            {{ product.id | json }},
      category_id:   {{ product.category_id | json }},
      title:         {{ product.name | json }},
      price:         {{ product.price | json }},
      originalPrice: {{ product.comparison | json }},
      description:   {{ product.description | json }},
      images:        {{ product.images | json }},
      stock_amount:  {{ product.stock_amount | json }},
      type:          {{ product.type | json }},
      variants:      {{ product.variants | json }},
      quantity:      {{ product.quantity | json }},
      embed_video:   {{ product.embed_video | json }},
    };
</script>

<script id="product-data" type="application/json">
  {{ product | json }}
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="{{ 'product.js' | asset_url }}"></script>
<script src="{{ 'feedback.js' | asset_url }}"></script>

<style>
  .related-products-nav-wrapper {
    position: relative;
  }
  .related-products-nav-prev,
  .related-products-nav-next {
    top: 50%;
    transform: translateY(-50%);
    display: flex !important;
    align-items: center;
    justify-content: center;
  }
  .related-products-nav-prev::after,
  .related-products-nav-next::after {
    display: none !important;
  }
  .related-products-nav-prev {
    left: -20px;
  }
  .related-products-nav-next {
    right: -20px;
  }
  @media (max-width: 639px) {
    .related-products-nav-prev,
    .related-products-nav-next {
      display: none !important;
    }
  }
  .related-products-nav-prev.swiper-button-lock,
  .related-products-nav-next.swiper-button-lock {
    display: none !important;
  }
  .related-products-swiper .swiper-pagination-lock {
    display: none !important;
  }
  .related-products-swiper .swiper-pagination-bullet {
    background: #444 !important;
    opacity: 1;
  }
  .related-products-swiper .swiper-pagination-bullet-active {
    background: #fff !important;
  }
  .related-products-swiper .swiper-slide {
    height: auto !important;
  }
  .related-products-swiper .swiper-slide > a {
    height: 100% !important;
  }

  .related-products-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    flex-wrap: nowrap;
    overflow: hidden;
    gap: 24px;
  }
  .related-products-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% - 12px) / 1.8);
    min-width: 0;
  }
  @media (min-width: 640px) {
    .related-products-swiper:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc(50% - 10px);
    }
  }
  @media (min-width: 1024px) {
    .related-products-swiper:not(.swiper-initialized) .swiper-slide {
      flex: 0 0 calc(25% - 18px);
    }
  }
</style>

<div class="min-h-screen bg-black">

  <!-- Product Section -->
  <div class="max-w-7xl mx-auto p-4 sm:p-6">

    <nav class="flex items-center space-x-2 text-sm text-neutral-500 sm:mb-6 mb-4">
      <a href="/" class="hover:text-white transition-colors">Início</a>
      <svg
        class="w-4 h-4 min-w-[16px] min-h-[16px]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7" /></svg>
      <a href="/category/{{ product.category_id }}" class="hover:text-white transition-colors">Produtos</a>
      <svg
        class="w-4 h-4 min-w-[16px] min-h-[16px]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7" /></svg>
      <span class="text-neutral-200 font-medium line-clamp-1">{{ product.name }}</span>
    </nav>

    {% comment %} Rei dos Nitros: fundo desfocado com a imagem do produto (computador) {% endcomment %}
    {% if product.images[0] %}<div class="rn-pp-bg" aria-hidden="true" style="background-image:url('{{ product.images[0] }}')"></div>{% endif %}
    <div class="bg-neutral-950 rounded-2xl shadow-xl shadow-black/40 overflow-hidden border border-neutral-800 rn-pp">
      <div class="lg:grid lg:grid-cols-2 lg:gap-0 rn-pp__grid">

        <!-- Image Gallery -->
        <div class="rn-pp__left">
        <div class="p-4 sm:p-6 lg:p-10 rn-pp__gal">
          <!-- Main Image -->
          <div class="relative rounded-xl overflow-hidden bg-neutral-950 shadow-md mb-4 border border-neutral-800" style="aspect-ratio: 16 / 9;">
            {% if product.images[0] %}
              <img
                id="main-product-image"
                src="{{ product.images[0] }}"
                alt="{{ product.name }}"
                class="w-full h-full object-cover transition-opacity duration-300" />
              {% comment %} Rei dos Nitros: vídeos do YouTube + banner {% endcomment %}
              <span hidden data-rn-pnome="{{ product.name | escape }}"></span>
              {% include 'rn-midia' %}
            {% else %}
              <div class="w-full h-full flex flex-col items-center justify-center bg-neutral-950 text-neutral-500">
                <div class="relative">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-20 h-20 opacity-10"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-8 h-8 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                  </svg>
                </div>
                <span class="text-xs font-bold tracking-widest uppercase opacity-30 mt-2">Sem Imagem</span>
              </div>
            {% endif %}
          </div>

          <!-- Thumbnails -->
          {% if product.images.size > 1 %}
            <div class="grid grid-cols-4 gap-3">
              {% for image in product.images %}
                <button
                  style="aspect-ratio: 16 / 9;"
                  data-src="{{ image }}"
                  class="product-thumb {% if forloop.first %}active-thumb border-white{% else %}border-transparent{% endif %} rounded-lg overflow-hidden border-2 aspect-square bg-neutral-950 shadow-sm transition-all duration-300">
                  <img
                    src="{{ image }}"
                    class="w-full h-full object-cover"
                    alt="Imagem {{ forloop.index }}" />
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <div id="rn-pp-slot"></div>
        </div>

        <!-- Product Details (Rei dos Nitros) -->
        {% comment %} ---- CONFIGURAÇÃO DO PAINEL DE COMPRA ---- {% endcomment %}
        {% assign rn_cashback = 4 %}{% comment %} mesmo valor dos cards e da home {% endcomment %}
        {% comment %}
          Selo de avaliações. Se preencher o link do Trustpilot, mostra a nota abaixo.
          Se deixar vazio, mostra a nota do próprio produto (avaliações da Ereemby), quando houver.
        {% endcomment %}
        {% assign rn_trustpilot_url = '' %}
        {% assign rn_trustpilot_nota = '4,9' %}
        {% assign rn_trustpilot_texto = 'Excelente' %}
        {% comment %} ----------------------------------------- {% endcomment %}

        <div class="px-3 pb-3 sm:p-6 lg:p-8 flex flex-col rn-pp__buy">
          <div class="rn-buy">

            <!-- Título -->
            <div class="rn-buy__head">
              <h1 class="rn-buy__title">{{ product.name }}</h1>
              {% if product.type == 'variante' and product.variants.size > 0 %}
                <p data-liquid="title" class="rn-buy__sub">{{ _v0.name }}</p>
              {% endif %}
            </div>

            <!-- Estoque + Entrega -->
            {% if effective_type == 'texto' %}
              {% assign _stock_label = 'Disponível' %}
            {% elsif is_out_of_stock %}
              {% assign _stock_label = 'Esgotado' %}
            {% else %}
              {% assign _stock_label = display_stock | append: ' em estoque' %}
            {% endif %}
            <div class="rn-tiles">
              <div class="rn-tile">
                <span class="rn-tile__ico">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"></path><path d="m3 8 9 5 9-5M12 13v8"></path></svg>
                </span>
                <div class="min-w-0">
                  <div class="rn-tile__k">Estoque</div>
                  <div id="stock-display" class="rn-tile__v {% if is_out_of_stock %}text-red-400{% else %}text-green-400{% endif %}">{{ _stock_label }}</div>
                </div>
              </div>
              <div class="rn-tile">
                <span class="rn-tile__ico">
                  <svg id="delivery-icon" width="18" height="18" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true">
                    {% if effective_automatic %}
                      <path d="M213.85,125.46l-112,120a8,8,0,0,1-13.69-7l14.66-73.33L45.19,143.49a8,8,0,0,1-3-13l112-120a8,8,0,0,1,13.69,7L153.18,90.9l57.63,21.61a8,8,0,0,1,3,12.95Z"/>
                    {% else %}
                      <path d="M120,140a12,12,0,0,1-12-12V45l-7.51,7.51a12,12,0,0,1-17-17l28-28a12,12,0,0,1,17,0l28,28a12,12,0,1,1-17,17L132,45v83A12,12,0,0,1,120,140Zm76-18.48V96a20,20,0,0,0-20-20H164a12,12,0,0,0,0,24h8v68.3A32,32,0,0,0,128.29,212c.11.2.23.39.35.58l22.26,34A12,12,0,1,0,171,233.43l-22-33.66a8,8,0,0,1,14-7.77c.11.2.23.39.36.58L174,208.88a12,12,0,0,0,22-6.57V154a70.66,70.66,0,0,1,16,44.61V240a12,12,0,0,0,24,0V198.65A94.91,94.91,0,0,0,196,121.52ZM76,76H64A20,20,0,0,0,44,96V200a12,12,0,0,0,24,0V100h8a12,12,0,0,0,0-24Z"/>
                    {% endif %}
                  </svg>
                </span>
                <div class="min-w-0">
                  <div class="rn-tile__k">Entrega</div>
                  <div id="delivery-label" class="rn-tile__v">{% if effective_automatic %}Automática{% else %}Manual{% endif %}</div>
                </div>
              </div>
            </div>

            <!-- Avaliações -->
            {% assign _rv_total = product.feedback.stats.total | default: 0 %}
            {% if rn_trustpilot_url != '' %}
              <a class="rn-rating" href="{{ rn_trustpilot_url }}" target="_blank" rel="noopener">
                <span class="rn-rating__stars" aria-hidden="true">{% for i in (1..5) %}<span class="rn-rating__star rn-rating__star--tp"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg></span>{% endfor %}</span>
                <span class="rn-rating__t">{{ rn_trustpilot_texto }}, {{ rn_trustpilot_nota }} de 5</span>
                <span class="rn-rating__link">Veja nossas avaliações no Trustpilot ↗</span>
              </a>
            {% elsif options.feedback_status and _rv_total > 0 %}
              {% assign _rv_avg = product.feedback.stats.average | default: 0 %}
              {% assign _rv_floor = _rv_avg | round %}
              <button type="button" class="rn-rating" onclick="document.getElementById('tab-rev') && document.getElementById('tab-rev').click(); document.getElementById('product-tabs') && document.getElementById('product-tabs').scrollIntoView({behavior:'smooth'})">
                <span class="rn-rating__stars" aria-hidden="true">{% for i in (1..5) %}<span class="rn-rating__star{% if i > _rv_floor %} rn-rating__star--off{% endif %}"><svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg></span>{% endfor %}</span>
                <span class="rn-rating__t">{{ _rv_avg | round: 1 | replace: '.', ',' }} de 5</span>
                <span class="rn-rating__link">Veja as {{ _rv_total }} avaliações deste produto ↓</span>
              </button>
            {% endif %}

            <!-- Preço (Rei dos Nitros: preço + desconto + preço antigo na mesma linha e quanto economiza) -->
            <div class="rn-buy__price rn-buy__price--row">
              <div class="rn-buy__row">
                <div data-liquid="price" class="rn-buy__value">{{ display_price | priceFormatter }}</div>
                {% if display_discount_percentage and display_discount_percentage > 0 %}
                  <span id="discount-badge" class="rn-buy__off"><span id="discount-label">-{{ display_discount_percentage }}% OFF</span></span>
                {% else %}
                  <span id="discount-badge" class="rn-buy__off hidden"><span id="discount-label"></span></span>
                {% endif %}
                {% if display_comparison > display_price %}
                  <span data-liquid="original-price" class="rn-buy__strike">{{ display_comparison | priceFormatter }}</span>
                {% else %}
                  <span data-liquid="original-price" class="rn-buy__strike hidden"></span>
                {% endif %}
              </div>
              <p class="rn-buy__pix">À vista no Pix</p>
              <p class="rn-buy__save" id="rn-economia" hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9.5c-.6-1-1.7-1.5-3-1.5-1.7 0-3 .9-3 2.2 0 3 6 1.6 6 4.6 0 1.3-1.3 2.2-3 2.2-1.4 0-2.6-.6-3.1-1.6M12 6.5v1.5M12 16v1.5"/></svg><span>Você economiza <b id="rn-economia-v"></b></span></p>
              <script>
                (function () {
                  // "Você economiza": diferença entre o preço antigo e o atual (atualiza ao trocar de opção)
                  var box = document.getElementById('rn-economia'); if (!box) return;
                  var pr = document.querySelector('[data-liquid="price"]'), old = document.querySelector('[data-liquid="original-price"]');
                  function num(t) { var m = String(t || '').replace(/[^0-9,]/g, '').replace(',', '.'); return parseFloat(m) || 0; }
                  function atualizar() {
                    var p = num(pr && pr.textContent), o = old && !old.classList.contains('hidden') ? num(old.textContent) : 0;
                    var d = o - p;
                    box.hidden = !(d > 0.009);
                    if (d > 0) document.getElementById('rn-economia-v').textContent = d.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                  }
                  atualizar();
                  [pr, old].forEach(function (el) { if (el) new MutationObserver(atualizar).observe(el, { childList: true, characterData: true, subtree: true, attributes: true }); });
                })();
              </script>
            </div>

            <!-- Variações -->
            {% assign rn_pnome_free = product.name | downcase %}
            {% if rn_pnome_free contains 'jogos' and product.type == 'variante' %}
              {% include 'rn-gratis' %}
            {% endif %}
            {% if product.type == 'variante' and product.variants.size > 0 %}
              <div class="rn-opts">
                <div class="rn-opts__head">
                  <span class="rn-opts__t">Escolha sua opção</span>
                  <span class="rn-opts__s">Selecione a variação</span>
                </div>
                {% comment %}
                  Rei dos Nitros: grade com capas + busca só nos produtos de jogos (nome com "jogos", ex.: Jogos Steam).
                  Os demais produtos (Steam Key, Discord Nitro...) usam a lista normal.
                {% endcomment %}
                {% assign rn_pnome = product.name | downcase %}
                {% if rn_pnome contains 'jogos' and product.variants.size >= 6 %}
                  <label class="rn-vg__search">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input type="search" id="rn-vg-busca" placeholder="Buscar entre {{ product.variants.size }} opções…" autocomplete="off" aria-label="Buscar opção">
                  </label>
                  {% include 'rn-cat-jogos' %}
                  <div class="rn-vg__cats" id="rn-vg-cats" role="tablist" aria-label="Categorias" hidden></div>
                  <div id="variants-list" class="rn-vg">
                    {% for variant in product.variants %}
                      {% if variant.type == 'texto' %}
                        {% assign _v_out = false %}
                      {% elsif variant.stock_amount <= 0 %}
                        {% assign _v_out = true %}
                      {% else %}
                        {% assign _v_out = false %}
                      {% endif %}
                      {% assign _v_img = '' %}
                      {% if variant.images.size > 0 %}{% assign _v_img = variant.images[0] %}{% elsif variant.icon %}{% assign _v_img = variant.icon %}{% endif %}
                      {% assign _v_off = 0 %}
                      {% if variant.comparison > variant.price %}
                        {% assign _v_off = variant.comparison | minus: variant.price | times: 100 | divided_by: variant.comparison | round %}
                      {% endif %}
                      {% comment %} Relâmpago da Black Friday: os jogos que estão por R$ 10 {% endcomment %}
                      {% assign _v_rl = false %}
                      {% unless _v_out %}{% if variant.price > 0 and variant.price <= 10.5 %}{% assign _v_rl = true %}{% endif %}{% endunless %}
                      <button type="button" class="variant-btn rn-vg__card{% if forloop.first %} rn-opt--on{% endif %}{% if _v_out %} rn-vg__card--out{% endif %}{% if _v_rl %} rn-vg__card--rl{% endif %}" data-variant-index="{{ forloop.index0 }}" data-nome="{{ variant.name }}">
                        <span class="rn-vg__cover">
                          {% if _v_img != '' %}
                            <img src="{{ _v_img }}" alt="" loading="lazy">
                          {% else %}
                            <span class="rn-vg__ph"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/><rect x="2" y="6" width="20" height="12" rx="4"/></svg></span>
                          {% endif %}
                          {% if _v_off > 0 %}<span class="rn-vg__off">-{{ _v_off }}%</span>{% endif %}
                          {% if _v_rl %}<span class="rn-vg__rl"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.2 2.2 4.6 13a.8.8 0 0 0 .6 1.3h5.4l-1.4 7.1c-.1.8.9 1.2 1.4.6L19.4 11a.8.8 0 0 0-.6-1.3h-5.4l1.4-6.9c.1-.8-.9-1.2-1.6-.6Z"/></svg>Relâmpago</span>{% endif %}
                          {% if _v_out %}<span class="rn-vg__esg">Esgotado</span>{% endif %}
                          <span class="variant-check rn-vg__check{% if forloop.first %} border-white{% endif %}" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                        </span>
                        <span class="rn-vg__name">{{ variant.name }}</span>
                        <span class="rn-vg__price">{{ variant.price | priceFormatter }}{% if variant.comparison > variant.price %} <s>{{ variant.comparison | priceFormatter }}</s>{% endif %}</span>
                      </button>
                    {% endfor %}
                  </div>
                  <p class="rn-vg__vazio" id="rn-vg-vazio" hidden>Nenhuma opção encontrada.</p>
                  <button type="button" class="rn-vg__more" id="rn-vg-more" hidden>
                    <span id="rn-vg-more-t">Ver mais jogos</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </button>
                  <script>
                    (function () {
                      var LIMITE = 6;
                      var grade = document.getElementById('variants-list');
                      var inp = document.getElementById('rn-vg-busca');
                      var btn = document.getElementById('rn-vg-more');
                      if (!grade || !btn) return;
                      var cards = [].slice.call(grade.querySelectorAll('.rn-vg__card'));
                      // ordem: combos, depois os jogos do Relâmpago (R$ 10), depois o resto na ordem da loja
                      // (window.rnVgOrdenar é chamada de novo quando o Relâmpago troca com a página aberta)
                      function ordenar() {
                        function rank(c) { return /^\s*combo/i.test(c.getAttribute('data-nome') || '') ? 0 : c.classList.contains('rn-vg__card--rl') ? 1 : 2; }
                        cards = cards.slice().sort(function (a, b) { return rank(a) - rank(b) || (+a.getAttribute('data-variant-index')) - (+b.getAttribute('data-variant-index')); });
                        cards.forEach(function (c) { grade.appendChild(c); });
                        // o limite antes do "Ver mais jogos" sempre inclui os combos e os 3 do Relâmpago (número par, por causa das 2 colunas)
                        var topo = cards.filter(function (c) { return rank(c) < 2; }).length;
                        LIMITE = Math.max(6, topo + (topo % 2));
                      }
                      ordenar();
                      var aberto = false;
                      function norm(t) { return (t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
                      // Categorias (Ação, Aventura...): vêm de RN_CAT_JOGOS (componente rn-cat-jogos); a ordem dentro de cada uma é a da loja (mais jogados primeiro).
                      var CATS = [['todos', 'Todos'], ['combos', 'Combos'], ['acao', 'Ação'], ['aventura', 'Aventura'], ['corrida', 'Corrida'], ['rpg', 'RPG'], ['simulacao', 'Simulação'], ['terror', 'Terror']];
                      var MAPA = window.RN_CAT_JOGOS || {};
                      var cat = 'todos';
                      function catsDe(c) {
                        var n = String(c.getAttribute('data-nome') || '').trim().toLowerCase(), r = ['todos'];
                        if (n.indexOf('combo') === 0) r.push('combos');
                        if (MAPA[n]) r.push(MAPA[n]);
                        return r;
                      }
                      cards.forEach(function (c) { c._cats = catsDe(c); });
                      var boxCats = document.getElementById('rn-vg-cats');
                      if (boxCats && Object.keys(MAPA).length) {
                        CATS.forEach(function (k) {
                          var n = cards.filter(function (c) { return c._cats.indexOf(k[0]) !== -1; }).length;
                          if (!n) return;
                          var b = document.createElement('button');
                          b.type = 'button'; b.className = 'rn-vg__cat' + (k[0] === cat ? ' rn-vg__cat--on' : '');
                          b.setAttribute('role', 'tab'); b.setAttribute('aria-selected', k[0] === cat ? 'true' : 'false');
                          b.setAttribute('data-cat', k[0]);
                          b.innerHTML = k[1] + ' <span>' + n + '</span>';
                          boxCats.appendChild(b);
                        });
                        // Rei dos Nitros: "Franquias" abre uma segunda fileira com cada franquia/coleção (dados de RN_FRANQUIAS)
                        var bFr = document.createElement('button');
                        bFr.type = 'button'; bFr.className = 'rn-vg__cat rn-vg__cat--fr'; bFr.setAttribute('role', 'tab'); bFr.setAttribute('data-cat', 'franquias');
                        bFr.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="7" height="16" rx="1.5"/><rect x="14" y="4" width="7" height="16" rx="1.5"/></svg>Franquias';
                        boxCats.insertBefore(bFr, boxCats.children[1] || null);
                        var boxFr = document.createElement('div'); boxFr.className = 'rn-vg__frs'; boxFr.id = 'rn-vg-frs'; boxFr.hidden = true;
                        boxCats.insertAdjacentElement('afterend', boxFr);
                        function montarFr() {
                          var FR = window.RN_FRANQUIAS || []; if (!FR.length) return false;
                          var temNome = {}; cards.forEach(function (c) { temNome[String(c.getAttribute('data-nome') || '').trim().toLowerCase()] = c; c._fr = []; });
                          var html = '';
                          FR.forEach(function (f) {
                            var n = 0; (f.j || []).forEach(function (nome) { var c = temNome[String(nome).trim().toLowerCase()]; if (c) { c._fr.push(f.s); n++; } });
                            if (n) html += '<button type="button" class="rn-vg__fr" data-fr="' + f.s + '">' + f.n + ' <span>' + n + '</span></button>';
                          });
                          boxFr.innerHTML = html + '<a class="rn-vg__frall" href="/franquias">Ver todas as franquias →</a>';
                          return true;
                        }
                        boxCats.hidden = false;
                        boxCats.addEventListener('click', function (e) {
                          var b = e.target.closest('.rn-vg__cat'); if (!b) return;
                          cat = b.getAttribute('data-cat'); aberto = false;
                          [].forEach.call(boxCats.children, function (x) { var on = x === b; x.classList.toggle('rn-vg__cat--on', on); x.setAttribute('aria-selected', on ? 'true' : 'false'); });
                          boxFr.hidden = cat !== 'franquias';
                          if (cat === 'franquias' && !boxFr.children.length) {
                            boxFr.innerHTML = '<span class="rn-vg__frload">Carregando franquias…</span>';
                            var pronto = function () { montarFr(); aplicar(); };
                            if (window.RN_FRANQUIAS) pronto(); else if (window.rnJogos) window.rnJogos(pronto);
                          }
                          [].forEach.call(boxFr.querySelectorAll('.rn-vg__fr'), function (x) { x.classList.remove('rn-vg__fr--on'); });
                          aplicar();
                        });
                        boxFr.addEventListener('click', function (e) {
                          var b = e.target.closest('.rn-vg__fr'); if (!b) return;
                          var ja = b.classList.contains('rn-vg__fr--on');
                          [].forEach.call(boxFr.querySelectorAll('.rn-vg__fr'), function (x) { x.classList.toggle('rn-vg__fr--on', x === b && !ja); });
                          cat = ja ? 'franquias' : 'fr:' + b.getAttribute('data-fr'); aberto = true; aplicar();
                        });
                      }
                      function aplicar() {
                        var q = inp ? norm(inp.value.trim()) : '';
                        var vis = 0, total = 0;
                        cards.forEach(function (c) {
                          var naCat = cat === 'franquias' ? !!(c._fr && c._fr.length) : cat.indexOf('fr:') === 0 ? !!(c._fr && c._fr.indexOf(cat.slice(3)) !== -1) : c._cats.indexOf(cat) !== -1;
                          var combina = (!q || norm(c.getAttribute('data-nome')).indexOf(q) !== -1) && (q || naCat);
                          var escondidoPeloLimite = combina && !q && !aberto && total >= LIMITE && !c.classList.contains('rn-opt--on');
                          if (combina) total++;
                          c.style.display = combina && !escondidoPeloLimite ? '' : 'none';
                          if (combina) vis++;
                        });
                        document.getElementById('rn-vg-vazio').hidden = vis > 0;
                        var resto = total - LIMITE;
                        btn.hidden = !!q || resto <= 0;
                        grade.classList.toggle('rn-vg--fechado', !q && !aberto && resto > 0);
                        btn.classList.toggle('rn-vg__more--aberto', aberto);
                        document.getElementById('rn-vg-more-t').textContent = aberto ? 'Ver menos' : 'Ver mais jogos (+' + resto + ')';
                      }
                      btn.addEventListener('click', function () {
                        aberto = !aberto; aplicar();
                        if (!aberto) grade.scrollIntoView({ behavior: 'smooth', block: 'start' });
                      });
                      if (inp) inp.addEventListener('input', aplicar);
                      // mantém visível o jogo escolhido quando a seleção muda
                      new MutationObserver(function () { if (!aberto) aplicar(); }).observe(grade, { attributes: true, subtree: true, attributeFilter: ['class'] });
                      aplicar();
                      window.rnVgOrdenar = function () { if (document.body.contains(grade)) { ordenar(); aplicar(); } };
                    })();
                  </script>
                {% else %}
                <div id="variants-list" class="rn-opts__list">
                  {% for variant in product.variants %}
                    {% if variant.type == 'texto' %}
                      {% assign _v_out = false %}
                    {% elsif variant.stock_amount <= 0 %}
                      {% assign _v_out = true %}
                    {% else %}
                      {% assign _v_out = false %}
                    {% endif %}
                    <button type="button" class="variant-btn rn-opt{% if forloop.first %} rn-opt--on{% endif %}{% if _v_out %} rn-opt--out{% endif %}" data-variant-index="{{ forloop.index0 }}">
                      <span class="variant-check rn-opt__radio{% if forloop.first %} border-white{% endif %}"></span>
                      <span class="rn-opt__body">
                        <span class="rn-opt__name">{{ variant.name }}</span>
                        {% if variant.type == 'texto' %}
                          <span class="rn-opt__stock">Disponível</span>
                        {% elsif _v_out %}
                          <span class="rn-opt__stock rn-opt__stock--out">Esgotado</span>
                        {% else %}
                          <span class="rn-opt__stock">{{ variant.stock_amount }} em estoque</span>
                        {% endif %}
                        <span class="rn-opt__price">
                          {{ variant.price | priceFormatter }}
                          {% if variant.comparison > variant.price %}<s>{{ variant.comparison | priceFormatter }}</s>{% endif %}
                        </span>
                      </span>
                    </button>
                  {% endfor %}
                </div>
                {% endif %}
              </div>
            {% endif %}

            <!-- Quantidade -->
            <div id="qty-section" class="rn-qty{% if is_out_of_stock %} hidden{% endif %}">
              <span class="rn-qty__t">Quantidade</span>
              <div class="rn-qty__box">
                <button id="btn-decrease" type="button" aria-label="Diminuir">−</button>
                <input id="qty-input" type="text" inputmode="numeric" aria-label="Quantidade" value="{% if display_qty_min > 1 %}{{ display_qty_min }}{% else %}1{% endif %}">
                <button id="btn-increase" type="button" aria-label="Aumentar">+</button>
              </div>
              {% if display_qty_max > 0 %}
                <span id="qty-max-label" class="rn-qty__max">Máx. {{ display_qty_max }} por pedido</span>
              {% else %}
                <span id="qty-max-label" class="rn-qty__max hidden"></span>
              {% endif %}
            </div>

            <!-- Cashback -->
            {% if rn_cashback > 0 %}
              <div class="rn-acc">
                <details class="rn-acc__item">
                  <summary class="rn-acc__sum">
                    <span class="rn-acc__ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path></svg></span>
                    <span class="rn-acc__t">Ganhe {{ rn_cashback }}% de cashback</span>
                    <span class="rn-acc__more">Detalhes <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span>
                  </summary>
                  <div class="rn-acc__body">
                    Depois que o pagamento é aprovado, {{ rn_cashback }}% do valor da compra volta para você como saldo na loja. Use o saldo para pagar parte da sua próxima compra.
                  </div>
                </details>
              </div>
            {% endif %}

            <!-- Botões -->
            <div class="rn-actions">
              {% unless is_out_of_stock %}
                <button id="btn-buy-now" type="button" class="rn-btn rn-btn--buy">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 11-1 9M19 11l-4-7M2 11h20M3.5 11l1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4M4.5 15.5h15M5 11l4-7M9 11l1 9"></path></svg>
                  <span id="btn-buy-label">Comprar agora</span>
                </button>
                <button id="btn-add-cart" type="button" class="rn-btn rn-btn--cart">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                  <span id="btn-cart-label">Adicionar ao carrinho</span>
                </button>
              {% else %}
                <button id="btn-buy-now" type="button" disabled class="rn-btn rn-btn--buy rn-btn--off">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 11-1 9M19 11l-4-7M2 11h20M3.5 11l1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4M4.5 15.5h15M5 11l4-7M9 11l1 9"></path></svg>
                  <span id="btn-buy-label">Produto esgotado</span>
                </button>
                <button id="btn-add-cart" type="button" disabled class="rn-btn rn-btn--cart rn-btn--off">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                  <span id="btn-cart-label">Indisponível</span>
                </button>
              {% endunless %}
            </div>

            <a class="rn-gift-link" id="rn-gift-link" href="/presente">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
              Presentear um amigo
            </a>

            <!-- Garantias -->
            <ul class="rn-trust">
              <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><path d="M14 14h3v3h-3zM20 14v.01M20 20v.01M14 20h3"></path></svg><span><b>Pix</b> com aprovação rápida</span></li>
              <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"></path><path d="m3 8 9 5 9-5M12 13v8"></path></svg><span><b>Entrega</b> na página do seu pedido</span></li>
