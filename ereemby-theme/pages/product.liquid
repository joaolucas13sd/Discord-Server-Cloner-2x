    {% include 'rn-buybar' %}
    {% comment %} Rei dos Nitros: vestiário das contas Fortnite (só age se a descrição tiver a grade de skins) {% endcomment %}
    {% include 'rn-vestiario' %}
    <script>
      (function () {
        // Rei dos Nitros (computador): "Sobre este produto" vai para a coluna da esquerda, embaixo das imagens
        var mq = window.matchMedia('(min-width: 860px)');
        function posicionar() {
          var det = document.querySelector('.rn-det'), slot = document.getElementById('rn-pp-slot');
          if (!det || !slot) return;
          if (!det.__casa) { det.__casa = document.createComment('rn-det'); det.parentNode.insertBefore(det.__casa, det); }
          if (mq.matches) { if (det.parentNode !== slot) slot.appendChild(det); }
          else if (det.__casa.parentNode && det.previousSibling !== det.__casa) det.__casa.parentNode.insertBefore(det, det.__casa.nextSibling);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', posicionar); else setTimeout(posicionar, 0);
        (mq.addEventListener ? mq.addEventListener('change', posicionar) : mq.addListener(posicionar));
        // descrição longa: mostra o começo e o botão "Ver descrição completa"
        function recolher() {
          var d = document.querySelector('#tab-content-desc [data-liquid="description"]'); if (!d) return;
          var btn = document.getElementById('rn-desc-more');
          if (!btn) { btn = document.createElement('button'); btn.type = 'button'; btn.id = 'rn-desc-more'; btn.className = 'rn-desc-more'; d.insertAdjacentElement('afterend', btn); btn.addEventListener('click', function () { d.classList.toggle('rn-desc--open'); recolher(); }); }
          var longa = d.scrollHeight > 340;
          d.classList.toggle('rn-desc--fold', longa && !d.classList.contains('rn-desc--open'));
          btn.hidden = !longa;
          btn.innerHTML = (d.classList.contains('rn-desc--open') ? 'Mostrar menos' : 'Ver descrição completa') + ' <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="transform:rotate(' + (d.classList.contains('rn-desc--open') ? 180 : 0) + 'deg)"><path d="m6 9 6 6 6-6"/></svg>';
        }
        window.addEventListener('load', recolher); setTimeout(recolher, 400);
        var dsc = document.querySelector('#tab-content-desc [data-liquid="description"]');
        // só fecha quando a descrição troca de verdade (outra opção); efeitos de toque (onda) e animações não contam
        function soEfeito(ms) { return ms.every(function (m) { if (m.target && m.target.closest && m.target.closest('[data-rv]')) return true; var ns = [].slice.call(m.addedNodes).concat([].slice.call(m.removedNodes)); return m.type === 'childList' && ns.length && ns.every(function (n) { return n.nodeType === 1 && (n.classList.contains('rn-fx-box') || n.classList.contains('rn-fx-wave')); }); }); }
        if (dsc) new MutationObserver(function (ms) { if (soEfeito(ms)) return; dsc.classList.remove('rn-desc--open'); setTimeout(recolher, 50); }).observe(dsc, { childList: true, characterData: true, subtree: true });
      })();
    </script>

    <!-- Tabs: Description / Specs / Reviews (Rei dos Nitros: cabeçalho "Sobre este produto") -->
    <div class="mt-6 sm:mt-8 bg-neutral-950 rounded-2xl shadow-xl shadow-black/40 border border-neutral-800 rn-det">
      <div class="rn-det__head">
        <span class="rn-det__ico" id="rn-det-ico" aria-hidden="true">
          <svg class="rn-det__i-desc" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="m10 7.5 4.5 2.5-4.5 2.5z"/></svg>
          <svg class="rn-det__i-rev" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
        </span>
        <div class="min-w-0">
          <div class="rn-det__k" id="rn-det-k">DETALHES DO PRODUTO</div>
          <h2 class="rn-det__t" id="rn-det-t">Sobre este produto</h2>
        </div>
      </div>
      {% if options.feedback_status %}
        <nav class="rn-det__tabs" id="product-tabs">
          <button id="tab-desc" class="product-tab active-tab rn-det__tab border-white text-white">Descrição</button>
          <button id="tab-rev" class="product-tab rn-det__tab border-transparent text-neutral-500">Avaliações ({{ product.feedback.stats.total }})</button>
        </nav>
      {% else %}
        <nav class="hidden" id="product-tabs"><button id="tab-desc" class="product-tab active-tab border-white text-white">Descrição</button></nav>
      {% endif %}
      <script>
        (function () {
          var box = document.querySelector('.rn-det');
          function rot(rev) {
            box.classList.toggle('rn-det--rev', rev);
            document.getElementById('rn-det-k').textContent = rev ? 'AVALIAÇÕES' : 'DETALHES DO PRODUTO';
            document.getElementById('rn-det-t').textContent = rev ? 'O que dizem os clientes' : 'Sobre este produto';
          }
          document.addEventListener('click', function (e) {
            if (e.target.closest('#tab-rev')) setTimeout(function () { rot(true); }, 0);
            else if (e.target.closest('#tab-desc')) setTimeout(function () { rot(false); }, 0);
          });
        })();
      </script>

      <div class="p-4 sm:p-6 lg:p-8">
        <!-- Description Tab -->
        <div id="tab-content-desc">
          <div data-liquid="description" class="reset-content-css">{{ product.description }}</div>

          <!-- Embedded Video -->
          <div id="embed-video-wrapper" class="mt-6{% if embed_src == '' %} hidden{% endif %}">
            <div class="relative w-full max-w-xl overflow-hidden rounded-xl border border-neutral-800 bg-black" style="aspect-ratio: 16 / 9;">
              <iframe
                id="embed-video-frame"
                src="{{ embed_src }}"
                title="Vídeo do produto"
                class="absolute inset-0 w-full h-full"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
                loading="lazy"
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Reviews Tab -->
        {% if options.feedback_status %}
          <div id="tab-content-rev" class="hidden">
            {% render 'feedback', product: product %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="max-w-7xl mx-auto flex flex-col gap-10 mt-10">

      {% assign current_category_id = product.category_id %}
      {% assign current_product_name = product.name %}

      {% for category in catalog.categories %}

        {% if category.id == current_category_id %}
          {% assign related_count = 0 %}
          {% for item in category.products %}
            {% if item.id != product.id %}
              {% assign related_count = related_count | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% if related_count > 0 %}
            <div>
              <div class="rn-rel-head">
                <div class="min-w-0">
                  <div class="rn-rel-kicker">CONTINUE EXPLORANDO</div>
                  <h2 class="rn-rel-title">Você também pode gostar</h2>
                </div>
                <div class="rn-rel-nav">
                  <button type="button" class="rn-rel-btn" id="rn-rel-prev" aria-label="Anteriores">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                  </button>
                  <button type="button" class="rn-rel-btn" id="rn-rel-next" aria-label="Próximos">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                  </button>
                </div>
              </div>

              <!-- Slider de produtos da mesma categoria -->
              <div class="related-products-nav-wrapper">
                <div class="swiper related-products-swiper !pb-12">
                  <div class="swiper-wrapper">
                    {% for item in category.products %}
                      {% if item.id != product.id %}
                        <div class="swiper-slide !h-auto">
                          {% render 'product-card', product: item %}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {% endif %}

          <script>
            (function () {
              var tries = 0;
              (function ligar() {
                var el = document.querySelector('.related-products-swiper');
                var prev = document.getElementById('rn-rel-prev');
                var next = document.getElementById('rn-rel-next');
                if (!el || !prev || !next) return;
                var sw = el.swiper;
                if (!sw) { if (tries++ < 100) setTimeout(ligar, 100); return; }
                function estado() {
                  prev.disabled = sw.isBeginning;
                  next.disabled = sw.isEnd;
                  var nada = sw.isBeginning && sw.isEnd;
                  prev.parentNode.style.display = nada ? 'none' : '';
                }
                prev.onclick = function () { sw.slidePrev(); };
                next.onclick = function () { sw.slideNext(); };
                sw.on('slideChange', estado); sw.on('reachEnd', estado); sw.on('reachBeginning', estado); sw.on('resize', estado);
                estado();
              })();
            })();
          </script>

          {% break %}
        {% endif %}

      {% endfor %}

    </div>

  </div>

  <!-- ===================== SHARE SHEET / MODAL ===================== -->
  <style>
    @keyframes shareBackdropIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes shareSheetUp {
      from { transform: translateY(100%); }
      to   { transform: translateY(0); }
    }
    @keyframes shareModalIn {
      from { opacity: 0; transform: translateY(10px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    #share-backdrop.open { animation: shareBackdropIn .25s ease-out forwards; }
    #share-panel.open    { animation: shareSheetUp .35s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    @media (min-width: 640px) {
      #share-panel.open  { animation: shareModalIn .25s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
