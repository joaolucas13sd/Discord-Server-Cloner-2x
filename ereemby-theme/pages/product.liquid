  </div>

  <script>
    (function initShare() {
      var btn = document.getElementById('btn-share');
      var root = document.getElementById('share-root');
      var backdrop = document.getElementById('share-backdrop');
      var panel = document.getElementById('share-panel');
      var closeBtn = document.getElementById('share-close');
      var copyBtn = document.getElementById('share-copy');
      var copyLabel = document.getElementById('share-copy-label');
      var urlInput = document.getElementById('share-url-input');
      if (!btn || !root) return;

      var productTitle = (window.PRODUCT_DATA && window.PRODUCT_DATA.title) || document.title || '';
      var productImage = (window.PRODUCT_DATA && window.PRODUCT_DATA.images && window.PRODUCT_DATA.images[0]) || '';
      var shareText = productTitle ? ('Confira: ' + productTitle) : 'Confira este produto';

      function getUrl() { return window.location.href; }

      function openSheet() {
        var url = getUrl();
        if (urlInput) urlInput.value = url;
        root.classList.remove('hidden');
        // Force reflow then animate
        requestAnimationFrame(function () {
          backdrop.classList.add('open');
          panel.classList.add('open');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeSheet() {
        backdrop.classList.remove('open');
        panel.classList.remove('open');
        document.body.style.overflow = '';
        setTimeout(function () { root.classList.add('hidden'); }, 250);
      }

      function tryNativeShare() {
        if (navigator.share) {
          navigator.share({ title: productTitle, text: shareText, url: getUrl() })
            .catch(function () { openSheet(); });
          return true;
        }
        return false;
      }

      btn.addEventListener('click', function () {
        if (!tryNativeShare()) openSheet();
      });

      closeBtn.addEventListener('click', closeSheet);
      backdrop.addEventListener('click', closeSheet);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !root.classList.contains('hidden')) closeSheet();
      });

      var targets = {
        whatsapp:  function (u, t) { return 'https://wa.me/?text=' + encodeURIComponent(t + ' ' + u); },
        telegram:  function (u, t) { return 'https://t.me/share/url?url=' + encodeURIComponent(u) + '&text=' + encodeURIComponent(t); },
        x:         function (u, t) { return 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(t) + '&url=' + encodeURIComponent(u); },
        facebook:  function (u)    { return 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(u); },
        linkedin:  function (u)    { return 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(u); },
        pinterest: function (u, t, img) { return 'https://pinterest.com/pin/create/button/?url=' + encodeURIComponent(u) + '&description=' + encodeURIComponent(t) + (img ? '&media=' + encodeURIComponent(img) : ''); },
        reddit:    function (u, t) { return 'https://reddit.com/submit?url=' + encodeURIComponent(u) + '&title=' + encodeURIComponent(t); },
        email:     function (u, t) { return 'mailto:?subject=' + encodeURIComponent(t) + '&body=' + encodeURIComponent(t + '\n\n' + u); },
      };

      document.querySelectorAll('.share-option').forEach(function (opt) {
        opt.addEventListener('click', function () {
          var key = opt.getAttribute('data-share');
          var fn = targets[key];
          if (!fn) return;
          var href = fn(getUrl(), shareText, productImage);
          if (key === 'email') {
            window.location.href = href;
          } else {
            window.open(href, '_blank', 'noopener,noreferrer');
          }
          setTimeout(closeSheet, 150);
        });
      });

      function copyToClipboard(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
          try {
            urlInput.removeAttribute('readonly');
            urlInput.select();
            urlInput.setSelectionRange(0, 99999);
            document.execCommand('copy');
            urlInput.setAttribute('readonly', '');
            urlInput.blur();
            resolve();
          } catch (err) { reject(err); }
        });
      }

      copyBtn.addEventListener('click', function () {
        copyToClipboard(getUrl()).then(function () {
          var prev = copyLabel.textContent;
          copyLabel.textContent = 'Copiado!';
          copyBtn.classList.add('!bg-green-500', 'hover:!bg-green-500');
          setTimeout(function () {
            copyLabel.textContent = prev;
            copyBtn.classList.remove('!bg-green-500', 'hover:!bg-green-500');
          }, 1500);
        }).catch(function () {
          copyLabel.textContent = 'Erro';
          setTimeout(function () { copyLabel.textContent = 'Copiar'; }, 1500);
        });
      });
    })();
  </script>

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 hidden">
    <div class="flex items-center gap-3 bg-neutral-900 border border-neutral-700 text-neutral-100 px-5 py-3.5 rounded-xl shadow-2xl shadow-black/60 text-sm font-medium">
      <svg
        class="w-5 h-5 text-white flex-shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 13l4 4L19 7" />
        </svg>
      <span id="toast-message">Produto adicionado ao carrinho!</span>
    </div>
  </div>

</div>