{% comment %}
  Rei dos Nitros: página "Novidades" (endereço /novidades, definido em routes/routes.json).
  As atualizações e os mini tutoriais animados ficam em assets/rn-novidades.js (RN_NOVIDADES e CENAS).
  Ao publicar uma atualização nova: acrescente o item no topo de RN_NOVIDADES (com uma demo em CENAS) e troque rn_nv_ultimo em components/rn-catnav.liquid.
{% endcomment %}
<style>
  .nv-pg { max-width: 760px; }
  .nv-dia { position: relative; margin: 0 0 8px; padding-left: 22px; }
  .nv-dia::before { content: ""; position: absolute; left: 6px; top: 12px; bottom: 0; width: 2px; background: linear-gradient(#1f5a37, transparent); }
  .nv-diat { position: relative; display: flex; align-items: center; gap: 10px; margin: 18px 0 12px -22px; font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #a1a2a8; }
  .nv-diat span { width: 14px; height: 14px; border-radius: 50%; background: #22f26a; box-shadow: 0 0 0 4px rgba(34,242,106,.18); }
  .nv-item { margin: 0 0 14px; padding: 18px 16px; border: 1px solid #23242a; border-radius: 20px; background: #0d0e11; scroll-margin-top: 90px; }
  .nv-head { display: flex; flex-wrap: wrap; gap: 6px; }
  .nv-tag { padding: 4px 9px; border-radius: 8px; background: rgba(34,242,106,.12); color: #22f26a; font-size: 11.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .nv-tag--melhoria { background: rgba(56,189,248,.12); color: #38bdf8; }
  .nv-tag--correção { background: rgba(248,113,113,.12); color: #f87171; }
  .nv-tag--black-friday, .nv-tag--promoção { background: rgba(250,204,21,.12); color: #facc15; }
  .nv-novo { padding: 4px 9px; border-radius: 8px; background: #22f26a; color: #04140a; font-size: 11px; font-weight: 800; letter-spacing: .06em; animation: rnBfhPulse 1.6s ease-out infinite; }
  .nv-t { margin: 10px 0 4px; font-family: var(--rn-font-round, inherit); font-size: 22px; font-weight: 800; color: #fff; }
  .nv-resumo { margin: 0; color: #c4c5ca; font-size: 15px; line-height: 1.55; }
  .nv-ul { margin: 10px 0 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .nv-ul li { position: relative; padding-left: 20px; color: #a1a2a8; font-size: 14px; line-height: 1.5; }
  .nv-ul li::before { content: ""; position: absolute; left: 3px; top: 8px; width: 8px; height: 8px; border-radius: 3px; background: #22f26a; }
  .nv-ir { display: inline-flex; margin-top: 12px; padding: 10px 14px; border-radius: 12px; background: #22f26a; color: #04140a !important; font-weight: 800; font-size: 14px; text-decoration: none !important; }

  /* janela da loja */
  .nv-demo { margin-top: 14px; }
  .nv-janela { position: relative; border: 1px solid #2c2d33; border-radius: 16px; overflow: hidden; background: #000; box-shadow: 0 14px 40px rgba(0,0,0,.45); }
  .nv-barra { display: flex; align-items: center; gap: 6px; padding: 8px 10px; background: #18191c; border-bottom: 1px solid #26272c; }
  .nv-barra > i { width: 9px; height: 9px; border-radius: 50%; background: #ff5f57; }
  .nv-barra > i:nth-child(2) { background: #febc2e; } .nv-barra > i:nth-child(3) { background: #28c840; }
  .nv-url { flex: 1; min-width: 0; margin-left: 6px; padding: 4px 10px; border-radius: 8px; background: #0b0c0e; color: #8d8e93; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nv-tela { position: relative; height: 330px; padding: 0 12px 12px; overflow: hidden; color: #e8e9ec; font-size: 12px; user-select: none; pointer-events: none; }
  .nv-mouse { position: absolute; left: 0; top: 34px; z-index: 30; width: 22px; height: 22px; transition: transform .85s cubic-bezier(.45,.05,.25,1); pointer-events: none; filter: drop-shadow(0 2px 3px rgba(0,0,0,.6)); }
  .nv-mouse svg { width: 100%; height: 100%; display: block; }
  .nv-mouse::after { content: ""; position: absolute; left: -9px; top: -9px; width: 22px; height: 22px; border-radius: 50%; border: 2px solid #22f26a; opacity: 0; }
  .nv-mouse.nv-clique svg { animation: nvClique .25s ease; }
  .nv-mouse.nv-clique::after { animation: nvOnda .5s ease-out; }
  @keyframes nvClique { 50% { transform: scale(.82); } }
  @keyframes nvOnda { from { opacity: 1; transform: scale(.3); } to { opacity: 0; transform: scale(1.8); } }
  .nv-pe { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
  .nv-leg { flex: 1; min-height: 38px; margin: 0; display: flex; align-items: center; gap: 8px; color: #fff; font-size: 14px; font-weight: 700; line-height: 1.35; }
  .nv-leg[data-n]::before { content: attr(data-n); flex: none; padding: 3px 7px; border-radius: 7px; background: #22f26a; color: #04140a; font-size: 11px; font-weight: 800; }
  .nv-leg.nv-legon { animation: nvLeg .35s ease; }
  @keyframes nvLeg { from { opacity: 0; transform: translateY(4px); } }
  .nv-rep { flex: none; padding: 8px 12px; border: 1px solid #2c2d33; border-radius: 10px; background: #141519; color: #c4c5ca; font: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer; }

  /* loja em miniatura */
  .nv-top { display: flex; align-items: center; gap: 8px; margin: 0 -12px 10px; padding: 9px 12px; border-bottom: 1px solid #1d1e22; background: #0b0c0e; }
  .nv-top b { flex: 1; font-family: var(--rn-font-round, inherit); font-size: 13px; }
  .nv-lupa, .nv-carr { position: relative; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: #18191c; }
  .nv-carr { background: #22f26a; color: #04140a; }
  .nv-lupa svg, .nv-carr svg { width: 14px; height: 14px; }
  .nv-badge { position: absolute; right: -5px; top: -5px; min-width: 15px; height: 15px; padding: 0 3px; border-radius: 8px; background: #fff; color: #04140a; font-size: 9.5px; font-weight: 800; font-style: normal; line-height: 15px; text-align: center; }
  .nv-badge[hidden] { display: none; }
  .nv-pop { animation: nvPop .35s cubic-bezier(.2,1.6,.4,1); }
  @keyframes nvPop { from { transform: scale(0); } }
  .nv-h { margin: 2px 0 8px; font-family: var(--rn-font-round, inherit); font-size: 15px; font-weight: 800; color: #fff; }
  .nv-k { display: block; color: #22f26a; font-size: 9.5px; font-weight: 800; letter-spacing: .12em; }
  .nv-am { color: #ffc400; }
  .nv-cv { position: relative; display: flex; align-items: flex-end; aspect-ratio: 2 / 3; border-radius: 8px; overflow: hidden; background: linear-gradient(160deg, var(--a), var(--b)); }
  .nv-cv i { padding: 5px; font-style: normal; font-size: 9.5px; font-weight: 800; line-height: 1.15; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.7); }
  .nv-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .nv-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
  .nv-gc .nv-cv { aspect-ratio: 16 / 9; }
  .nv-chip { display: inline-block; margin: 0 4px 4px 0; padding: 4px 9px; border: 1px solid #2c2d33; border-radius: 999px; background: #141519; color: #c4c5ca; font-size: 10.5px; font-weight: 700; }
  .nv-chip.nv-on, .nv-tab.nv-on { border-color: #22f26a; background: #22f26a; color: #04140a; }
  .nv-add { display: flex; align-items: center; justify-content: center; gap: 5px; margin-top: 6px; padding: 6px; border: 1px solid #1f5a37; border-radius: 8px; background: rgba(34,242,106,.1); color: #22f26a; font-size: 10.5px; font-weight: 700; }
  .nv-add svg { width: 12px; height: 12px; }
  .nv-add.nv-in, .nv-btn.nv-in, .nv-copy.nv-in, .nv-cbtn.nv-in, .nv-pl2.nv-in { background: #22f26a; border-color: #22f26a; color: #04140a; }
  .nv-btn { display: inline-block; margin-top: 6px; padding: 6px 10px; border-radius: 8px; background: #22f26a; color: #04140a; font-size: 10.5px; font-weight: 800; }
  .nv-cta { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; margin-top: 10px; padding: 10px; border: 0; border-radius: 10px; background: #22f26a; color: #04140a; font: inherit; font-size: 12px; font-weight: 800; }
  .nv-cta svg { width: 14px; height: 14px; }
  .nv-cta.nv-in { opacity: .7; }
  .nv-toast { position: absolute; left: 50%; bottom: 12px; z-index: 25; padding: 7px 12px; border-radius: 10px; background: #fff; color: #04140a; font-size: 11px; font-weight: 800; white-space: nowrap; transform: translate(-50%, 30px); opacity: 0; transition: .3s; }
  .nv-toast--on { transform: translate(-50%, 0); opacity: 1; }
  .nv-logo { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(150deg, var(--a), var(--b)); color: #fff; font-weight: 800; font-size: 12px; flex: none; }
  .nv-lg { width: 64px; height: 64px; border-radius: 14px; font-size: 26px; }
  .nv-prod { display: flex; gap: 12px; align-items: center; margin-top: 6px; }
  .nv-tags { display: flex; flex-wrap: wrap; gap: 4px; margin: 4px 0; }
  .nv-tags i { padding: 2px 6px; border-radius: 6px; background: #18191e; color: #c4c5ca; font-style: normal; font-size: 10px; font-weight: 700; }
  .nv-tags .nv-nota { color: #facc15; }
  /* gaveta do carrinho */
  .nv-drawer { position: absolute; top: 0; right: 0; bottom: 0; z-index: 20; width: 78%; padding: 12px; border-left: 1px solid #26272c; background: #0d0e11; transform: translateX(105%); transition: transform .45s cubic-bezier(.2,.8,.2,1); box-shadow: -10px 0 30px rgba(0,0,0,.5); }
  .nv-drawer.nv-on { transform: none; }
  .nv-dh { margin-bottom: 8px; font-family: var(--rn-font-round, inherit); font-size: 14px; font-weight: 800; }
  .nv-li { display: flex; justify-content: space-between; gap: 6px; padding: 7px 0; border-bottom: 1px solid #1d1e22; font-size: 11px; }
  .nv-li i { margin-left: 4px; padding: 1px 5px; border-radius: 5px; background: #22f26a; color: #04140a; font-style: normal; font-size: 9px; font-weight: 800; }
  .nv-gr b { color: #22f26a; }
  .nv-cup { margin-top: 8px; padding: 7px; border: 1.5px dashed #22f26a; border-radius: 8px; font-size: 11px; text-align: center; }
  .nv-tot { margin-top: 8px; font-size: 12px; } .nv-tot b { color: #22f26a; }
  /* sortear */
  .nv-sj { display: flex; align-items: center; gap: 8px; width: 100%; margin-bottom: 8px; padding: 8px 10px; border: 1px solid #1f5a37; border-radius: 10px; background: rgba(34,242,106,.1); color: #22f26a; font: inherit; text-align: left; }
  .nv-sj > svg { width: 20px; height: 20px; flex: none; }
  .nv-sj span { display: flex; flex-direction: column; } .nv-sj b { color: #fff; font-size: 12px; } .nv-sj small { color: #a1a2a8; font-size: 10px; }
  .nv-modal { position: absolute; inset: 0; z-index: 15; display: grid; place-items: center; padding: 12px; background: rgba(0,0,0,.7); opacity: 0; visibility: hidden; transition: .25s; }
  .nv-modal.nv-on { opacity: 1; visibility: visible; }
  .nv-mbox { width: 100%; padding: 12px; border: 1px solid #2c2d33; border-radius: 14px; background: #0d0e11; transform: scale(.9); transition: transform .3s cubic-bezier(.2,1.4,.4,1); }
  .nv-modal.nv-on .nv-mbox { transform: none; }
  .nv-palco { display: grid; grid-template-columns: 82px 1fr; gap: 10px; margin-top: 6px; }
  .nv-big .nv-cv.nv-win { box-shadow: 0 0 0 3px #22f26a; animation: nvPop .4s cubic-bezier(.2,1.6,.4,1); }
  .nv-info { display: flex; flex-direction: column; gap: 3px; }
  .nv-n { font-size: 13px; }
  .nv-go { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; margin-top: 10px; padding: 9px; border: 0; border-radius: 10px; background: #22f26a; color: #04140a; font: inherit; font-size: 12px; font-weight: 800; }
  .nv-go svg { width: 15px; height: 15px; }
  /* teste de streaming */
  .nv-pass { position: absolute; left: 12px; right: 12px; top: 54px; transition: opacity .3s, transform .3s; }
  .nv-p2, .nv-p3 { opacity: 0; transform: translateX(30px); visibility: hidden; }
  .nv-pass.nv-out { opacity: 0; transform: translateX(-30px); visibility: hidden; }
  .nv-pass.nv-show { opacity: 1; transform: none; visibility: visible; }
  .nv-op { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; padding: 8px 10px; border: 1px solid #26272c; border-radius: 10px; background: #0f1012; }
  .nv-op span { display: flex; flex-direction: column; } .nv-op b { font-size: 11.5px; } .nv-op small { color: #8d8e93; font-size: 10px; }
  .nv-chk { display: grid; place-items: center; width: 16px; height: 16px; border: 2px solid #3a3b42; border-radius: 5px; color: transparent; flex: none; }
  .nv-chk svg { width: 10px; height: 10px; }
  .nv-op.nv-on { border-color: #22f26a; background: rgba(34,242,106,.08); }
  .nv-op.nv-on .nv-chk { border-color: #22f26a; background: #22f26a; color: #04140a; }
  .nv-next { width: 100%; margin-top: 4px; padding: 9px; border: 0; border-radius: 10px; background: #22f26a; color: #04140a; font: inherit; font-size: 12px; font-weight: 800; }
  .nv-next:disabled { opacity: .4; }
  .nv-res { display: flex; gap: 10px; margin-top: 8px; padding: 12px; border: 1px solid #1f5a37; border-radius: 12px; background: rgba(34,242,106,.08); }
  .nv-res .nv-logo { width: 60px; height: 60px; font-size: 20px; }
  .nv-res > span:last-child { display: flex; flex-direction: column; align-items: flex-start; }
  .nv-res small { color: #22f26a; font-size: 10px; font-weight: 800; } .nv-res b { font-size: 16px; } .nv-res em { color: #a1a2a8; font-style: normal; font-size: 10.5px; }
  /* relâmpago */
  .nv-rlh { display: flex; justify-content: space-between; align-items: center; }
  .nv-clock { padding: 3px 8px; border-radius: 999px; background: #141519; color: #a1a2a8; font-size: 10px; } .nv-clock b { color: #ffc400; }
  .nv-rlg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .nv-rl { display: flex; flex-direction: column; gap: 3px; padding: 6px; border: 1px solid #23242a; border-radius: 10px; background: #141519; }
  .nv-rlimg { position: relative; } .nv-rlimg .nv-cv { aspect-ratio: 16 / 10; }
  .nv-rlimg > i { position: absolute; left: 3px; top: 3px; padding: 1px 4px; border-radius: 5px; background: #ffc400; color: #1a1300; font-style: normal; font-size: 8.5px; font-weight: 800; }
  .nv-rl > b { font-size: 10px; }
  .nv-pr { color: #22f26a; font-size: 11px; font-weight: 800; } .nv-pr s { margin-right: 4px; color: #6f7076; font-size: 9px; font-weight: 400; }
  /* streaming no carrinho */
  .nv-stbox { margin-top: 10px; padding: 8px; border: 1px solid #1f5a37; border-radius: 10px; background: rgba(34,242,106,.06); }
  .nv-st { display: flex; align-items: center; gap: 8px; margin-top: 6px; padding: 5px; border-radius: 8px; background: #0f1012; }
  .nv-st b { flex: 1; font-size: 11px; } .nv-st em { color: #22f26a; font-style: normal; font-size: 10px; font-weight: 700; }
  .nv-st .nv-logo { width: 22px; height: 22px; font-size: 10px; }
  .nv-planos { display: none; gap: 5px; margin: 5px 0 0 30px; }
  .nv-planos.nv-show { display: flex; animation: nvLeg .3s ease; }
  .nv-planos span { flex: 1; padding: 6px; border: 1px solid #2c2d33; border-radius: 8px; background: #141519; font-size: 10px; text-align: center; }
  /* nitro */
  .nv-deco { margin-top: 10px; padding: 9px; border: 1px solid #2c2d33; border-radius: 10px; background: #111216; }
  .nv-deco > b { display: block; margin: 2px 0 6px; font-size: 11.5px; }
  .nv-fita { overflow: hidden; } .nv-fita > span { display: flex; gap: 8px; width: max-content; animation: nvFita 4s linear infinite; }
  .nv-fita i { width: 34px; height: 34px; border-radius: 50%; border: 3px solid var(--c); box-shadow: 0 0 10px var(--c); background: #1d1e22; }
  @keyframes nvFita { to { transform: translateX(-50%); } }
  /* presente */
  .nv-pres { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .nv-pc { display: flex; align-items: center; gap: 6px; padding: 7px; border: 1px solid #26272c; border-radius: 10px; background: #0f1012; font-size: 11px; font-weight: 700; }
  .nv-pc.nv-on { border-color: #22f26a; background: rgba(34,242,106,.08); }
  .nv-campos { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 8px; }
  .nv-in { display: flex; flex-direction: column; padding: 6px 8px; border: 1px solid #2c2d33; border-radius: 8px; background: #141519; min-height: 34px; }
  .nv-in small { color: #8d8e93; font-size: 9px; } .nv-in b { font-size: 11.5px; min-height: 14px; }
  .nv-cartao { margin-top: 8px; padding: 10px; border-radius: 12px; background: radial-gradient(120% 120% at 0 0, rgba(34,242,106,.3), transparent 60%), #141519; opacity: .35; transition: opacity .3s; }
  .nv-cartao.nv-show { opacity: 1; }
  .nv-cartao small { display: flex; align-items: center; gap: 4px; color: #22f26a; font-size: 9px; font-weight: 800; } .nv-cartao small svg { width: 11px; height: 11px; }
  .nv-cartao b { display: block; margin: 3px 0; font-size: 13px; } .nv-cartao em { color: #a1a2a8; font-size: 10px; font-style: normal; }
  .nv-link { display: none; margin-top: 8px; padding: 8px; border: 1px solid #1f5a37; border-radius: 10px; background: #0f1012; font-size: 10px; }
  .nv-link.nv-show { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; animation: nvLeg .3s ease; }
  .nv-link small { width: 100%; color: #22f26a; font-weight: 800; } .nv-link > span:nth-child(2) { flex: 1; color: #a1a2a8; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .nv-copy { padding: 4px 8px; border: 1px solid #1f5a37; border-radius: 6px; color: #22f26a; font-weight: 800; }
  /* brinde */
  .nv-free { display: flex; align-items: center; gap: 8px; padding: 8px; border: 1px solid #2c2d33; border-radius: 10px; background: #111216; }
  .nv-free > span:last-child { display: flex; flex-direction: column; } .nv-free b { font-size: 11.5px; } .nv-free small { color: #a1a2a8; font-size: 10px; }
  .nv-cad { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: #18191c; color: #fff; }
  .nv-cad svg { width: 15px; height: 15px; } .nv-arco { transition: transform .4s cubic-bezier(.2,1.6,.4,1); transform-origin: 16px 11px; }
  .nv-free.nv-solto { border-color: #1f5a37; background: rgba(34,242,106,.08); } .nv-solto .nv-cad { background: #22f26a; color: #04140a; } .nv-solto .nv-arco { transform: translate(3px, -3px) rotate(25deg); }
  .nv-fg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 6px; }
  .nv-fi { position: relative; filter: grayscale(1) brightness(.5); transition: filter .4s; } .nv-fi .nv-cv { aspect-ratio: 16 / 9; }
  .nv-free.nv-solto + .nv-fg .nv-fi { filter: none; }
  .nv-fi.nv-in .nv-cv { box-shadow: 0 0 0 3px #22f26a; } .nv-fi.nv-in::after { content: "GRÁTIS"; position: absolute; left: 4px; bottom: 4px; padding: 1px 5px; border-radius: 5px; background: #22f26a; color: #04140a; font-size: 8.5px; font-weight: 800; }
  /* vistos */
  .nv-vis { position: relative; display: flex; gap: 6px; padding-right: 54px; }
  .nv-vi { width: 52px; flex: none; transition: transform .45s ease, opacity .45s ease; transition-delay: var(--d); }
  .nv-vis.nv-limpo .nv-vi { transform: translateY(-40px) scale(.6) rotate(-12deg); opacity: 0; }
  .nv-limpar { position: absolute; right: 0; top: 50%; padding: 6px 9px; border: 1px solid #2c2d33; border-radius: 8px; background: #141519; color: #fff; font-size: 10.5px; font-weight: 700; transform: translateY(-50%); }
  .nv-vazio { margin-top: 10px; color: #8d8e93; opacity: 0; transition: opacity .3s; } .nv-vazio.nv-show { opacity: 1; }
  /* comparar / bloco do jogo */
  .nv-ji { display: flex; flex-direction: column; gap: 4px; padding: 10px; border: 1px solid #23242a; border-radius: 12px; background: #0f1012; }
  .nv-ji > b { font-size: 14px; }
  .nv-cvw { width: 100%; aspect-ratio: 16 / 7 !important; }
  .nv-cbtn { display: flex; align-items: center; justify-content: center; gap: 5px; margin-top: 4px; padding: 7px; border: 1px solid #2c2d33; border-radius: 8px; background: #141519; font-size: 11px; font-weight: 700; }
  .nv-cbtn svg { width: 13px; height: 13px; }
  .nv-esg { align-self: flex-start; padding: 2px 7px; border-radius: 6px; background: rgba(248,113,113,.15); color: #f87171; font-size: 10px; font-weight: 800; }
  .nv-ops { display: grid; gap: 4px; margin-top: 6px; } .nv-ops.nv-out { display: none; }
  .nv-o { padding: 7px; border-radius: 8px; background: #141519; font-size: 11px; }
