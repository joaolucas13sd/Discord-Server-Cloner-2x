  <section class="rn-bf__rl" id="rn-bf-rl" aria-label="Ofertas relâmpago" hidden>
    <div class="rn-bf__rlh">
      <div><div class="rn-bf__rlk"><svg class="rn-ico-raio" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.2 2.2 4.6 13a.8.8 0 0 0 .6 1.3h5.4l-1.4 7.1c-.1.8.9 1.2 1.4.6L19.4 11a.8.8 0 0 0-.6-1.3h-5.4l1.4-6.9c.1-.8-.9-1.2-1.6-.6Z"/></svg> RELÂMPAGO</div><h2 class="rn-bf__rlt">3 jogos por R$ 10 cada, trocam a cada 3 horas</h2><p class="rn-bf__rlsub">1 de Ação, 1 de Aventura e 1 surpresa de outra categoria</p></div>
