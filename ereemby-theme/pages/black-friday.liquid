  {% assign rn_presente_api = 'https://presente-rei-dos-nitros.juanlauncherpikadasgalaxias.workers.dev' %}
  <script>
    (function () {
      // Rei dos Nitros: "Relâmpago" - a cada 3 horas (horário de Brasília) 3 jogos ficam por R$ 10 cada.
      // Quem escolhe os 3 é o servidor (o mesmo do presente), que também troca os preços na loja.
      // Se o servidor não responder, a página faz a mesma conta sozinha (mesma regra, mesmo resultado).
      // Botão "Adicionar ao carrinho": com 2 jogos pagos no carrinho, o próximo entra como brinde
      // (cupom RELAMPAGO quando o brinde é um jogo de R$ 10) e o cliente pode trocá-lo no carrinho.
      var SLOT = 10800, BRT = 3 * 3600, INICIO = 1795575600, FIM = 1796094000, PRECO = 10, NORMAL = 15.99;
      var API = '{{ rn_presente_api }}'.replace(/\/+$/, '');
      var sec = document.getElementById('rn-bf-rl'); if (!sec) return;
      function pronto(cb) { if (window.rnJogos && window.CATALOG_PRODUCTS && window.RNB) cb(); else setTimeout(function () { pronto(cb); }, 80); }
      function pad(n) { return (n < 10 ? '0' : '') + n; }
      function cupomHoje(agora) {
        var cod = '';
        document.querySelectorAll('.rn-bf__tk').forEach(function (t) {
          var c = t.querySelector('.rn-bf__code--on .rn-bf__codev');
          var ini = Number(t.getAttribute('data-t'));
          if (c && agora >= ini && agora < ini + 86400) cod = c.textContent.trim();
        });
        return cod;
      }
      var ICO_ADD = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L22 7H6"/></svg>';
      var ICO_OK = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
      var slotVisto = -1, doServidor = null, hoje = [];
      function calcular(slot) {
        var p = window.rnProdJogos(); if (!p) return [];
        var ordem = {}; (p.variants || []).forEach(function (v, i) { if (v) ordem[String(v.id)] = i; });
        var pool = window.rnVarsJogos().filter(function (v) { return String(v.name).toLowerCase().indexOf('combo') !== 0 && window.rnTemEstoque(v); })
          .sort(function (a, b) { return (ordem[String(a.id)] || 0) - (ordem[String(b.id)] || 0); });
        // mesma regra do servidor: 1 de Ação, 1 de Aventura e 1 de outra categoria (os 20 mais jogados de cada grupo)
        function c(v) { return (window.rnJogo(v.name) || {}).c; }
        var grupos = [
          pool.filter(function (v) { return c(v) === 'acao'; }),
          pool.filter(function (v) { return c(v) === 'aventura'; }),
          pool.filter(function (v) { return c(v) !== 'acao' && c(v) !== 'aventura'; })
        ].map(function (g) { return g.slice(0, 20); });
        if (grupos.some(function (g) { return !g.length; })) return [];
        return grupos.map(function (g) { return g[slot % g.length]; });
      }
      function perguntar(slot) {
        if (!API || !window.fetch) return;
        fetch(API + '/relampago', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
          if (!d || !d.ok || !d.itens || d.itens.length !== 3) return;
          var l = d.itens.map(function (x) { return window.RNB.porId(x.id) || window.RNB.porNome(x.nome); });
          if (l.some(function (v) { return !v; })) return;
          doServidor = { slot: slot, itens: l }; montar(true);
        }).catch(function () {});
      }
      function botao(v) {
        var dentro = window.RNB.noCarrinho(v), gratis = dentro && window.RNB.ehBrinde(v.id);
        if (!window.RNB.temEstoque(v)) return '<button type="button" class="rn-bf__rladd rn-bf__rladd--off" disabled>Esgotado</button>';
        return '<button type="button" class="rn-bf__rladd' + (dentro ? ' rn-bf__rladd--in' : '') + '" data-vid="' + window.rnEsc(v.id) + '">' +
          (dentro ? ICO_OK + '<span>' + (gratis ? 'No carrinho (grátis)' : 'No carrinho') + '</span>' : ICO_ADD + '<span>Adicionar ao carrinho</span>') + '</button>';
      }
      function pintarBotoes() {
        document.querySelectorAll('#rn-bf-rlg .rn-bf__rli').forEach(function (c) {
          var v = window.RNB.porId(c.getAttribute('data-vid')); if (!v) return;
          var b = c.querySelector('.rn-bf__rladd'), t = document.createElement('div'); t.innerHTML = botao(v);
          if (b && b.outerHTML !== t.firstChild.outerHTML) b.replaceWith(t.firstChild);
        });
      }
      function montar(manter) {
        var esc = window.rnEsc, brl = window.rnBrl;
        var agora = Date.now() / 1000, slot = Math.floor((agora - BRT) / SLOT);
        if (!manter && slot !== slotVisto) { doServidor = null; perguntar(slot); }
        // 1º: os jogos que estão de fato por R$ 10 na loja agora (é o preço que vale no checkout)
        var reais = window.rnVarsJogos().filter(function (v) { var x = Number(v.price) || 0; return x > 0 && x <= PRECO + .5 && String(v.name).toLowerCase().indexOf('combo') !== 0; });
        var ORD = { acao: 0, aventura: 1 };
        reais.sort(function (a, b) { var ca = ORD[(window.rnJogo(a.name) || {}).c], cb = ORD[(window.rnJogo(b.name) || {}).c]; return (ca == null ? 2 : ca) - (cb == null ? 2 : cb); });
        hoje = reais.length >= 3 ? reais.slice(0, 3) : (doServidor && doServidor.slot === slot ? doServidor.itens : calcular(slot));
        if (hoje.length < 3) return;
        slotVisto = slot;
        var cod = cupomHoje(agora);
        var todosDez = hoje.every(function (v) { var x = Number(v.price) || 0; return x > 0 && x <= PRECO + .5; });
        document.getElementById('rn-bf-rlcup').innerHTML =
          (todosDez ? 'Cada um por <b>R$ 10</b>. ' : '') + 'Leve os 3 e <b>1 sai de graça</b> (você pode trocar o brinde por outro jogo no carrinho).' +
          (cod ? ' Cupom de hoje: <b>' + esc(cod) + '</b>.' : (agora < INICIO ? ' Os cupons secretos começam em 25/11 à meia-noite.' : ''));
        document.getElementById('rn-bf-rlg').innerHTML = hoje.map(function (v) {
          var j = window.rnJogo(v.name) || {}, img = (v.images && v.images[0]) || v.icon || '';
          // mostra o preço real da loja: R$ 10 só depois que o servidor trocou o preço (nunca anuncia antes)
          var atual = Number(v.price) || 0, rel = atual > 0 && atual <= PRECO + .5;
          var de = rel ? NORMAL : (Number(v.comparison) > atual ? Number(v.comparison) : 0), off = de ? Math.round((1 - atual / de) * 100) : 0;
          return '<div class="rn-bf__rli" data-vid="' + esc(v.id) + '"><a class="rn-bf__rla" href="' + esc(window.rnLinkVar(v)) + '"><span class="rn-bf__rlimg"><img src="' + esc(img) + '" alt="" loading="lazy">' + (off > 0 ? '<span class="rn-bf__rloff">-' + off + '%</span>' : '') + '</span>' +
            '<span class="rn-bf__rln">' + esc(v.name) + '</span><span class="rn-bf__rlm">' + (j.r ? window.rnNota(j) : '') + '</span>' +
            '<span class="rn-bf__rlp">' + (off > 0 ? '<s>' + brl(de) + '</s>' : '') + '<b>' + brl(atual) + '</b></span></a>' + botao(v) + '</div>';
        }).join('');
        sec.hidden = false;
        // veio de um link para o Relâmpago (ex.: Novidades): rola até aqui, uma vez
        var ir = location.hash === '#rn-bf-rl'; try { ir = ir || sessionStorage.getItem('rn_ir_relampago') === '1'; sessionStorage.removeItem('rn_ir_relampago'); } catch (x) {}
        if (ir && !sec.__rolou) { sec.__rolou = 1; setTimeout(function () { window.scrollTo({ top: sec.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' }); }, 350); }
      }
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.rn-bf__rladd'); if (!b || !window.RNB) return;
        e.preventDefault(); e.stopPropagation();
        var R = window.RNB, v = R.porId(b.getAttribute('data-vid')); if (!v || !R.temEstoque(v)) return;
        if (R.noCarrinho(v)) {
          if (R.ehBrinde(v.id)) R.remover(v.id);
          R.itens().forEach(function (i) { if (String(i.variant) === String(v.id)) window.EreembyCart.removeItem(i.product, i.variant); });
          R.toast(v.name + ' tirado do carrinho.');
        } else if (R.livres() > 0) {
          R.escolher(v); // 2 jogos pagos já no carrinho: este entra como brinde
        } else {
          R.addItem(v, false);
          var f = R.faltaPara();
          R.toast(R.livres() > 0 ? v.name + ' adicionado! O próximo jogo sai de graça.' : v.name + ' adicionado! Falta ' + f + ' para ganhar 1 grátis.');
        }
        setTimeout(pintarBotoes, 50);
      }, true);
      pronto(function () {
        window.rnJogos(function () { montar(true); }); montar();
        window.addEventListener('cart-sync', function () { setTimeout(pintarBotoes, 30); });
        setInterval(function () {
          var agora = Date.now() / 1000, slot = Math.floor((agora - BRT) / SLOT);
          if (slot !== slotVisto) montar();
          var r = Math.max(0, Math.floor((slot + 1) * SLOT + BRT - agora));
          var el = document.getElementById('rn-bf-rlc'); if (el) el.textContent = pad(Math.floor(r / 3600)) + ':' + pad(Math.floor(r % 3600 / 60)) + ':' + pad(r % 60);
          pintarBotoes();
        }, 1000);
      });
    })();
  </script>

