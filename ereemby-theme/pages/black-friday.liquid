<script>
  (function () {
    var dias = [].slice.call(document.querySelectorAll('.rn-bf__day')).map(function (el) { return +el.getAttribute('data-t'); });
    var DIA = 86400;
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var agora = Date.now() / 1000;
      // status de cada dia
      document.querySelectorAll('.rn-bf__day').forEach(function (el) {
        var t = +el.getAttribute('data-t'), s = el.querySelector('.rn-bf__ds');
        el.classList.remove('rn-bf__day--hoje', 'rn-bf__day--foi');
        if (agora >= t && agora < t + DIA) { s.textContent = 'Liberado hoje'; el.classList.add('rn-bf__day--hoje'); }
        else if (agora >= t + DIA) { s.textContent = 'Liberado'; el.classList.add('rn-bf__day--foi'); }
        else { s.textContent = s.getAttribute('data-ult') ? 'Último dia' : 'Em breve'; }
      });
      // contagem para o próximo cupom
      var prox = dias.filter(function (t) { return t > agora; })[0];
      if (!prox) { document.getElementById('rn-bf-timer').hidden = true; }
      else {
        var r = Math.max(0, Math.floor(prox - agora));
        document.getElementById('rn-bf-d').textContent = pad(Math.floor(r / DIA));
        document.getElementById('rn-bf-h').textContent = pad(Math.floor(r % DIA / 3600));
        document.getElementById('rn-bf-m').textContent = pad(Math.floor(r % 3600 / 60));
        document.getElementById('rn-bf-s').textContent = pad(r % 60);
      }
      // contagem dentro de cada cupom bloqueado
      document.querySelectorAll('.rn-bf__cd').forEach(function (el) {
        var r = Math.max(0, Math.floor(+el.getAttribute('data-cd') - agora));
        el.textContent = r > 0 ? 'Faltam ' + (r >= DIA ? Math.floor(r / DIA) + 'd ' : '') + pad(Math.floor(r % DIA / 3600)) + ':' + pad(Math.floor(r % 3600 / 60)) + ':' + pad(r % 60) : 'Liberando…';
      });
      // chegou a hora de um cupom ainda bloqueado: recarrega para o servidor revelar o código
      var vencido = [].some.call(document.querySelectorAll('[data-lock]'), function (el) { return agora >= +el.getAttribute('data-lock') + 2; });
      if (vencido && !window.__rnBfReload) {
        window.__rnBfReload = true;
        setTimeout(function () { location.reload(); }, 1500);
        setTimeout(function () { window.__rnBfReload = false; }, 25000);
      }
    }
    tick(); setInterval(tick, 1000);

    document.addEventListener('click', function (e) {
      var b = e.target.closest('.rn-bf__copy'); if (!b) return;
      var code = b.getAttribute('data-code');
      var ok = function () { var s = b.querySelector('span'); s.textContent = 'Copiado!'; b.classList.add('rn-bf__copy--ok'); setTimeout(function () { s.textContent = 'Copiar'; b.classList.remove('rn-bf__copy--ok'); }, 1800); };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(code).then(ok, function () {});
      else { var t = document.createElement('textarea'); t.value = code; document.body.appendChild(t); t.select(); try { document.execCommand('copy'); ok(); } catch (_) {} t.remove(); }
    });
  })();
</script>
