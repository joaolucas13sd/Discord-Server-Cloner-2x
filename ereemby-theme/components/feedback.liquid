{% assign fb = product.feedback %}
{% assign fb_stats = fb.stats %}
{% assign fb_total = fb_stats.total | default: 0 %}
{% assign fb_avg = fb_stats.average | default: 0 %}
{% assign fb_avg_floor = fb_avg | floor %}

{% if fb_total > 0 %}
  {% assign star1 = fb_stats.stars['1'] | default: 0 %}
  {% assign star2 = fb_stats.stars['2'] | default: 0 %}
  {% assign star3 = fb_stats.stars['3'] | default: 0 %}
  {% assign star4 = fb_stats.stars['4'] | default: 0 %}
  {% assign star5 = fb_stats.stars['5'] | default: 0 %}
  {% assign pct5 = star5 | times: 100 | divided_by: fb_total | floor %}
  {% assign pct4 = star4 | times: 100 | divided_by: fb_total | floor %}
  {% assign pct3 = star3 | times: 100 | divided_by: fb_total | floor %}
  {% assign pct2 = star2 | times: 100 | divided_by: fb_total | floor %}
  {% assign pct1 = star1 | times: 100 | divided_by: fb_total | floor %}
{% endif %}

{% comment %} ─── Main feedback section ─── {% endcomment %}
<div id="fb-component">

  {% if fb_total > 0 %}

    {% comment %} Statistics {% endcomment %}
    <div class="flex items-center gap-4 sm:gap-6 mb-6">
      <div class="text-center flex-shrink-0">
        <p class="text-4xl sm:text-5xl font-extrabold text-white">{{ fb_avg }}</p>
        <div class="flex justify-center my-1 gap-0.5">
          {% for i in (1..5) %}
            <svg
              class="w-4 h-4 {% if i <= fb_avg_floor %}text-white{% else %}text-neutral-700{% endif %}"
              fill="currentColor"
              viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          {% endfor %}
        </div>
        <p class="text-sm text-neutral-500">{{ fb_total }} avaliações</p>
      </div>
      <div class="flex-1 space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="text-xs text-neutral-500 w-4">5</span>
          <div class="flex-1 h-2 bg-neutral-800 rounded-full overflow-hidden">
            <div class="h-full bg-white rounded-full transition-all" style="width: {{ pct5 }}%"></div>
          </div>
          <span class="text-xs text-neutral-600 w-8 text-right">{{ pct5 }}%</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-neutral-500 w-4">4</span>
          <div class="flex-1 h-2 bg-neutral-800 rounded-full overflow-hidden">
            <div class="h-full bg-white rounded-full transition-all" style="width: {{ pct4 }}%"></div>
          </div>
          <span class="text-xs text-neutral-600 w-8 text-right">{{ pct4 }}%</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-neutral-500 w-4">3</span>
          <div class="flex-1 h-2 bg-neutral-800 rounded-full overflow-hidden">
            <div class="h-full bg-white rounded-full transition-all" style="width: {{ pct3 }}%"></div>
          </div>
          <span class="text-xs text-neutral-600 w-8 text-right">{{ pct3 }}%</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-neutral-500 w-4">2</span>
          <div class="flex-1 h-2 bg-neutral-800 rounded-full overflow-hidden">
            <div class="h-full bg-white rounded-full transition-all" style="width: {{ pct2 }}%"></div>
          </div>
          <span class="text-xs text-neutral-600 w-8 text-right">{{ pct2 }}%</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-neutral-500 w-4">1</span>
          <div class="flex-1 h-2 bg-neutral-800 rounded-full overflow-hidden">
            <div class="h-full bg-white rounded-full transition-all" style="width: {{ pct1 }}%"></div>
          </div>
          <span class="text-xs text-neutral-600 w-8 text-right">{{ pct1 }}%</span>
        </div>
      </div>
    </div>

    {% comment %} AI Summary {% endcomment %}
    {% if fb.generate_text_ia and fb.text_ia %}
      <div class="mb-5 p-4 rounded-xl bg-neutral-900 border border-neutral-800">
        <div class="flex items-center gap-2 mb-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-neutral-400 flex-shrink-0"
            fill="currentColor"
            viewBox="0 0 256 256">
            <path d="M197.58,129.06l-51.61-19-19-51.65a15.92,15.92,0,0,0-29.88,0L78.07,110l-51.65,19a15.92,15.92,0,0,0,0,29.88L78,178l19,51.62a15.92,15.92,0,0,0,29.88,0l19-51.61,51.65-19a15.92,15.92,0,0,0,0-29.88ZM184.8,153l-16,5.86a8,8,0,0,0-4.84,4.84l-5.86,16a7.93,7.93,0,0,1-14.94,0l-5.87-16a8,8,0,0,0-4.84-4.84l-16-5.86a7.93,7.93,0,0,1,0-14.94l16-5.86a8,8,0,0,0,4.84-4.84l5.86-16a7.93,7.93,0,0,1,14.94,0l5.86,16a8,8,0,0,0,4.84,4.84l16,5.86a7.93,7.93,0,0,1,0,14.94ZM144,40a8,8,0,0,1,8-8h16V16a8,8,0,0,1,16,0V32h16a8,8,0,0,1,0,16H184V64a8,8,0,0,1-16,0V48H152A8,8,0,0,1,144,40ZM248,88a8,8,0,0,1-8,8h-8v8a8,8,0,0,1-16,0V96h-8a8,8,0,0,1,0-16h8V72a8,8,0,0,1,16,0v8h8A8,8,0,0,1,248,88Z" />
          </svg>
          <span class="text-xs text-neutral-500 font-medium">Resumo de avaliações gerado por IA</span>
        </div>
        <p class="text-sm text-neutral-300 leading-relaxed">{{ fb.text_ia }}</p>
      </div>
    {% endif %}

    {% comment %} Filters {% endcomment %}
    <div class="flex flex-wrap gap-2 mb-5">

      <div class="relative">
        <button
          id="fb-filter-star-btn"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-700 text-neutral-400 hover:text-white hover:border-neutral-500 transition-all text-xs font-medium focus:outline-none">
          <span id="fb-filter-star-label">Estrelas</span>
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="fb-filter-star-dropdown"
          class="hidden absolute top-full left-0 mt-1 z-20 bg-neutral-900 border border-neutral-700 rounded-xl shadow-xl shadow-black/40 overflow-hidden min-w-[110px]">
          <button data-star="all" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">Todos</button>
          <button data-star="5" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors flex items-center gap-1.5">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            5
          </button>
          <button data-star="4" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors flex items-center gap-1.5">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            4
          </button>
          <button data-star="3" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors flex items-center gap-1.5">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            3
          </button>
          <button data-star="2" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors flex items-center gap-1.5">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            2
          </button>
          <button data-star="1" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors flex items-center gap-1.5">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            1
          </button>
        </div>
      </div>

      <div class="relative">
        <button
          id="fb-filter-sort-btn"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-700 text-neutral-400 hover:text-white hover:border-neutral-500 transition-all text-xs font-medium focus:outline-none">
          <span id="fb-filter-sort-label">Ordenar</span>
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="fb-filter-sort-dropdown"
          class="hidden absolute top-full left-0 mt-1 z-20 bg-neutral-900 border border-neutral-700 rounded-xl shadow-xl shadow-black/40 overflow-hidden min-w-[130px]">
          <button data-sort="all" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">Todos</button>
          <button data-sort="ASC" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">Mais antigos</button>
          <button data-sort="DESC" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">Mais recentes</button>
        </div>
      </div>

    </div>

    {% comment %} Dynamic reviews list – populated by feedback.js on tab click {% endcomment %}
    <div id="fb-reviews-list" class="divide-y divide-neutral-800 min-h-[60px]"></div>

    {% comment %} Show All button {% endcomment %}
    <button
      id="fb-show-all"
      class="hidden w-full mt-5 py-3 flex items-center justify-center gap-2 rounded-xl border border-neutral-800 text-neutral-500 hover:text-white hover:border-neutral-600 transition-all text-sm font-medium focus:outline-none">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
      Mostrar todas as avaliações
    </button>

  {% else %}

    {% comment %} Empty state {% endcomment %}
    <div class="flex flex-col items-center justify-center py-12 text-center">
      <p class="text-neutral-500 text-sm">Nenhuma avaliação ainda. Seja o primeiro a avaliar!</p>
    </div>

  {% endif %}

</div>

{% comment %} ─── Modal (rendered outside component to avoid z-index conflicts) ─── {% endcomment %}
{% if fb_total > 0 %}
<div
  id="fb-modal"
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Avaliações do produto">

  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>

  <div class="relative z-10 flex items-start justify-center min-h-screen p-4 sm:p-6">
    <div
      class="w-full max-w-4xl bg-neutral-950 border border-neutral-800 rounded-2xl shadow-2xl shadow-black/60 flex flex-col mt-8"
      style="max-height: 88vh;">

      {% comment %} Header {% endcomment %}
      <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-800 flex-shrink-0">
        <h2 class="text-white font-semibold text-base">Avaliações do produto</h2>
        <button
          id="fb-modal-close"
          class="p-1.5 rounded-lg text-neutral-500 hover:text-white hover:bg-neutral-800 transition-all focus:outline-none"
          aria-label="Fechar">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 256 256">
            <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z" />
          </svg>
        </button>
      </div>

      {% comment %} Body: left (stats + AI) | right (filters + reviews) {% endcomment %}
      <div class="flex flex-1 overflow-hidden min-h-0">

        {% comment %} Left panel – statistics + AI summary (desktop only, no filters to avoid ID conflicts) {% endcomment %}
        <div class="hidden lg:flex flex-col w-64 flex-shrink-0 border-r border-neutral-800 overflow-y-auto p-5 gap-5">

          <div class="flex items-center gap-3">
            <div class="text-center flex-shrink-0">
              <p class="text-3xl font-extrabold text-white">{{ fb_avg }}</p>
              <div class="flex justify-center mt-1 gap-0.5">
                {% for i in (1..5) %}
                  <svg
                    class="w-3 h-3 {% if i <= fb_avg_floor %}text-white{% else %}text-neutral-700{% endif %}"
                    fill="currentColor"
                    viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                {% endfor %}
              </div>
              <p class="text-xs text-neutral-500 mt-0.5">{{ fb_total }} avaliações</p>
            </div>
            <div class="flex-1 space-y-1">
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-neutral-500 w-3">5</span>
                <div class="flex-1 h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                  <div class="h-full bg-white rounded-full" style="width: {{ pct5 }}%"></div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-neutral-500 w-3">4</span>
                <div class="flex-1 h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                  <div class="h-full bg-white rounded-full" style="width: {{ pct4 }}%"></div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-neutral-500 w-3">3</span>
                <div class="flex-1 h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                  <div class="h-full bg-white rounded-full" style="width: {{ pct3 }}%"></div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-neutral-500 w-3">2</span>
                <div class="flex-1 h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                  <div class="h-full bg-white rounded-full" style="width: {{ pct2 }}%"></div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs text-neutral-500 w-3">1</span>
                <div class="flex-1 h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                  <div class="h-full bg-white rounded-full" style="width: {{ pct1 }}%"></div>
                </div>
              </div>
            </div>
          </div>

          {% if fb.generate_text_ia and fb.text_ia %}
            <div class="p-3 rounded-xl bg-neutral-900 border border-neutral-800">
              <div class="flex items-center gap-1.5 mb-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-neutral-400 flex-shrink-0" fill="currentColor" viewBox="0 0 256 256">
                  <path d="M197.58,129.06l-51.61-19-19-51.65a15.92,15.92,0,0,0-29.88,0L78.07,110l-51.65,19a15.92,15.92,0,0,0,0,29.88L78,178l19,51.62a15.92,15.92,0,0,0,29.88,0l19-51.61,51.65-19a15.92,15.92,0,0,0,0-29.88ZM184.8,153l-16,5.86a8,8,0,0,0-4.84,4.84l-5.86,16a7.93,7.93,0,0,1-14.94,0l-5.87-16a8,8,0,0,0-4.84-4.84l-16-5.86a7.93,7.93,0,0,1,0-14.94l16-5.86a8,8,0,0,0,4.84-4.84l5.86-16a7.93,7.93,0,0,1,14.94,0l5.86,16a8,8,0,0,0,4.84,4.84l16,5.86a7.93,7.93,0,0,1,0,14.94Z" />
                </svg>
                <span class="text-xs text-neutral-500">Resumo por IA</span>
              </div>
              <p class="text-xs text-neutral-300 leading-relaxed">{{ fb.text_ia }}</p>
            </div>
          {% endif %}

        </div>

        {% comment %} Right panel – filters + reviews with infinite scroll {% endcomment %}
        <div class="flex-1 overflow-y-auto p-5 flex flex-col" id="fb-modal-body">

          {% comment %} Modal filters (single set, no ID conflicts) {% endcomment %}
          <div class="flex flex-wrap gap-2 mb-4 flex-shrink-0">

            <div class="relative">
              <button
                id="fb-modal-filter-star-btn"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-700 text-neutral-400 hover:text-white hover:border-neutral-500 transition-all text-xs font-medium focus:outline-none">
                <span id="fb-modal-filter-star-label">Estrelas</span>
                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div
                id="fb-modal-filter-star-dropdown"
                class="hidden absolute top-full left-0 mt-1 z-20 bg-neutral-900 border border-neutral-700 rounded-xl shadow-xl overflow-hidden min-w-[110px]">
                <button data-star="all" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">Todos</button>
                <button data-star="5" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">5 ★</button>
                <button data-star="4" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">4 ★</button>
                <button data-star="3" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">3 ★</button>
                <button data-star="2" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">2 ★</button>
                <button data-star="1" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">1 ★</button>
              </div>
            </div>

            <div class="relative">
              <button
                id="fb-modal-filter-sort-btn"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-700 text-neutral-400 hover:text-white hover:border-neutral-500 transition-all text-xs font-medium focus:outline-none">
                <span id="fb-modal-filter-sort-label">Ordenar</span>
                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div
                id="fb-modal-filter-sort-dropdown"
                class="hidden absolute top-full left-0 mt-1 z-20 bg-neutral-900 border border-neutral-700 rounded-xl shadow-xl overflow-hidden min-w-[130px]">
                <button data-sort="all" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">Todos</button>
                <button data-sort="ASC" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">Mais antigos</button>
                <button data-sort="DESC" class="w-full text-left px-3 py-2 text-xs text-neutral-400 hover:bg-neutral-800 hover:text-white transition-colors">Mais recentes</button>
              </div>
            </div>

          </div>

          {% comment %} Dynamically populated reviews {% endcomment %}
          <div id="fb-modal-reviews" class="divide-y divide-neutral-800 flex-1"></div>

          {% comment %} Infinite scroll sentinel {% endcomment %}
          <div id="fb-modal-sentinel-container" class="hidden py-6 flex items-center justify-center gap-1.5 flex-shrink-0">
            <div id="fb-modal-sentinel"></div>
            <div class="w-1.5 h-1.5 bg-neutral-700 rounded-full animate-pulse"></div>
            <div class="w-1.5 h-1.5 bg-neutral-700 rounded-full animate-pulse" style="animation-delay: 0.15s"></div>
            <div class="w-1.5 h-1.5 bg-neutral-700 rounded-full animate-pulse" style="animation-delay: 0.3s"></div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}
