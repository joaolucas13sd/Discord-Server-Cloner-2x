.rn-bf__code { display: flex; align-items: center; gap: 12px; margin-top: 14px; padding: 14px; border: 2px dashed #c4c5ca; border-radius: 16px; background: #f1f2f4; font-size: 14px; line-height: 1.4; color: #4b4c52; }
