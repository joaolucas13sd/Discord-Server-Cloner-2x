.rn-steam__esg { margin-top: 4px; font-size: 13px; font-weight: 700; color: #f87171; }

/* Página Jogos Steam: Compre 2, leve 1 grátis */
.rn-free { position: relative; overflow: hidden; margin-bottom: 18px; padding: 20px 0 18px; border: 1px solid #1f5a37; border-radius: 22px; background: radial-gradient(120% 90% at 0% 0%, rgba(34,242,106,.16), transparent 60%), #0f1012; font-family: var(--rn-font); }
