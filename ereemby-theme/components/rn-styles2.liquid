@media (max-width: 380px) { .rn-bf__tk { grid-template-columns: 30% 1fr; } .rn-bf__tk::before, .rn-bf__tk::after { left: calc(30% - 14px); } }

/* ===== Página de produto: grade de opções com capas (6+ opções) ===== */
.rn-vg__search { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; padding: 0 14px; border: 1px solid #2c2d33; border-radius: 14px; background: #0b0c0e; color: #8d8e93; transition: border-color .15s ease; }
.rn-vg__search:focus-within { border-color: #22f26a; color: #22f26a; }
.rn-vg__search input { flex: 1; min-width: 0; height: 46px; border: 0; outline: none; background: transparent; color: #fff; font: inherit; font-size: 15px; }
.rn-vg__search input::placeholder { color: #8d8e93; }
.rn-vg { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 2px; }
.rn-vg--fechado::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 70px; background: linear-gradient(180deg, transparent, #141416); pointer-events: none; border-radius: 0 0 16px 16px; }
.rn-vg__more { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; margin-top: 12px; padding: 14px; border: 1px solid #1f5a37; border-radius: 14px; background: rgba(34,242,106,.08); color: #22f26a; font: inherit; font-size: 15px; font-weight: 800; cursor: pointer; transition: background .15s ease; }
.rn-vg__more:hover { background: rgba(34,242,106,.14); }
.rn-vg__more[hidden] { display: none; }
.rn-vg__more svg { transition: transform .2s ease; }
.rn-vg__more--aberto svg { transform: rotate(180deg); }
@media (min-width: 1280px) { .rn-vg { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.rn-vg__card { display: flex; flex-direction: column; gap: 6px; padding: 8px 8px 10px; border: 1px solid #2a2b30 !important; border-radius: 16px; background: #16171a !important; color: #fff !important; font: inherit; text-align: left; cursor: pointer; transition: border-color .15s ease, transform .15s ease; }
.rn-vg__card:hover { border-color: #3f4046 !important; }
.rn-vg__card.rn-opt--on { border-color: #22f26a !important; background: linear-gradient(180deg, rgba(34,242,106,.14), #16171a 70%) !important; box-shadow: 0 0 0 1px #22f26a inset; }
.rn-vg__cover { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 11px; background: linear-gradient(135deg, #1d2a22, #0f1012); }
.rn-vg__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rn-vg__ph { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--rn-font-round); font-size: 34px; font-weight: 800; color: rgba(34,242,106,.55); }
.rn-vg__off { position: absolute; left: 6px; bottom: 6px; padding: 3px 7px; border-radius: 8px; background: #22f26a; color: #04140a; font-size: 11.5px; font-weight: 800; }
.rn-vg__esg { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(0,0,0,.6); color: #f87171; font-size: 13px; font-weight: 800; letter-spacing: .04em; }
.rn-vg__check { position: absolute; top: 6px; right: 6px; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #22f26a !important; color: #04140a; opacity: 0; transform: scale(.6); transition: opacity .15s ease, transform .15s ease; }
.rn-vg__check.border-white { opacity: 1; transform: scale(1); }
.rn-vg__name { font-size: 13.5px; font-weight: 700; line-height: 1.3; color: #fff; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
.rn-vg__price { font-size: 14.5px; font-weight: 800; color: #fff; }
.rn-vg__price s { margin-left: 4px; font-size: 11.5px; font-weight: 500; color: #6b6c72; }
.rn-vg__card--out { opacity: .6; }
.rn-vg__vazio { margin: 10px 0 0; padding: 14px; border: 1px dashed #2c2d33; border-radius: 14px; text-align: center; font-size: 14px; color: #8d8e93; }

/* Vitrine Steam: contador de troca diária e esgotado */
.rn-steam__novo { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; padding: 6px 12px; border: 1px solid #1f5a37; border-radius: 999px; background: rgba(34,242,106,.08); font-size: 13px; color: #a1a2a8; font-family: var(--rn-font); }
