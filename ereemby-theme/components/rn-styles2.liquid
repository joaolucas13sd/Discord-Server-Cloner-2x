{% comment %} Rei dos Nitros: estilos do tema, parte 2 (continua rn-styles). {% endcomment %}
<style>
/* ===== Mini-animações de toque ===== */
.rn-fx-press { transform: scale(.97) !important; transition: transform .12s ease !important; }
.rn-bnav__item.rn-fx-press { transform: scale(.92) !important; }
.rn-bnav__cart.rn-fx-press { transform: none !important; }
.rn-fx-box { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none; z-index: 3; }
.rn-fx-wave {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,.30) 0%, rgba(255,255,255,.14) 40%, rgba(255,255,255,0) 70%);
  transform: scale(0);
  animation: rnFxWave .45s cubic-bezier(.2,.8,.2,1) forwards;
}
.rn-fx-wave--dark { background: radial-gradient(circle, rgba(0,0,0,.18) 0%, rgba(0,0,0,.08) 40%, rgba(0,0,0,0) 70%); }
.rn-fx-wave--out { opacity: 0; transition: opacity .35s ease .1s; }
@keyframes rnFxWave { to { transform: scale(1); } }
@media (prefers-reduced-motion: reduce) { .rn-fx-press { transform: none !important; } .rn-fx-box { display: none; } }

/* ===== Sem o quadrado azul do navegador ao tocar ===== */
html, body, a, button, [role="button"], summary, label, input, .swiper-slide { -webkit-tap-highlight-color: transparent !important; }
a:focus:not(:focus-visible), button:focus:not(:focus-visible), summary:focus:not(:focus-visible), [tabindex]:focus:not(:focus-visible) { outline: none !important; box-shadow: none; }
a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid #22f26a !important; outline-offset: 2px; }

/* ===== Chamada da Black Friday (topo da Home) ===== */
.rn-bfh {
  box-sizing: border-box;
  width: calc(100% - 32px);
  max-width: 928px;
  margin: 16px auto 4px;
  padding: 24px 18px;
  border: 1px solid #1f5a37;
  border-radius: 28px;
  background: radial-gradient(120% 70% at 100% 100%, rgba(34,242,106,.14), transparent 60%), radial-gradient(90% 60% at 0% 0%, rgba(34,242,106,.08), transparent 55%), #050506;
  color: #fff;
  font-family: var(--rn-font);
}
.rn-bfh__pill { display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px; border: 1.5px solid #1f5a37; border-radius: 999px; font-size: clamp(12px, 3.6vw, 14.5px); font-weight: 800; letter-spacing: .16em; color: #22f26a; }
.rn-bfh__dot { width: 8px; height: 8px; border-radius: 50%; background: #22f26a; box-shadow: 0 0 0 0 rgba(34,242,106,.6); animation: rnBfhPulse 1.6s ease-out infinite; }
@keyframes rnBfhPulse { to { box-shadow: 0 0 0 10px rgba(34,242,106,0); } }
.rn-bfh__title { display: flex; flex-direction: column; margin: 16px 0 0; font-family: var(--rn-font-round); font-weight: 800; line-height: .92; letter-spacing: -.01em; }
.rn-bfh__l1, .rn-bfh__l2 { font-size: clamp(58px, 19vw, 104px); }
.rn-bfh__l1 { color: #fff; text-shadow: 4px 4px 0 #0d6b34, 6px 6px 0 rgba(0,0,0,.4); }
.rn-bfh__l2 { color: #22f26a; text-shadow: 4px 4px 0 #0d6b34, 6px 6px 0 rgba(0,0,0,.4); }
.rn-bfh__tag { display: inline-block; margin-top: 14px; padding: 8px 18px; border-radius: 14px; background: #fff; color: #0d6b34; font-family: var(--rn-font-round); font-size: clamp(18px, 5.4vw, 24px); font-weight: 800; transform: rotate(-3deg); box-shadow: 4px 4px 0 #0d6b34; }
.rn-bfh__txt { margin: 18px 0 0; font-size: clamp(15px, 4.4vw, 18px); line-height: 1.6; color: #b4b5ba; }
.rn-bfh__txt b { color: #fff; }
.rn-bfh__k { margin-top: 22px; font-size: clamp(12px, 3.6vw, 14.5px); font-weight: 800; letter-spacing: .16em; color: #a1a2a8; }
.rn-bfh__clock { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 10px; max-width: 520px; }
.rn-bfh__u { display: flex; flex-direction: column; align-items: center; padding: 12px 4px 10px; border: 1px solid #2c2d33; border-radius: 18px; background: #121316; }
.rn-bfh__u b { font-family: var(--rn-font-round); font-size: clamp(30px, 9vw, 44px); font-weight: 800; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }
.rn-bfh__u span { margin-top: 6px; font-size: 11.5px; font-weight: 800; letter-spacing: .14em; color: #a1a2a8; }
.rn-bfh__u--on { border-color: transparent; background: #22f26a; }
.rn-bfh__u--on b, .rn-bfh__u--on span { color: #04140a; }
.rn-bfh__btn { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 18px; padding: 17px 20px; border-radius: 20px; background: #22f26a; color: #04140a !important; font-family: var(--rn-font-round); font-size: clamp(17px, 5vw, 21px); font-weight: 800; text-decoration: none !important; box-shadow: 0 6px 0 #0d6b34; transition: transform .12s ease, box-shadow .12s ease; }
.rn-bfh__btn:active { transform: translateY(4px); box-shadow: 0 2px 0 #0d6b34; }
@media (min-width: 760px) { .rn-bfh { padding: 32px 30px; } .rn-bfh__btn { max-width: 520px; } }

/* ===== Fitinha da Black Friday (topo) ===== */
.rn-fita { position: relative !important; top: auto !important; z-index: 41; display: flex; align-items: center; gap: 8px; padding: 9px 10px 9px 14px;
  border-bottom: 1px solid #1f5a37; background: linear-gradient(90deg, #050506 0%, #0a2416 55%, #050506 100%); font-family: var(--rn-font-round);
  transition: opacity .25s ease, transform .25s ease; }
.rn-fita[hidden] { display: none; }
.rn-fita--saindo { opacity: 0; transform: translateY(-100%); }
.rn-fita__link { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12px; color: #fff !important; text-decoration: none !important; }
.rn-fita__badge { flex: none; padding: 6px 12px; border-radius: 10px; background: #22f26a; color: #04140a; font-size: clamp(12.5px, 3.8vw, 15px); font-weight: 800; letter-spacing: .06em; }
.rn-fita__txt { flex: none; font-family: var(--rn-font); font-size: clamp(13px, 3.8vw, 15px); font-weight: 600; color: #c4c5ca; }
.rn-fita__cd { font-size: clamp(14px, 4.2vw, 17px); font-weight: 800; color: #fff; white-space: nowrap; font-variant-numeric: tabular-nums; }
.rn-fita__cd b { color: #22f26a; font-weight: 800; }
.rn-fita__x { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border: 0; border-radius: 10px; background: transparent; color: #a1a2a8; cursor: pointer; }
.rn-fita__x:hover { background: rgba(255,255,255,.06); color: #fff; }
@media (max-width: 400px) { .rn-fita__link { gap: 8px; } .rn-fita__badge { padding: 5px 9px; } }
@media (max-width: 350px) { .rn-fita__txt { display: none; } }

/* ===== Página de categoria ===== */
.rn-cat { padding: 20px 18px; border: 1px solid #222327; border-radius: 26px;
  background: radial-gradient(110% 70% at 0% 0%, rgba(34,242,106,.07), transparent 55%), #0f1012; color: #fff; font-family: var(--rn-font); }
.rn-cat__crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14.5px; color: #8d8e93; }
.rn-cat__crumb a { color: #8d8e93 !important; text-decoration: none !important; }
.rn-cat__crumb a:hover { color: #fff !important; }
.rn-cat__here { color: #fff; }
.rn-cat__head { display: flex; align-items: center; gap: 16px; margin-top: 18px; }
.rn-cat__back { flex: none; display: grid; place-items: center; width: 52px; height: 52px; border: 1px solid #2c2d33; border-radius: 16px; background: #141518; color: #fff !important; transition: background .15s ease, border-color .15s ease; }
.rn-cat__back:hover { background: #1d1e22; border-color: #3f4046; }
.rn-cat__title { margin: 0; font-family: var(--rn-font-round); font-size: clamp(28px, 8.6vw, 42px); font-weight: 800; line-height: 1.05; color: #fff; overflow-wrap: anywhere; }
.rn-cat__meta { margin: 4px 0 0; font-size: 14.5px; color: #8d8e93; }
.rn-cat__desc { margin: 18px 0 0; font-size: 15.5px; line-height: 1.65; color: #c4c5ca; }
.rn-cat__banner { display: block; width: 100%; height: auto; margin-top: 18px; border-radius: 18px; border: 1px solid #222327; }
.rn-cat__sort { display: flex; gap: 6px; margin: 14px 0 20px; padding: 8px; overflow-x: auto; border: 1px solid #222327; border-radius: 20px; background: #0f1012; scrollbar-width: none; }
.rn-cat__sort::-webkit-scrollbar { display: none; }
.rn-chip { flex: none; display: inline-flex; align-items: center; gap: 8px; padding: 11px 14px; border: 1px solid transparent; border-radius: 14px; background: transparent; color: #c4c5ca; font: inherit; font-size: 14.5px; font-weight: 600; cursor: pointer; white-space: nowrap; transition: background .15s ease, color .15s ease, border-color .15s ease; }
.rn-chip svg { color: #8d8e93; }
.rn-chip:hover { background: #17181b; color: #fff; }
.rn-chip--on { border-color: #1f5a37; background: rgba(34,242,106,.12); color: #22f26a; }
.rn-chip--on svg { color: #22f26a; }
@media (min-width: 640px) { .rn-cat { padding: 26px 26px; } }

/* ===== Página "Todas as categorias" ===== */
.rn-cats-hero { position: relative; overflow: hidden; margin-bottom: 18px; padding: 22px 18px; border: 1px solid #222327; border-radius: 26px;
  background: radial-gradient(90% 70% at 0% 100%, rgba(34,242,106,.14), transparent 60%), radial-gradient(70% 60% at 100% 0%, rgba(34,242,106,.08), transparent 60%), #0f1012; color: #fff; font-family: var(--rn-font); }
.rn-cats-hero > *:not(.rn-cats-hero__star) { position: relative; }
.rn-cats-hero__star { position: absolute; fill: rgba(34,242,106,.10); pointer-events: none; }
.rn-cats-hero__star--1 { width: 70px; height: 70px; top: 30px; right: 70px; }
.rn-cats-hero__star--2 { width: 26px; height: 26px; top: 120px; right: 30px; fill: rgba(34,242,106,.16); }
.rn-cats-hero__star--3 { width: 40px; height: 40px; bottom: 70px; left: 46%; fill: rgba(255,255,255,.05); }
.rn-cats-hero__title { margin: 16px 0 0; font-family: var(--rn-font-round); font-size: clamp(30px, 9.4vw, 46px); font-weight: 800; line-height: 1.05; color: #fff; }
.rn-cats-hero__txt { margin: 10px 0 0; font-size: 15.5px; line-height: 1.6; color: #c4c5ca; }
.rn-cats-hero__search { display: flex; align-items: center; gap: 12px; margin-top: 18px; padding: 0 18px; border: 1px solid #2c2d33; border-radius: 999px; background: #0b0c0e; color: #8d8e93; transition: border-color .15s ease; }
.rn-cats-hero__search:focus-within { border-color: #22f26a; color: #22f26a; }
.rn-cats-hero__search input { flex: 1; min-width: 0; height: 54px; border: 0; outline: none; background: transparent; color: #fff; font: inherit; font-size: 16px; }
.rn-cats-hero__search input::placeholder { color: #8d8e93; }
.rn-cats-hero__search input::-webkit-search-cancel-button { filter: invert(1) opacity(.5); }
.rn-cats-vazio { margin: 6px 0 16px; padding: 18px; border: 1px dashed #2c2d33; border-radius: 18px; text-align: center; font-size: 14.5px; color: #8d8e93; }
@media (min-width: 640px) { .rn-cats-hero { padding: 28px 28px; } .rn-cats-hero__search { max-width: 520px; } }

/* ===== Barra de compra fixa (página de produto, celular) ===== */
.rn-buybar { display: none; }
@media (max-width: 767px) {
  .rn-buybar {
    position: fixed;
    left: 10px;
    right: 10px;
    bottom: calc(72px + env(safe-area-inset-bottom));
    z-index: 44;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 10px 10px 16px;
    border: 1px solid #26272c;
    border-radius: 22px;
    background: rgba(18, 18, 20, .96);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 -6px 30px rgba(0, 0, 0, .45);
    font-family: var(--rn-font);
    transform: translateY(calc(100% + 90px));
    opacity: 0;
    pointer-events: none;
    transition: transform .3s cubic-bezier(.2,.8,.2,1), opacity .2s ease;
  }
  .rn-buybar--on { transform: translateY(0); opacity: 1; pointer-events: auto; }
  .rn-buybar__price { display: flex; flex-direction: column; min-width: 0; }
  .rn-buybar__k { font-size: 13px; color: #8d8e93; white-space: nowrap; }
  .rn-buybar__v { font-family: var(--rn-font-round); font-size: clamp(20px, 6vw, 26px); font-weight: 800; line-height: 1.1; color: #fff; white-space: nowrap; }
  .rn-buybar__btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 54px;
    padding: 0 14px;
    border: 0;
    border-radius: 16px;
    background: #22f26a;
    color: #04140a;
    font: inherit;
    font-size: 16.5px;
    font-weight: 800;
    box-shadow: 0 4px 0 #0d6b34;
    cursor: pointer;
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .rn-buybar__btn:active { transform: translateY(3px); box-shadow: 0 1px 0 #0d6b34; }
  .rn-buybar__btn--off { background: #2a2b30; color: #8d8e93; box-shadow: none; cursor: not-allowed; }
  html.rn-has-buybar main::after { height: calc(170px + env(safe-area-inset-bottom)); }
}

/* ===== Página de produto: "Sobre este produto" ===== */
.rn-det { border-radius: 24px !important; background: #0f1012 !important; border-color: #222327 !important; }
.rn-det__head { display: flex; align-items: center; gap: 14px; padding: 20px 18px 6px; }
.rn-det__ico { flex: none; display: grid; place-items: center; width: 50px; height: 50px; border: 1px solid #1f5a37; border-radius: 15px; background: rgba(34,242,106,.12); color: #22f26a; }
.rn-det__i-rev { display: none; }
.rn-det--rev .rn-det__i-desc { display: none; }
.rn-det--rev .rn-det__i-rev { display: block; }
.rn-det__k { font-family: var(--rn-font); font-size: 12.5px; font-weight: 800; letter-spacing: .16em; color: #8d8e93; }
.rn-det__t { margin: 4px 0 0; font-family: var(--rn-font-round); font-size: clamp(22px, 6.6vw, 30px); font-weight: 800; line-height: 1.1; color: #fff; }
.rn-det__tabs { display: inline-flex; gap: 4px; margin: 14px 18px 0; padding: 4px; border: 1px solid #222327; border-radius: 14px; background: #0b0c0e; }
.rn-det__tab { padding: 9px 16px; border: 1px solid transparent !important; border-radius: 10px; background: transparent; font-family: var(--rn-font); font-size: 14.5px; font-weight: 700; color: #8d8e93 !important; cursor: pointer; transition: background .15s ease, color .15s ease; }
.rn-det__tab.border-white { border-color: #1f5a37 !important; background: rgba(34,242,106,.12); color: #22f26a !important; }
.rn-det .p-4.sm\:p-6.lg\:p-8 { padding-top: 16px; }
@media (min-width: 640px) { .rn-det__head { padding: 26px 26px 6px; } .rn-det__tabs { margin-left: 26px; } }

/* ===== Barra de atalhos abaixo do cabeçalho ===== */
.rn-catnav { position: relative; border-bottom: 1px solid #1c1d21; background: #08090b; font-family: var(--rn-font); }
.rn-catnav::after { content: ''; position: absolute; top: 0; right: 0; bottom: 0; width: 48px; background: linear-gradient(90deg, transparent, #08090b); pointer-events: none; transition: opacity .2s ease; }
.rn-catnav--fim::after { opacity: 0; }
.rn-catnav__track { display: flex; gap: 10px; max-width: 80rem; margin: 0 auto; padding: 12px 16px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.rn-catnav__track::-webkit-scrollbar { display: none; }
.rn-catnav__chip { flex: none; display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border: 1px solid #2a2b30; border-radius: 999px; background: #141518; color: #c4c5ca !important; font-size: 15px; font-weight: 600; white-space: nowrap; text-decoration: none !important; transition: background .15s ease, border-color .15s ease, color .15s ease; }
.rn-catnav__chip:hover { border-color: #3f4046; color: #fff !important; }
.rn-catnav__chip svg { flex: none; }
.rn-catnav__chip--bf { border-color: #1f8a46; background: #050506; color: #22f26a !important; font-family: var(--rn-font-round); font-weight: 800; }
.rn-catnav__chip--on { border-color: #1f5a37; background: rgba(34,242,106,.12); color: #22f26a !important; }
.rn-catnav__chip--bf.rn-catnav__chip--on { background: rgba(34,242,106,.16); box-shadow: 0 0 0 1px #22f26a inset; }
@media (min-width: 640px) { .rn-catnav__track { padding: 12px 24px; } }

.rn-catnav__sep { flex: none; width: 1px; margin: 6px 2px; background: #2a2b30; }
.rn-catnav__chip--aff svg { color: #2fb5ae; }
.rn-catnav__chip--rules svg { color: #5b8cf0; }
.rn-catnav__chip--cash svg { color: #4fc44f; }
.rn-catnav__chip--on svg { color: currentColor; }

/* ===== Página "Black Friday" ===== */
.rn-bf__hero { margin: 4px 0 18px; padding: 24px 18px; border: 1px solid #1f5a37; border-radius: 26px;
  background: radial-gradient(120% 80% at 100% 0%, rgba(34,242,106,.16), transparent 60%), radial-gradient(80% 60% at 0% 100%, rgba(250,204,21,.08), transparent 60%), #0b0c0e; }
.rn-bf__badge { display: inline-block; padding: 7px 14px; border-radius: 999px; background: #000; border: 1px solid #2c2d33; font-size: 12.5px; font-weight: 800; letter-spacing: .18em; color: #22f26a; }
.rn-bf__title { margin: 14px 0 0; font-family: var(--rn-font-round); font-size: clamp(32px, 9.6vw, 50px); font-weight: 800; line-height: 1.02; color: #fff; }
.rn-bf__title span { color: #22f26a; }
.rn-bf__lead { margin: 12px 0 0; font-size: 15.5px; line-height: 1.6; color: #b4b5ba; }
.rn-bf__timer { margin-top: 18px; }
.rn-bf__timer[hidden] { display: none; }
.rn-bf__timerk { font-size: 12.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #8d8e93; }
.rn-bf__clock { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 8px; max-width: 420px; }
.rn-bf__clock div { display: flex; flex-direction: column; align-items: center; padding: 10px 4px; border: 1px solid #2a2b30; border-radius: 14px; background: #121316; }
.rn-bf__clock b { font-family: var(--rn-font-round); font-size: clamp(26px, 7.6vw, 34px); font-weight: 800; line-height: 1; color: #fff; }
.rn-bf__clock span { margin-top: 4px; font-size: 11.5px; color: #8d8e93; }

.rn-bf__days { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px; border: 1px solid #222327; border-radius: 26px; background: #0f1012; }
@media (min-width: 760px) { .rn-bf__days { grid-template-columns: repeat(3, 1fr); } }
.rn-bf__day { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; padding: 16px; border: 1px solid #2a2b30; border-radius: 20px; background: #16171a; color: #fff !important; text-decoration: none !important; transition: border-color .15s ease, transform .15s ease; }
.rn-bf__day:hover { border-color: #3f4046; transform: translateY(-2px); }
.rn-bf__dk { font-size: 12.5px; font-weight: 700; letter-spacing: .14em; color: #8d8e93; }
.rn-bf__dd { margin-top: 8px; font-family: var(--rn-font-round); font-size: clamp(28px, 8.6vw, 38px); font-weight: 800; line-height: 1; color: #fff; }
.rn-bf__ds { position: relative; z-index: 1; margin-top: 14px; padding: 6px 12px; border: 1px solid #2c2d33; border-radius: 999px; font-size: 13px; font-weight: 600; color: #a1a2a8; }
.rn-bf__dq { position: absolute; right: 12px; bottom: -6px; font-family: var(--rn-font-round); font-size: 76px; font-weight: 800; line-height: 1; color: rgba(255,255,255,.05); }
.rn-bf__day--hoje { border-color: #22f26a; background: linear-gradient(180deg, rgba(34,242,106,.14), #16171a); }
.rn-bf__day--hoje .rn-bf__ds { border-color: #1f5a37; background: rgba(34,242,106,.14); color: #22f26a; }
.rn-bf__day--foi .rn-bf__ds { color: #22f26a; border-color: #1f5a37; }
.rn-bf__day--gold { border-color: #d4a017; background: linear-gradient(180deg, rgba(250,204,21,.16), #16171a 70%); box-shadow: 0 0 0 1px rgba(250,204,21,.18), 0 10px 30px rgba(250,204,21,.08); }
.rn-bf__day--gold .rn-bf__dk { color: #facc15; }
.rn-bf__day--gold .rn-bf__dq { color: rgba(250,204,21,.35); }

.rn-bf__tks { margin-top: 30px; }
.rn-bf__tk { position: relative; display: grid; grid-template-columns: 34% 1fr; margin-top: 14px; border-radius: 24px; overflow: hidden; background: #fff; scroll-margin-top: 100px; }
.rn-bf__tk::before, .rn-bf__tk::after { content: ''; position: absolute; left: calc(34% - 14px); width: 28px; height: 28px; border-radius: 50%; background: #000; z-index: 2; }
.rn-bf__tk::before { top: -14px; }
.rn-bf__tk::after { bottom: -14px; }
.rn-bf__tkl { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 18px 8px; border-right: 3px dashed rgba(0,0,0,.25); background: linear-gradient(180deg, #34e57b, #1fb85a); color: #04140a; }
.rn-bf__pct { font-family: var(--rn-font-round); font-size: clamp(30px, 9vw, 46px); font-weight: 800; line-height: 1; }
.rn-bf__off { font-size: 13px; font-weight: 800; letter-spacing: .3em; }
.rn-bf__tkr { padding: 18px 16px 16px; color: #111; }
.rn-bf__tkk { font-size: 11.5px; font-weight: 800; letter-spacing: .14em; color: #15803d; }
.rn-bf__tkt { margin: 6px 0 10px; font-family: var(--rn-font-round); font-size: clamp(20px, 5.8vw, 28px); font-weight: 800; line-height: 1.1; color: #0b0b0d; }
.rn-bf__li { display: flex; align-items: flex-start; gap: 8px; margin-top: 6px; font-size: 14px; line-height: 1.45; color: #4b4c52; }
