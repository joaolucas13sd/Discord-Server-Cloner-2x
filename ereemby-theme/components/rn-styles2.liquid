.rn-bf__codek { font-size: 11px; font-weight: 800; letter-spacing: .14em; color: #15803d; }
.rn-bf__codev { margin-top: 2px; font-family: var(--rn-font-round); font-size: clamp(17px, 5vw, 24px); font-weight: 800; letter-spacing: .02em; color: #0b0b0d; white-space: nowrap; overflow-wrap: normal; }
.rn-bf__copy { flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 14px; border: 0; border-radius: 12px; background: #0b0b0d; color: #fff; font: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer; }
