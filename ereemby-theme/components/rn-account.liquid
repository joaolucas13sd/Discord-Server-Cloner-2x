{% comment %}
  Rei dos Nitros: ajustes visuais nas páginas da conta (/account), que são montadas pela Ereemby.
  Só roda quando o endereço começa com /account. Não muda textos nem estrutura, só cores e fontes.
{% endcomment %}
<style>
  body.rn-account main h1, body.rn-account main h2, body.rn-account main h3 {
    font-family: 'Baloo 2', 'Arial Rounded MT Bold', system-ui, sans-serif !important;
    font-weight: 800 !important;
    letter-spacing: -.005em;
  }
  body.rn-account .rn-acc-accent { background-color: #22f26a !important; border-color: #22f26a !important; }
  body.rn-account .rn-acc-accent-before::before { background-color: #22f26a !important; border-color: #22f26a !important; }
  body.rn-account .rn-acc-accent-text { color: #22f26a !important; }
  body.rn-account .rn-acc-cta {
    background: #22f26a !important;
    color: #04140a !important;
    border-color: transparent !important;
    border-radius: 12px !important;
    font-weight: 700 !important;
    transition: filter .15s ease, transform .15s ease;
  }
  body.rn-account .rn-acc-cta * { color: inherit !important; }
  body.rn-account .rn-acc-cta svg { stroke: currentColor; }
  body.rn-account .rn-acc-cta:hover { filter: brightness(1.06); transform: translateY(-1px); }
  body.rn-account .rn-acc-card { border-radius: 20px !important; border-color: #2a2a30 !important; }
  body.rn-account .rn-acc-money {
    font-family: 'Baloo 2', 'Arial Rounded MT Bold', system-ui, sans-serif !important;
    font-size: clamp(30px, 8vw, 40px) !important;
    font-weight: 800 !important;
    line-height: 1.1 !important;
    color: #fff !important;
  }

  /* Evento anual de afiliados (inserido na aba Afiliado) */
  .rn-evt { margin: 18px 0 22px; padding: 20px 18px; border: 1px solid #1f5a37; border-radius: 22px;
    background: radial-gradient(120% 80% at 100% 0%, rgba(34,242,106,.14), transparent 60%), #0f1012; color: #fff; font-family: Inter, system-ui, sans-serif; }
  .rn-evt__kicker { display: flex; align-items: center; gap: 10px; font-size: 12.5px; font-weight: 700; letter-spacing: .16em; color: #22f26a; }
  .rn-evt__kicker i { display: block; width: 22px; height: 3px; border-radius: 3px; background: #22f26a; }
  .rn-evt__title { margin: 8px 0 0; font-family: 'Baloo 2', 'Arial Rounded MT Bold', system-ui, sans-serif; font-size: clamp(24px, 7vw, 32px); font-weight: 800; line-height: 1.1; color: #fff; }
  .rn-evt__title span { color: #22f26a; }
  .rn-evt__txt { margin: 10px 0 0; font-size: 14.5px; line-height: 1.6; color: #a1a2a8; }
  .rn-evt__podium { display: grid; gap: 10px; margin-top: 16px; }
  @media (min-width: 640px) { .rn-evt__podium { grid-template-columns: repeat(3, 1fr); } }
  .rn-evt__prize { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1px solid #2a2b30; border-radius: 16px; background: #15161a; }
  .rn-evt__medal { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; font-size: 22px; line-height: 1; }
  .rn-evt__prize--1 { border-color: #a37f16; background: linear-gradient(180deg, rgba(250,204,21,.12), #15161a); }
  .rn-evt__prize--1 .rn-evt__medal { background: rgba(250,204,21,.16); }
  .rn-evt__prize--2 { border-color: #6b7280; }
  .rn-evt__prize--2 .rn-evt__medal { background: rgba(203,213,225,.12); }
  .rn-evt__prize--3 { border-color: #8a4b22; }
  .rn-evt__prize--3 .rn-evt__medal { background: rgba(217,119,6,.14); }
  .rn-evt__pos { font-size: 12px; font-weight: 700; letter-spacing: .1em; color: #8d8e93; }
  .rn-evt__item { margin-top: 2px; font-size: 15.5px; font-weight: 700; line-height: 1.3; color: #fff; }
  .rn-evt__ship { display: flex; align-items: center; gap: 10px; margin-top: 14px; padding: 12px 14px; border-radius: 14px; background: rgba(34,242,106,.08); font-size: 14px; color: #c4c5ca; }
  .rn-evt__ship b { color: #fff; }
  .rn-evt__title { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .rn-evt__trophy { width: 1.15em; height: 1.15em; filter: drop-shadow(0 4px 10px rgba(250,204,21,.35)); }
  .rn-evt__svg { width: 40px; height: 40px; }
  .rn-evt__medal { width: 48px !important; height: 48px !important; }
  .rn-evt__medal { font-size: 0 !important; }
  .rn-evt__shipico { flex: none; width: 22px; height: 22px; color: #22f26a; }

  /* Bloco "Programa de afiliados" (aba Afiliado) */
  .rn-ah { margin: 18px 0 0; padding: 22px 18px; border: 1px solid #1d6b66; border-radius: 24px;
    background: radial-gradient(120% 70% at 100% 100%, rgba(30,128,124,.28), transparent 60%), radial-gradient(90% 60% at 0% 0%, rgba(34,242,106,.10), transparent 60%), #0f1012;
    color: #fff; font-family: Inter, system-ui, sans-serif; }
  .rn-ah__pill { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border: 1px solid #2c2d33; border-radius: 999px; background: #17181b; font-size: 13.5px; font-weight: 700; color: #fff; }
  .rn-ah__pill svg { width: 17px; height: 17px; color: #22f26a; }
  .rn-ah__title { margin: 14px 0 0; font-family: 'Baloo 2', 'Arial Rounded MT Bold', system-ui, sans-serif; font-size: clamp(28px, 8.4vw, 40px); font-weight: 800; line-height: 1.05; color: #fff; }
  .rn-ah__title span { color: #22f26a; }
  .rn-ah__txt { margin: 12px 0 0; font-size: 15.5px; line-height: 1.6; color: #b4b5ba; }
  .rn-ah__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .rn-ah__chip { display: inline-flex; align-items: center; gap: 7px; padding: 9px 14px; border: 1px solid #2c2d33; border-radius: 999px; background: #15161a; font-size: 14px; font-weight: 600; color: #e5e5e5; }
  .rn-ah__chip svg { width: 17px; height: 17px; color: #a1a2a8; }
  .rn-ah__btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .rn-ah__btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 14px 22px; border-radius: 16px; font: inherit; font-size: 15.5px; font-weight: 800; text-decoration: none !important; cursor: pointer; transition: filter .15s ease, transform .15s ease; }
  .rn-ah__btn svg { width: 19px; height: 19px; }
  .rn-ah__btn--main { border: 0; background: #22f26a; color: #04140a !important; box-shadow: 0 8px 22px rgba(34,242,106,.22); }
  .rn-ah__btn--sec { border: 1px solid #34353b; background: #17181b; color: #fff !important; }
  .rn-ah__btn:hover { filter: brightness(1.07); transform: translateY(-1px); }
  .rn-ah__calc { margin-top: 20px; padding: 18px; border: 1px solid #2c2d33; border-radius: 20px; background: #121316; }
  .rn-ah__calct { font-family: 'Baloo 2', 'Arial Rounded MT Bold', system-ui, sans-serif; font-size: 21px; font-weight: 800; color: #fff; }
  .rn-ah__calcs { margin-top: 2px; font-size: 13.5px; color: #8d8e93; }
  .rn-ah__sales { margin-top: 16px; font-size: 14.5px; color: #a1a2a8; }
  .rn-ah__val { margin-top: 4px; font-family: 'Baloo 2', 'Arial Rounded MT Bold', system-ui, sans-serif; font-size: clamp(36px, 11vw, 50px); font-weight: 800; line-height: 1.05; color: #22f26a; }
  .rn-ah__range { -webkit-appearance: none; appearance: none; width: 100%; height: 8px; margin: 18px 0 8px; border-radius: 8px; outline: none;
    background: linear-gradient(90deg, #22f26a var(--p, 33%), #2a2b30 var(--p, 33%)); }
  .rn-ah__range::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%; background: #22f26a; border: 4px solid #0f1012; box-shadow: 0 0 0 2px #22f26a; cursor: pointer; }
  .rn-ah__range::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: #22f26a; border: 4px solid #0f1012; box-shadow: 0 0 0 2px #22f26a; cursor: pointer; }
  .rn-ah__lim { display: flex; justify-content: space-between; font-size: 13px; color: #8d8e93; }
  .rn-ah__note { margin-top: 10px; font-size: 12px; color: #6b6c72; }
</style>
<script>
  (function () {
    function naConta() { return /^\/account/.test(location.pathname); }
    function classe() { document.body.classList.toggle('rn-account', naConta()); }
    classe();
    window.addEventListener('rn:rota', function () { classe(); agendar(); });

    function rgb(str) {
      var m = (str || '').match(/rgba?\(([\d.]+),\s*([\d.]+),\s*([\d.]+)(?:,\s*([\d.]+))?/);
      if (!m) return null;
      return { r: +m[1], g: +m[2], b: +m[3], a: m[4] === undefined ? 1 : +m[4] };
    }
    function laranja(c) { return c && c.a > 0.3 && c.r > 200 && c.g > 110 && c.g < 210 && c.b < 90; }
    function branco(c) { return c && c.a > 0.8 && c.r > 228 && c.g > 228 && c.b > 228; }

    function aplicar() {
      var main = document.querySelector('main') || document.body;
      main.querySelectorAll('*').forEach(function (el) {
        if (el.closest('header') || el.closest('svg')) return;
        var cs = getComputedStyle(el);
        // acentos laranja (fundo, borda ou ::before) -> verde
        if (laranja(rgb(cs.backgroundColor)) || laranja(rgb(cs.borderLeftColor)) && parseFloat(cs.borderLeftWidth) >= 2) el.classList.add('rn-acc-accent');
        var bf = getComputedStyle(el, '::before');
        if (bf && bf.content !== 'none' && laranja(rgb(bf.backgroundColor))) el.classList.add('rn-acc-accent-before');
        if (laranja(rgb(cs.color)) && el.children.length === 0) el.classList.add('rn-acc-accent-text');
        // botões brancos -> botão verde da loja
        if ((el.tagName === 'BUTTON' || el.tagName === 'A') && branco(rgb(cs.backgroundColor))) el.classList.add('rn-acc-cta');
        // cards com borda -> cantos mais arredondados
        if (el.tagName === 'DIV' && parseFloat(cs.borderTopWidth) >= 1 && parseFloat(cs.borderTopLeftRadius) >= 6 && el.offsetHeight > 70) el.classList.add('rn-acc-card');
        // valor em reais sozinho (ex.: carteira) -> destaque
        if (el.children.length === 0 && /^R\$\s?[\d.]+,\d{2}$/.test((el.textContent || '').trim()) && parseFloat(cs.fontSize) >= 18) el.classList.add('rn-acc-money');
      });
    }


    // Evento anual de afiliados: só na aba Afiliado
    function evento() {
      if (!/affiliat|afiliad/i.test(location.pathname) && !/Programa de afiliado/i.test(document.body.innerText || '')) return;
      if (document.getElementById('rn-evt')) return;
      var main = document.querySelector('main') || document.body;
      var alvo = null;
      main.querySelectorAll('h1, h2, h3, p, div, span').forEach(function (el) {
        if (!alvo && el.children.length === 0 && /^\s*Programa de afiliado\s*$/i.test(el.textContent || '')) alvo = el;
      });
      var box = document.createElement('section');
      box.className = 'rn-evt';
      box.id = 'rn-evt';
      box.innerHTML =
        '<div class="rn-evt__kicker"><i></i>EVENTO ANUAL DE AFILIADOS</div>' +
        '<h2 class="rn-evt__title">Competição <span>2027</span><svg class="rn-evt__trophy" viewBox="0 0 48 48" aria-hidden="true"><defs><linearGradient id="rntr" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff3b0"/><stop offset=".5" stop-color="#facc15"/><stop offset="1" stop-color="#b8860b"/></linearGradient></defs><path d="M14 6h20v9a10 10 0 0 1-20 0z" fill="url(#rntr)"/><path d="M14 9H8a1 1 0 0 0-1 1c0 5 3 9 8 9.6M34 9h6a1 1 0 0 1 1 1c0 5-3 9-8 9.6" fill="none" stroke="#facc15" stroke-width="3" stroke-linecap="round"/><path d="M21 25h6v6h-6z" fill="#d4a017"/><rect x="15" y="31" width="18" height="5" rx="2" fill="url(#rntr)"/><rect x="12" y="36" width="24" height="6" rx="2" fill="#3a2a06"/><path d="M19 10l1.2 2.6 2.8.3-2.1 1.9.6 2.8-2.5-1.4-2.5 1.4.6-2.8-2.1-1.9 2.8-.3z" fill="rgba(255,255,255,.75)"/></svg></h2>' +
        '<p class="rn-evt__txt">Além das comissões, todos os afiliados terão a oportunidade de participar de uma competição anual! Os afiliados com os melhores resultados de vendas durante o período da competição disputarão prêmios incríveis:</p>' +
        '<div class="rn-evt__podium">' +
          '<div class="rn-evt__prize rn-evt__prize--1"><span class="rn-evt__medal"><svg class="rn-evt__svg" viewBox="0 0 48 48" aria-hidden="true"><defs><linearGradient id="rnm1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff3b0"/><stop offset=".55" stop-color="#facc15"/><stop offset="1" stop-color="#b8860b"/></linearGradient></defs><path d="M14 3h8l5 13h-8z" fill="#22c55e"/><path d="M34 3h-8l-5 13h8z" fill="#16a34a"/><circle cx="24" cy="30" r="14" fill="url(#rnm1)"/><circle cx="24" cy="30" r="10.5" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.5"/><text x="24" y="35.5" text-anchor="middle" font-family="Baloo 2, Arial Rounded MT Bold, sans-serif" font-weight="800" font-size="15" fill="rgba(0,0,0,.55)">1</text></svg></span><div><div class="rn-evt__pos">1º LUGAR</div><div class="rn-evt__item">PC Gamer avaliado em R$ 5.000</div></div></div>' +
          '<div class="rn-evt__prize rn-evt__prize--2"><span class="rn-evt__medal"><svg class="rn-evt__svg" viewBox="0 0 48 48" aria-hidden="true"><defs><linearGradient id="rnm2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset=".55" stop-color="#cbd5e1"/><stop offset="1" stop-color="#7c8594"/></linearGradient></defs><path d="M14 3h8l5 13h-8z" fill="#22c55e"/><path d="M34 3h-8l-5 13h8z" fill="#16a34a"/><circle cx="24" cy="30" r="14" fill="url(#rnm2)"/><circle cx="24" cy="30" r="10.5" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.5"/><text x="24" y="35.5" text-anchor="middle" font-family="Baloo 2, Arial Rounded MT Bold, sans-serif" font-weight="800" font-size="15" fill="rgba(0,0,0,.55)">2</text></svg></span><div><div class="rn-evt__pos">2º LUGAR</div><div class="rn-evt__item">iPhone 15</div></div></div>' +
          '<div class="rn-evt__prize rn-evt__prize--3"><span class="rn-evt__medal"><svg class="rn-evt__svg" viewBox="0 0 48 48" aria-hidden="true"><defs><linearGradient id="rnm3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffd3a8"/><stop offset=".55" stop-color="#d97706"/><stop offset="1" stop-color="#7c3d12"/></linearGradient></defs><path d="M14 3h8l5 13h-8z" fill="#22c55e"/><path d="M34 3h-8l-5 13h8z" fill="#16a34a"/><circle cx="24" cy="30" r="14" fill="url(#rnm3)"/><circle cx="24" cy="30" r="10.5" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.5"/><text x="24" y="35.5" text-anchor="middle" font-family="Baloo 2, Arial Rounded MT Bold, sans-serif" font-weight="800" font-size="15" fill="rgba(0,0,0,.55)">3</text></svg></span><div><div class="rn-evt__pos">3º LUGAR</div><div class="rn-evt__item">PlayStation 5 (PS5)</div></div></div>' +
        '</div>' +
        '<div class="rn-evt__ship"><svg class="rn-evt__shipico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg><span><b>Entrega dos prêmios:</b> 10/12/2027, com envio pelos Correios.</span></div>';
      if (alvo) {
        // coloca depois do bloco do título (título + texto de apoio)
        var bloco = alvo.parentElement && alvo.parentElement !== main ? alvo.parentElement : alvo;
        bloco.parentNode.insertBefore(box, bloco.nextSibling);
      } else {
        main.insertBefore(box, main.firstChild);
      }
    }


    // ---- CONFIGURAÇÃO do bloco "Programa de afiliados" ----
    // Comissão do afiliado em %. Com 0, o bloco lê a comissão mostrada na própria página (card "Comissão").
    var RN_COMISSAO = 0;
    // -------------------------------------------------------
    function heroAfiliado() {
      if (!document.getElementById('rn-evt') || document.getElementById('rn-ah')) return;
      var box = document.createElement('section');
      box.className = 'rn-ah'; box.id = 'rn-ah';
      box.innerHTML = '<div class="rn-ah__pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>Programa de afiliados</div><h2 class="rn-ah__title" id="rn-ah-title">Indique a Rei dos Nitros e <span>ganhe em cada venda</span></h2><p class="rn-ah__txt" id="rn-ah-txt">Crie seu link de afiliado, mande para amigos, grupos e seguidores e ganhe comissão em cada compra feita por ele. O saque é pelo Pix.</p><div class="rn-ah__chips"><span class="rn-ah__chip"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.2a18.3 18.3 0 0 0-5.5 0L8.6 3a19.7 19.7 0 0 0-4.9 1.4C.5 9-.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2a13 13 0 0 1-1.9-.9l.4-.3a14 14 0 0 0 12.2 0l.4.3-1.9.9 1.3 2a19.8 19.8 0 0 0 6-3c.5-5.2-.8-9.7-3.6-13.7ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.5 8 10.5s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg>Discord</span><span class="rn-ah__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg>WhatsApp</span><span class="rn-ah__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Grupos</span><span class="rn-ah__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>TikTok</span><span class="rn-ah__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>Instagram</span><span class="rn-ah__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>Amigos</span></div><div class="rn-ah__btns"><a class="rn-ah__btn rn-ah__btn--main" href="/como-vender"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>Como vender</a><button type="button" class="rn-ah__btn rn-ah__btn--sec" id="rn-ah-saque"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>Configurar saque</button></div><div class="rn-ah__calc" id="rn-ah-calc" hidden><div class="rn-ah__calct">Quanto dá pra ganhar</div><div class="rn-ah__calcs" id="rn-ah-calcs"></div><div class="rn-ah__sales"><span id="rn-ah-n">30</span> vendas por mês</div><div class="rn-ah__val" id="rn-ah-val">R$ 0,00</div><input class="rn-ah__range" id="rn-ah-range" type="range" min="1" max="300" value="30" aria-label="Vendas por mês"><div class="rn-ah__lim"><span>1</span><span>300 vendas</span></div><div class="rn-ah__note">Simulação. O valor real depende dos produtos vendidos e da comissão de cada um.</div></div>';
      var evt = document.getElementById('rn-evt');
      evt.parentNode.insertBefore(box, evt);

      document.getElementById('rn-ah-saque').addEventListener('click', function () {
        var alvo = null;
        document.querySelectorAll('main *').forEach(function (el) {
          if (alvo || el.closest('#rn-ah') || el.closest('#rn-evt')) return;
          var proprio = Array.prototype.filter.call(el.childNodes, function (n) { return n.nodeType === 3; })
            .map(function (n) { return n.nodeValue; }).join(' ');
          if (/Informações de saque/i.test(proprio)) alvo = el;
        });
        if (!alvo) return;
        var card = alvo.closest('.rn-acc-card') || alvo;
        var header = document.querySelector('header');
        var off = (header ? header.getBoundingClientRect().height : 80) + 16;
        card.style.scrollMarginTop = off + 'px';
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        card.animate && card.animate([{ boxShadow: '0 0 0 0 rgba(34,242,106,0)' }, { boxShadow: '0 0 0 3px rgba(34,242,106,.55)' }, { boxShadow: '0 0 0 0 rgba(34,242,106,0)' }], { duration: 1400, delay: 350 });
      });
      rnLigarComissao();
    }

    var rnComissaoLigada = false;
    function rnLerComissao() {
      if (RN_COMISSAO > 0) return RN_COMISSAO;
      var achado = 0;
      document.querySelectorAll('main *').forEach(function (el) {
        if (achado || el.closest('#rn-ah') || el.closest('#rn-evt') || el.children.length) return;
        if (!/^\s*Comiss[ãa]o\s*$/i.test(el.textContent || '')) return;
        var box = el;
        for (var i = 0; i < 4 && box && !achado; i++) {
          box = box.parentElement;
          var m = box && (box.textContent || '').match(/(\d+(?:[.,]\d+)?)\s*%/);
          if (m) achado = parseFloat(m[1].replace(',', '.'));
        }
      });
      return achado;
    }
    function rnLigarComissao() {
      var ah = document.getElementById('rn-ah');
      if (!ah || ah.getAttribute('data-ok')) return;
      if (rnComissaoLigada && !ah.getAttribute('data-ok')) rnComissaoLigada = false;
      if (rnComissaoLigada) return;
      var pct = rnLerComissao();
      if (!(pct > 0)) return;
      rnComissaoLigada = true;
      ah.setAttribute('data-ok', '1');
      var RN_PCT = pct;
        document.getElementById('rn-ah-title').innerHTML = 'Indique a Rei dos Nitros e ganhe <span>' + RN_PCT + '%</span> de cada venda';
        document.getElementById('rn-ah-txt').textContent = 'Crie seu link de afiliado, mande para amigos, grupos e seguidores e ganhe ' + RN_PCT + '% de cada compra feita por ele. O saque é pelo Pix.';
        // preço médio real dos produtos da loja
        var precos = [];
        (window.CATALOG_PRODUCTS || []).forEach(function (p) {
          var v = p && p.variants_values && p.variants_values.min ? p.variants_values.min.price : p && p.price;
          if (v > 0) precos.push(Number(v));
        });
        var medio = precos.length ? precos.reduce(function (a, b) { return a + b; }, 0) / precos.length : 0;
        if (medio > 0) {
          var fmt = function (v) { return v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); };
          document.getElementById('rn-ah-calc').hidden = false;
          document.getElementById('rn-ah-calcs').textContent = 'Preço médio de ' + fmt(medio) + ' por produto';
          var r = document.getElementById('rn-ah-range');
          var upd = function () {
            var n = +r.value;
            document.getElementById('rn-ah-n').textContent = n;
            document.getElementById('rn-ah-val').textContent = fmt(n * medio * RN_PCT / 100);
            r.style.setProperty('--p', ((n - 1) / 299 * 100) + '%');
          };
          r.addEventListener('input', upd); upd();
          }
    }

    var t;
    function agendar() { clearTimeout(t); t = setTimeout(function () { classe(); if (!naConta()) return; evento(); heroAfiliado(); rnLigarComissao(); aplicar(); }, 120); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', agendar); else agendar();
    new MutationObserver(agendar).observe(document.body, { childList: true, subtree: true });
  })();
</script>
