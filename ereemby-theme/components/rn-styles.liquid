  .rn-bnav__cart { color: #fff !important; }
  .rn-bnav__cartbtn {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin-top: -26px;
    margin-bottom: 2px;
    border-radius: 20px;
    background: linear-gradient(160deg, #4dff8f, #22f26a 55%, #16c955);
    color: #04140a;
    box-shadow: 0 0 0 6px #0c0c0e, 0 10px 26px rgba(34, 242, 106, .35);
    transition: transform .15s ease;
  }
  .rn-bnav__cartbtn svg { width: 27px; height: 27px; }
  .rn-bnav__cart:active .rn-bnav__cartbtn { transform: scale(.92); }
  .rn-bnav__badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 21px;
    height: 21px;
    padding: 0 5px;
    border: 2px solid #0c0c0e;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-family: var(--rn-font);
    font-size: 11px;
    font-weight: 800;
    line-height: 17px;
    text-align: center;
  }
  .rn-bnav__badge[hidden] { display: none; }
  .rn-bnav__badge--pop { animation: rnBadgePop .35s ease; }
  @keyframes rnBadgePop { 50% { transform: scale(1.35); } }

  /* espaço no fim de cada página para a barra não cobrir o conteúdo (CSS puro: o site não consegue apagar) */
  main::after { content: ''; display: block; flex: none; width: 100%; height: calc(84px + env(safe-area-inset-bottom)); }
}
