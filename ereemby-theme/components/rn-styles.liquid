{% comment %} Rei dos Nitros: estilos do tema (incluído em layout/head.liquid). Edite aqui. {% endcomment %}
<style>
/* ===== Rei dos Nitros — estilos do tema ===== */
/* Carregado em layout/head.liquid. A fonte Baloo 2 também é carregada lá. */

:root {
  --rn-bg-card: #121214;
  --rn-border: #2a2a30;
  --rn-green: #35e27a;
  --rn-muted: #8d8e93;
  --rn-font-round: 'Baloo 2', 'Arial Rounded MT Bold', 'Trebuchet MS', system-ui, sans-serif;
  --rn-font: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
}

/* ===== Título de seção reutilizável (kicker verde + título arredondado) ===== */
.rn-kicker {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--rn-green);
  font-size: clamp(12px, 3.6vw, 15px);
  font-weight: 700;
  letter-spacing: .2em;
}
.rn-kicker i {
  display: block;
  width: 26px;
  height: 3px;
  border-radius: 3px;
  background: var(--rn-green);
}
.rn-sec-head { margin-bottom: 22px; }
@media (min-width: 640px) { .rn-sec-head { margin-bottom: 32px; } }
.rn-sec-title {
  margin: 12px 0 0;
  font-family: var(--rn-font-round) !important;
  font-weight: 800 !important;
  font-size: clamp(26px, 8vw, 38px) !important;
  line-height: 1.05 !important;
  color: #fff;
}

/* ===== Comunidade (Discord + WhatsApp) ===== */
.rn-com {
  box-sizing: border-box;
  width: 100%;
  max-width: 960px;
  margin: 0 auto;
  padding: 18px 0 8px;
  color: #fff;
  font-family: var(--rn-font);
}
.rn-com *, .rn-com *::before, .rn-com *::after { box-sizing: border-box; }

.rn-com__track {
  display: flex;
  gap: 12px;
  padding: 0 16px 6px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding: 0 16px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.rn-com__track::-webkit-scrollbar { display: none; }

.rn-com__card {
  flex: 0 0 86%;
  max-width: 440px;
  display: flex;
  flex-direction: column;
  scroll-snap-align: start;
  background: var(--rn-bg-card);
  border: 1px solid var(--rn-border);
  border-radius: 22px;
  overflow: hidden;
}
.rn-com__card--discord { border-color: #3a3f8f; }
.rn-com__card--whats { border-color: #1d6b3c; }

.rn-com__img { display: block; width: 100%; height: auto; }

.rn-com__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 6px;
  padding: 14px;
}
.rn-com__title {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.25;
  color: #fff;
}
.rn-com__desc {
  margin: 0 0 8px;
  font-size: 13.5px;
  line-height: 1.45;
  color: #9a9ba3;
}
.rn-com__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: auto;
  padding: 13px 14px;
  border-radius: 12px;
  color: #fff !important;
  font-size: 14.5px;
  font-weight: 700;
  text-decoration: none !important;
  transition: filter .15s ease, transform .15s ease;
}
.rn-com__btn:hover { filter: brightness(1.1); transform: translateY(-1px); }
.rn-com__btn--discord { background: #5865f2; }
.rn-com__btn--whats { background: #22c55e; color: #04140a !important; }
.rn-com__btn--off {
  background: var(--rn-border);
  color: #9a9ba3 !important;
  pointer-events: none;
}

.rn-com__dots {
  display: flex;
  justify-content: center;
  gap: 7px;
  margin-top: 10px;
}
.rn-com__dot {
  width: 22px;
  height: 4px;
  border-radius: 4px;
  background: #34343b;
  transition: background .2s ease, width .2s ease;
}
.rn-com__dot--on { background: #fff; width: 30px; }

@media (min-width: 720px) {
  .rn-com__track { overflow: visible; padding: 0 16px; }
  .rn-com__card { flex: 1 1 0; max-width: none; }
  .rn-com__dots { display: none; }
}

/* ===== Vantagens ===== */
.rn-perks {
  box-sizing: border-box;
  width: 100%;
  max-width: 960px;
  margin: 0 auto;
  padding: 22px 16px 8px;
  color: #fff;
  font-family: var(--rn-font);
}
.rn-perks *, .rn-perks *::before, .rn-perks *::after { box-sizing: border-box; }

.rn-perks__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: var(--rn-border);
  border: 1px solid var(--rn-border);
  border-radius: 24px;
  overflow: hidden;
}
.rn-perk {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 20px 14px;
  background: var(--rn-bg-card);
}
.rn-perk__ico {
  flex: none;
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  color: var(--rn-green);
}
.rn-perk__ico svg { width: 26px; height: 26px; }
.rn-perk__t {
  font-size: clamp(14px, 4.2vw, 18px);
  font-weight: 700;
  line-height: 1.25;
  color: #fff;
}
.rn-perk__s {
  margin-top: 3px;
  font-size: clamp(12.5px, 3.6vw, 15px);
  line-height: 1.4;
  color: var(--rn-muted);
}

/* ===== Cabeçalho "O que você procura hoje?" + botão "Ver todas" ===== */
.rn-cats {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 24px;
}
.rn-cats__btn {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 20px;
  border: 1.5px solid #2f2f36;
  border-radius: 999px;
  background: var(--rn-bg-card);
  color: #fff !important;
  font-size: clamp(13px, 3.8vw, 16px);
  font-weight: 600;
  text-decoration: none !important;
  white-space: nowrap;
  transition: border-color .15s ease;
}
.rn-cats__btn:hover { border-color: #4a4a54; }

/* ===== Card de produto ===== */
.rn-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #131416;
  border: 1px solid #2c2d31;
  border-radius: 22px;
  padding: 12px;
  color: #fff;
  text-decoration: none !important;
  transition: transform .15s ease, border-color .15s ease;
}
.rn-card:hover { transform: translateY(-2px); border-color: #43444a; }

.rn-card__media {
  position: relative;
  aspect-ratio: 16 / 9;
  border-radius: 14px;
  overflow: hidden;
  background: #1b1c1f;
}
.rn-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}
.rn-card:hover .rn-card__img { transform: scale(1.05); }
.rn-card__noimg {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #404040;
}

.rn-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10px;
  padding-top: 10px;
}
.rn-card__title {
  margin: 0;
  font-family: var(--rn-font-round);
  font-size: 18px;
  font-weight: 800;
  line-height: 1.15;
  color: #fff;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.rn-cashback {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0 0 8px;
  font-size: 13px;
  font-weight: 500;
  color: #3de07f;
}
.rn-cashback svg { width: 15px; height: 15px; flex: none; }

.rn-from { font-size: 12px; color: var(--rn-muted); }

.rn-old { display: flex; align-items: center; gap: 6px; }
.rn-old__price { font-size: 12px; color: #6b6c72; text-decoration: line-through; }
.rn-old__off { font-size: 12px; font-weight: 700; color: #4ade80; }

.rn-price {
  font-size: 22px;
  font-weight: 800;
  line-height: 1.15;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rn-pix { font-size: 12px; color: var(--rn-muted); }
.rn-pix--off { color: #f87171; }

@media (max-width: 400px) {
  .rn-card { padding: 9px; border-radius: 18px; }
  .rn-card__title { font-size: 16px; }
  .rn-price { font-size: 19px; }
  .rn-cashback { font-size: 12px; }
}

/* ===== Perguntas frequentes ===== */
.rn-faq {
  box-sizing: border-box;
  width: 100%;
  max-width: 960px;
  margin: 0 auto;
  padding: 40px 16px 48px;
  color: #fff;
  font-family: var(--rn-font);
}
.rn-faq *, .rn-faq *::before, .rn-faq *::after { box-sizing: border-box; }

.rn-faq__title {
  margin: 12px 0 18px;
  font-family: var(--rn-font-round);
  font-weight: 800;
  font-size: clamp(26px, 8vw, 38px);
  line-height: 1.05;
  color: #fff;
}
.rn-faq__item {
  margin-bottom: 10px;
  background: var(--rn-bg-card);
  border: 1px solid var(--rn-border);
  border-radius: 20px;
  transition: border-color .15s ease;
}
.rn-faq__item[open] { border-color: #1f7a45; }

.rn-faq__q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 19px 18px;
  list-style: none;
  cursor: pointer;
  font-size: clamp(14px, 4vw, 17px);
  font-weight: 600;
  line-height: 1.3;
  color: #fff;
  -webkit-tap-highlight-color: transparent;
}
.rn-faq__q::-webkit-details-marker { display: none; }
.rn-faq__q::marker { content: ''; }

.rn-faq__ico {
  flex: none;
  position: relative;
  width: 16px;
  height: 16px;
  color: #a7a8ae;
}
.rn-faq__ico::before, .rn-faq__ico::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14px;
  height: 2px;
  margin: -1px 0 0 -7px;
  border-radius: 2px;
  background: currentColor;
  transition: transform .2s ease;
}
.rn-faq__ico::after { transform: rotate(90deg); }
.rn-faq__item[open] .rn-faq__ico { color: var(--rn-green); }
.rn-faq__item[open] .rn-faq__ico::before { transform: rotate(45deg); }
.rn-faq__item[open] .rn-faq__ico::after { transform: rotate(-45deg); }

.rn-faq__a {
  padding: 0 18px 20px;
  font-size: clamp(14px, 3.9vw, 16px);
  line-height: 1.65;
  color: #9a9ba3;
}
.rn-faq__a b { color: #fff; font-weight: 600; }

/* ===== Página de produto: painel de compra ===== */
.rn-buy {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 22px 20px;
  border: 1px solid #2a2b30;
  border-radius: 28px;
  background: linear-gradient(180deg, rgba(30, 31, 34, .92), rgba(18, 18, 20, .96));
  box-shadow: 0 20px 50px rgba(0, 0, 0, .45);
  color: #fff;
  font-family: var(--rn-font);
}
.rn-buy__title {
  margin: 0;
  font-family: var(--rn-font-round);
  font-size: clamp(24px, 6.4vw, 30px);
  font-weight: 800;
  line-height: 1.1;
  color: #fff;
}
.rn-buy__sub {
  margin: 6px 0 0;
  font-size: clamp(15px, 4.2vw, 18px);
  font-weight: 600;
  line-height: 1.3;
  color: #a1a2a8;
}

/* Estoque + Entrega */
.rn-tiles {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 8px;
  padding: 8px;
  border: 1px solid #26272c;
  border-radius: 20px;
  background: rgba(0, 0, 0, .25);
}
.rn-tile {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
  border: 1px solid #2c2d33;
  border-radius: 14px;
  background: #18191c;
}
.rn-tile__ico {
  flex: none;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 1px solid #1f5a37;
  border-radius: 10px;
  background: rgba(53, 226, 122, .08);
  color: var(--rn-green);
}
.rn-tile__ico svg { width: 18px; height: 18px; }
.rn-tile__k {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #8d8e93;
}
.rn-tile__v {
  font-size: 14px;
  font-weight: 700;
  line-height: 1.25;
  color: #fff;
  overflow-wrap: anywhere;
}
.rn-tile__v.text-green-400 { color: #fff !important; }

/* Avaliações */
.rn-rating {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  column-gap: 12px;
  row-gap: 6px;
  width: 100%;
  padding: 14px 18px;
  border: 1px solid #26272c;
  border-radius: 18px;
  background: rgba(0, 0, 0, .25);
  color: #fff;
  font: inherit;
  text-align: left;
  text-decoration: none !important;
  cursor: pointer;
}
.rn-rating__stars { display: flex; gap: 2px; }
.rn-rating__star {
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  color: #facc15;
}
.rn-rating__star svg { width: 18px; height: 18px; }
.rn-rating__star--tp { background: #00b67a; color: #fff; }
.rn-rating__star--tp svg { width: 15px; height: 15px; }
.rn-rating__star--off { color: #3a3b40; }
.rn-rating__t { font-size: 15px; font-weight: 700; }
.rn-rating__link { grid-column: 1 / -1; font-size: 13.5px; color: #b794f6; }

/* Preço */
.rn-buy__old { display: flex; align-items: center; gap: 8px; min-height: 0; }
.rn-buy__strike { font-size: 14px; color: #6b6c72; text-decoration: line-through; }
.rn-buy__off { font-size: 13px; font-weight: 700; color: #4ade80; }
.rn-buy__value {
  font-family: var(--rn-font-round);
  font-size: clamp(36px, 11vw, 46px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -.01em;
  color: #fff;
}
.rn-buy__pix { margin: 6px 0 0; font-size: 14px; color: #8d8e93; }

/* Variações */
.rn-opts { padding-top: 16px; border-top: 1px solid #26272c; }
.rn-opts__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.rn-opts__t { font-size: 14px; font-weight: 700; }
.rn-opts__s { font-size: 13px; color: #8d8e93; }
.rn-opts__list { display: flex; flex-direction: column; gap: 10px; max-height: 520px; overflow-y: auto; }
.rn-opt {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  width: 100%;
  padding: 16px;
  border: 1px solid #2c2d33 !important;
  border-radius: 16px;
  background: #18191c !important;
  color: #fff !important;
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: border-color .15s ease, background .15s ease;
}
.rn-opt:hover { border-color: #3f4046 !important; }
.rn-opt.rn-opt--on {
  border-color: #2fd16c !important;
  background: linear-gradient(180deg, rgba(34, 197, 94, .16), rgba(34, 197, 94, .07)) !important;
}
.rn-opt--out { opacity: .55; }
.rn-opt__radio {
  flex: none;
  position: relative;
  width: 20px;
  height: 20px;
  margin-top: 2px;
  border: 2px solid #6b6c72;
  border-radius: 50%;
  background: transparent !important;
}
.rn-opt__radio.border-white { border-color: #35e27a !important; }
.rn-opt__radio.border-white::after {
  content: '';
  position: absolute;
  inset: 3px;
  border-radius: 50%;
  background: #35e27a;
}
.rn-opt__body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.rn-opt__name { font-size: 15.5px; font-weight: 600; line-height: 1.35; }
.rn-opt__stock { font-size: 13px; color: #35e27a; }
.rn-opt__stock--out { color: #f87171; }
.rn-opt__price { margin-top: 4px; font-size: 16px; font-weight: 600; }
.rn-opt__price s { margin-left: 6px; font-size: 13px; font-weight: 400; color: #6b6c72; }

/* Quantidade */
.rn-qty { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; }
.rn-qty__t { font-size: 14px; font-weight: 700; }
.rn-qty__box {
  display: flex;
  overflow: hidden;
  border: 1px solid #2c2d33;
  border-radius: 12px;
  background: #18191c;
}
.rn-qty__box button {
  width: 40px;
  height: 40px;
  border: 0;
  background: transparent;
  color: #a1a2a8;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
}
.rn-qty__box button:hover { background: #222327; color: #fff; }
.rn-qty__box input {
  width: 48px;
  border: 0;
  border-inline: 1px solid #2c2d33;
  background: transparent;
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  outline: none;
}
.rn-qty__max { font-size: 12.5px; color: #6b6c72; }

/* Cashback (detalhes) */
.rn-acc { border-top: 1px solid #26272c; border-bottom: 1px solid #26272c; }
.rn-acc__sum {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 0;
  list-style: none;
  cursor: pointer;
}
.rn-acc__sum::-webkit-details-marker { display: none; }
.rn-acc__sum::marker { content: ''; }
.rn-acc__ico { display: grid; place-items: center; color: var(--rn-green); }
.rn-acc__ico svg { width: 18px; height: 18px; }
.rn-acc__t { flex: 1; font-size: 14.5px; color: #c4c5ca; }
.rn-acc__more { display: inline-flex; align-items: center; gap: 4px; font-size: 13.5px; color: #8d8e93; }
.rn-acc__more svg { width: 16px; height: 16px; transition: transform .2s ease; }
.rn-acc__item[open] .rn-acc__more svg { transform: rotate(180deg); }
.rn-acc__body { padding: 0 0 16px 28px; font-size: 14px; line-height: 1.6; color: #9a9ba3; }

/* Botões */
.rn-actions { display: flex; flex-direction: column; gap: 12px; }
.rn-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  min-height: 60px;
  padding: 14px 18px;
  border-radius: 18px;
  font: inherit;
  font-size: 17px;
  font-weight: 700;
  cursor: pointer;
  transition: filter .15s ease, transform .15s ease, background .15s ease;
}
.rn-btn svg { width: 20px; height: 20px; flex: none; }
.rn-btn--buy {
  border: 0;
  background: #22f26a;
  color: #04140a;
  box-shadow: 0 10px 30px rgba(34, 242, 106, .25);
}
.rn-btn--buy:hover { filter: brightness(1.06); transform: translateY(-1px); }
.rn-btn--cart {
  border: 1px solid #3a3b41;
  background: rgba(255, 255, 255, .03);
  color: #fff;
}
.rn-btn--cart:hover { background: rgba(255, 255, 255, .07); }
.rn-btn--off,
.rn-btn:disabled {
  border: 1px solid #2c2d33;
  background: #1c1d20;
  color: #6b6c72;
  box-shadow: none;
  cursor: not-allowed;
  transform: none;
  filter: none;
}

/* Garantias */
.rn-trust {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0;
  padding: 16px 0 0;
  border-top: 1px solid #26272c;
  list-style: none;
}
.rn-trust li { display: flex; align-items: flex-start; gap: 12px; font-size: 14.5px; line-height: 1.45; color: #a1a2a8; }
.rn-trust svg { flex: none; width: 20px; height: 20px; color: var(--rn-green); }
.rn-trust b { color: #fff; font-weight: 600; }

/* Favoritos e compartilhar */
.rn-buy__extra { display: flex; justify-content: center; gap: 22px; }
.rn-buy__extra button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 0;
  background: none;
  color: #6b6c72;
  font: inherit;
  font-size: 13px;
  cursor: pointer;
}
.rn-buy__extra button:hover { color: #fff; }
.rn-buy__extra svg { width: 17px; height: 17px; }

@media (max-width: 420px) {
  .rn-buy { padding: 18px 14px; border-radius: 24px; }
  .rn-tiles { gap: 6px; padding: 6px; }
  .rn-tile { gap: 8px; padding: 8px; }
  .rn-tile__ico { width: 30px; height: 30px; }
  .rn-tile__k { font-size: 10.5px; letter-spacing: .08em; }
  .rn-tile__v { font-size: 13px; }
}

/* ===== Cabeçalho: nome da loja + botões ===== */
.rn-hrow { height: 76px !important; gap: 10px; }
.rn-hrow > div:first-child,
.rn-hrow > div:first-child > div { min-width: 0; flex: 1 1 auto; }
.rn-hrow > div:last-child { flex: none; }
.rn-hrow a:has(> .rn-brand) { min-width: 0; padding-right: 0 !important; }
.rn-brand {
  font-family: var(--rn-font-round);
  font-size: clamp(20px, 6vw, 28px);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -.01em;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: unset !important;
  display: block !important;
}
.rn-brand__logo { width: 40px; height: 40px; border-radius: 12px; }

.rn-hbtn {
  position: relative;
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 46px;
  height: 46px;
  padding: 0 11px;
  border: 1px solid #2a2b30;
  border-radius: 14px;
  background: #1b1c1f;
  color: #fff !important;
  text-decoration: none !important;
  transition: background .15s ease, border-color .15s ease, transform .15s ease;
}
.rn-hbtn:hover { background: #24252a; border-color: #3a3b41; }
.rn-hbtn:active { transform: scale(.96); }
.rn-hbtn svg { width: 22px; height: 22px; flex: none; }
.rn-hbtn--green {
  border-color: transparent;
  background: #22f26a;
  color: #04140a !important;
}
.rn-hbtn--green:hover { background: #3cf57d; border-color: transparent; }
.rn-hbtn--green svg { width: 24px; height: 24px; }
.rn-hbtn--green #cart-badge { background: #fff; color: #000; border-color: #0d0e10; }
.rn-hbtn__ico { display: inline-flex; }
#cart-wrapper { order: 10; }

/* botões que só existem no celular */
@media (min-width: 640px) {
  #mobile-search-btn.rn-hbtn,
  a.rn-hbtn[href="/login"] { display: none !important; }
}
@media (max-width: 639px) {
  .rn-hrow { gap: 8px; }
  .rn-hrow > div:last-child { gap: 6px !important; }
  .rn-brand { font-size: clamp(14px, 4.5vw, 24px); }
  .rn-hrow a:has(> .rn-brand) { gap: 7px; }
  .rn-hbtn { min-width: 40px; height: 40px; padding: 0 9px; border-radius: 12px; }
  .rn-hbtn svg { width: 20px; height: 20px; }
  .rn-brand__logo { width: 36px; height: 36px; border-radius: 11px; }
}
@media (max-width: 370px) {
  .rn-hbtn { min-width: 36px; height: 36px; padding: 0 7px; border-radius: 11px; }
  .rn-hbtn svg { width: 18px; height: 18px; }
  .rn-brand__logo { width: 32px; height: 32px; }
}

/* ===== Vitrine "Últimas Decorações Lançadas" ===== */
.rn-deco {
  position: relative;
  overflow: hidden;
  padding: 26px 0 24px;
  border: 1px solid #26272c;
  border-radius: 28px;
  background:
    radial-gradient(120% 70% at 100% 0%, rgba(34, 242, 106, .10), transparent 55%),
    #0d0e11;
  color: #fff;
  font-family: var(--rn-font);
}
.rn-deco__head { padding: 0 22px; }
.rn-deco__kicker {
  font-size: clamp(12px, 3.6vw, 15px);
  font-weight: 700;
  letter-spacing: .14em;
  color: #a1a2a8;
}
.rn-deco__title {
  margin: 10px 0 0;
  font-family: var(--rn-font-round);
  font-size: clamp(28px, 8.4vw, 40px);
  font-weight: 800;
  line-height: 1.05;
  color: #fff;
}
.rn-deco__title span { color: #22f26a; }
.rn-deco__btn {
  border: 0;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 18px;
  padding: 15px 26px;
  border-radius: 999px;
  background: #22f26a;
  color: #04140a !important;
  font-family: var(--rn-font-round);
  font-size: clamp(16px, 4.6vw, 19px);
  font-weight: 800;
  text-decoration: none !important;
  transition: filter .15s ease, transform .15s ease;
}
.rn-deco__btn:hover { filter: brightness(1.06); transform: translateY(-1px); }

.rn-deco__track {
  display: flex;
  gap: 14px;
  margin-top: 28px;
  padding: 0 22px 4px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding: 0 22px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.rn-deco__track::-webkit-scrollbar { display: none; }

.rn-deco__card {
  position: relative;
  flex: 0 0 min(72%, 260px);
  aspect-ratio: 4 / 5;
  overflow: hidden;
  scroll-snap-align: start;
  border: 1px solid #2c2d33;
  border-radius: 24px;
  background: linear-gradient(180deg, #2a2b30 0%, #16171a 60%, #0e0f11 100%);
  color: #fff !important;
  text-decoration: none !important;
  transition: transform .15s ease, border-color .15s ease;
}
.rn-deco__card:hover { transform: translateY(-3px); border-color: #3f4046; }
.rn-deco__media { position: absolute; inset: 0; display: grid; place-items: center; padding: 14% 12% 34%; }
.rn-deco__media img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 10px 24px rgba(0, 0, 0, .5)); }
.rn-deco__info {
  position: absolute;
  inset: auto 0 0 0;
  padding: 40px 16px 16px;
  background: linear-gradient(180deg, transparent, rgba(8, 9, 11, .85) 45%, rgba(8, 9, 11, .95));
}
.rn-deco__badge {
  display: inline-block;
  padding: 4px 12px;
  border: 2px solid #0d0e11;
  border-radius: 10px;
  background: #fff;
  box-shadow: 3px 3px 0 #0d0e11;
  color: #000;
  font-size: 13px;
  font-style: italic;
  font-weight: 900;
  letter-spacing: .04em;
  transform: rotate(-2deg);
}
.rn-deco__name {
  margin: 10px 0 0;
  font-family: var(--rn-font-round);
  font-size: clamp(18px, 5.2vw, 22px);
  font-weight: 800;
  line-height: 1.15;
  color: #fff;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.rn-deco__prices { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; margin-top: 6px; }
.rn-deco__price { font-size: clamp(19px, 5.4vw, 23px); font-weight: 800; color: #fff; }
.rn-deco__old { font-size: 14px; color: #8d8e93; }

@media (min-width: 640px) {
  .rn-deco { padding: 34px 0 30px; }
  .rn-deco__head, .rn-deco__track { padding-left: 32px; padding-right: 32px; }
  .rn-deco__track { scroll-padding: 0 32px; }
  .rn-deco__card { flex-basis: 240px; }
}

/* ===== Vitrine "Jogos Steam em destaque" ===== */
.rn-steam { color: #fff; font-family: var(--rn-font); }
.rn-steam__head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 18px; }
.rn-steam__title {
  margin: 0;
  font-family: var(--rn-font-round);
  font-size: clamp(26px, 7.6vw, 38px);
  font-weight: 800;
  line-height: 1.05;
  color: #fff;
}
.rn-steam__all {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 20px;
  border: 1.5px solid #2f2f36;
  border-radius: 999px;
  background: #121214;
  color: #fff !important;
  font-size: clamp(14px, 4vw, 17px);
  font-weight: 600;
  text-decoration: none !important;
  white-space: nowrap;
}
.rn-steam__all:hover { border-color: #4a4a54; }

.rn-steam__track {
  display: flex;
  align-items: stretch;
  gap: 14px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.rn-steam__track::-webkit-scrollbar { display: none; }

.rn-steam__card {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 0 0 100%;
  overflow: hidden;
  scroll-snap-align: start;
  border: 1px solid #2c2d33;
  border-radius: 28px;
  background: #121316;
}
.rn-steam__card::before {
  content: '';
  position: absolute;
  inset: -40px;
  background: var(--rn-bg) center / cover no-repeat;
  filter: blur(40px) saturate(1.2);
  opacity: .16;
  pointer-events: none;
}
.rn-steam__link { position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
.rn-steam__hero {
  position: relative;
  margin: 12px 12px 0;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: 20px;
  background: #0b0c0e;
}
/* preenche as sobras com a própria arte desfocada, sem faixas pretas */
.rn-steam__hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--rn-bg) center / cover no-repeat;
  filter: blur(18px) brightness(.7);
  transform: scale(1.15);
}
.rn-steam__hero img {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.rn-steam__trailer {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 16px 6px 6px;
  border: 1px solid rgba(255, 255, 255, .16);
  border-radius: 999px;
  background: rgba(12, 12, 14, .55);
  -webkit-backdrop-filter: blur(10px) saturate(1.4);
  backdrop-filter: blur(10px) saturate(1.4);
  box-shadow: 0 6px 20px rgba(0, 0, 0, .35);
  color: #fff;
  font: inherit;
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: .01em;
  cursor: pointer;
  transition: background .15s ease, transform .15s ease, border-color .15s ease;
}
.rn-steam__play {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #22f26a;
  color: #04140a;
  box-shadow: 0 0 0 4px rgba(34, 242, 106, .18);
  transition: box-shadow .2s ease;
}
.rn-steam__play svg { width: 12px; height: 12px; margin-left: 2px; }
.rn-steam__trailer:hover { background: rgba(20, 20, 24, .75); border-color: rgba(255, 255, 255, .28); transform: translateY(-1px); }
.rn-steam__trailer:hover .rn-steam__play { box-shadow: 0 0 0 6px rgba(34, 242, 106, .22); }
.rn-steam__trailer:active { transform: scale(.97); }

.rn-steam__body { position: relative; flex: 1; display: flex; flex-direction: column; padding: 16px 20px 22px; }
.rn-steam__foot { margin-top: auto !important; padding-top: 18px; }
.rn-steam__name {
  margin: 0;
  font-size: clamp(19px, 5.6vw, 24px);
  font-weight: 700;
  line-height: 1.2;
  text-transform: uppercase;
  color: #fff;
}
.rn-steam__shots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 16px; }
.rn-steam__shots img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border: 1px solid #34353b;
  border-radius: 10px;
  display: block;
}
.rn-steam__foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-top: 18px; }
.rn-steam__logo {
  display: grid;
  place-items: center;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #fff;
  color: #121316;
}
.rn-steam__logo svg { width: 40px; height: 40px; }
.rn-steam__prices { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
.rn-steam__old { font-size: 15px; color: #8d8e93; }
.rn-steam__now { display: flex; align-items: center; gap: 10px; }
.rn-steam__price { font-size: clamp(26px, 7.6vw, 32px); font-weight: 800; line-height: 1; color: #fff; }
.rn-steam__off {
  padding: 6px 10px;
  border-radius: 10px;
  background: #22f26a;
  color: #04140a;
  font-size: clamp(15px, 4.4vw, 18px);
  font-weight: 800;
}

.rn-steam__dots { display: flex; justify-content: center; gap: 10px; margin-top: 18px; }
.rn-steam__dot {
  width: 9px;
  height: 9px;
  padding: 0;
  border: 0;
  border-radius: 9px;
  background: #5b5c62;
  cursor: pointer;
  transition: width .2s ease, background .2s ease;
}
.rn-steam__dot--on { width: 28px; background: #22f26a; }

@media (min-width: 768px) {
  .rn-steam__card { flex-basis: calc(50% - 7px); }
}
@media (min-width: 1200px) {
  .rn-steam__card { flex-basis: calc(33.333% - 10px); }
}

/* Janela do trailer */
.rn-trailer {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: grid;
  place-items: center;
  padding: 16px;
  background: rgba(0, 0, 0, .82);
}
.rn-trailer[hidden] { display: none; }
.rn-trailer__box { position: relative; width: min(960px, 100%); }
.rn-trailer__frame { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 16px; background: #000; }
.rn-trailer__frame iframe { display: block; width: 100%; height: 100%; border: 0; }
.rn-trailer__yt { display: block; margin-top: 12px; text-align: center; font-size: 13.5px; color: #a1a2a8 !important; text-decoration: none !important; }
.rn-trailer__yt:hover { color: #fff !important; }
.rn-trailer__close {
  position: absolute;
  top: -48px;
  right: 0;
  width: 40px;
  height: 40px;
  border: 1px solid #3a3b41;
  border-radius: 12px;
  background: #1b1c1f;
  color: #fff;
  font-size: 18px;
  cursor: pointer;
}

/* ===== Página de produto: "Você também pode gostar" ===== */
.rn-rel-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
.rn-rel-kicker {
  font-family: var(--rn-font);
  font-size: clamp(13px, 3.8vw, 16px);
  font-weight: 700;
  letter-spacing: .14em;
  color: var(--rn-green);
}
.rn-rel-title {
  margin: 8px 0 0;
  font-family: var(--rn-font-round);
  font-size: clamp(18px, 5.25vw, 36px);
  font-weight: 800;
  line-height: 1.08;
  color: #fff;
}
.rn-rel-nav { flex: none; display: flex; gap: 10px; }
.rn-rel-btn {
  display: grid;
  place-items: center;
  width: 54px;
  height: 54px;
  border: 1px solid #34353b;
  border-radius: 18px;
  background: #141518;
  color: #fff;
  cursor: pointer;
  transition: background .15s ease, border-color .15s ease, transform .15s ease, opacity .15s ease;
}
.rn-rel-btn:hover:not(:disabled) { background: #1d1e22; border-color: #4a4b52; }
.rn-rel-btn:active:not(:disabled) { transform: scale(.95); }
.rn-rel-btn:disabled { opacity: .4; cursor: default; border-color: #26272c; }
@media (max-width: 480px) {
  .rn-rel-head { gap: 12px; }
  .rn-rel-btn { width: 42px; height: 42px; border-radius: 14px; }
  .rn-rel-btn svg { width: 19px; height: 19px; }
  .rn-rel-nav { gap: 8px; }
  .rn-rel-kicker { font-size: 12.5px; }
}

/* ===== Cards "Torne-se um Afiliado" + "Regras e Termos" ===== */
.rn-aff {
  box-sizing: border-box;
  width: 100%;
  max-width: 960px;
  margin: 0 auto;
  padding: 24px 0 0;
  font-family: var(--rn-font);
}
.rn-aff__track {
  display: flex;
  gap: 12px;
  padding: 0 16px 6px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding: 0 16px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.rn-aff__track::-webkit-scrollbar { display: none; }
.rn-aff__card {
  flex: 0 0 86%;
  max-width: 440px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  scroll-snap-align: start;
  border: 1px solid #1d6b66;
  border-radius: 22px;
  background: #121214;
}
.rn-aff__card--rules { border-color: #2c52a6; }
.rn-aff__img { display: block; width: 100%; height: auto; aspect-ratio: 18 / 5; object-fit: cover; background: #18191c; }
.rn-aff__body { display: flex; flex: 1; flex-direction: column; gap: 6px; padding: 14px 14px 14px; }
.rn-aff__title { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.25; color: #fff; }
.rn-aff__desc { margin: 0 0 8px; font-size: 13.5px; line-height: 1.45; color: #9a9ba3; }
.rn-aff__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: auto;
  padding: 13px 14px;
  border-radius: 12px;
  background: #1e807c;
  color: #fff !important;
  font-size: 14.5px;
  font-weight: 700;
  text-decoration: none !important;
  transition: filter .15s ease, transform .15s ease;
}
.rn-aff__btn:hover { filter: brightness(1.12); transform: translateY(-1px); }
.rn-aff__btn--rules { background: #3b6fd4; color: #fff !important; }
.rn-aff__card--cash { border-color: #2f8a2f; }
.rn-aff__btn--cash { background: #4fc44f; color: #04140a !important; }
.rn-aff__dots { display: flex; justify-content: center; gap: 7px; margin-top: 10px; }
.rn-aff__dot { width: 22px; height: 4px; border-radius: 4px; background: #34343b; transition: background .2s ease, width .2s ease; }
.rn-aff__dot--on { background: #fff; width: 30px; }
@media (min-width: 720px) {
  .rn-aff__track { overflow: visible; padding: 0 16px; }
  .rn-aff__card { flex: 1 1 0; max-width: none; }
  .rn-aff__dots { display: none; }
}

/* ===== Página "Regras e Termos" ===== */
.rn-terms { box-sizing: border-box; width: 100%; max-width: 860px; margin: 0 auto; padding: 18px 16px 56px; color: #fff; font-family: var(--rn-font); }
.rn-terms__crumb { display: flex; gap: 8px; align-items: center; margin-bottom: 16px; font-size: 14px; color: #8d8e93; }
.rn-terms__crumb a { color: #8d8e93 !important; text-decoration: none !important; }
.rn-terms__crumb a:hover { color: #fff !important; }
.rn-terms__crumb span:last-child { color: #e5e5e5; }
.rn-terms__banner { display: block; width: 100%; height: auto; border: 1px solid #26272c; border-radius: 22px; }
.rn-terms__head { margin: 26px 0 20px; }
.rn-terms__title { margin: 10px 0 0; font-family: var(--rn-font-round); font-size: clamp(30px, 9vw, 46px); font-weight: 800; line-height: 1.05; color: #fff; }
.rn-terms__lead { margin: 10px 0 0; font-size: 15px; line-height: 1.6; color: #9a9ba3; }
.rn-terms__date { display: inline-block; margin-top: 14px; padding: 6px 12px; border: 1px solid #26272c; border-radius: 999px; background: #121214; font-size: 12.5px; color: #a1a2a8; }

.rn-terms__toc { margin-bottom: 18px; border: 1px solid #26272c; border-radius: 20px; background: #121214; }
.rn-terms__toc summary { padding: 16px 18px; font-weight: 700; cursor: pointer; list-style: none; }
.rn-terms__toc summary::-webkit-details-marker { display: none; }
.rn-terms__toc summary::after { content: '+'; float: right; color: #8d8e93; }
.rn-terms__toc[open] summary::after { content: '−'; }
.rn-terms__toc ol { display: grid; gap: 2px; margin: 0; padding: 0 10px 12px; list-style: none; }
@media (min-width: 640px) { .rn-terms__toc ol { grid-template-columns: 1fr 1fr; } }
.rn-terms__toc a { display: flex; gap: 10px; align-items: baseline; padding: 8px 10px; border-radius: 10px; color: #c4c5ca !important; font-size: 14.5px; text-decoration: none !important; }
.rn-terms__toc a:hover { background: #1b1c1f; color: #fff !important; }
.rn-terms__toc a span { font-size: 12px; font-weight: 700; color: var(--rn-green); }

.rn-terms__sec { margin-top: 12px; padding: 20px 18px; border: 1px solid #26272c; border-radius: 20px; background: #0f1012; scroll-margin-top: 96px; }
.rn-terms__h { display: flex; align-items: center; gap: 12px; margin: 0 0 12px; font-family: var(--rn-font-round); font-size: clamp(19px, 5.4vw, 24px); font-weight: 800; line-height: 1.2; color: #fff; }
.rn-terms__n { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: rgba(34, 242, 106, .12); border: 1px solid #1f5a37; color: var(--rn-green); font-family: var(--rn-font); font-size: 14px; font-weight: 800; }
.rn-terms__txt { font-size: 15px; line-height: 1.7; color: #b4b5ba; }
.rn-terms__txt p { margin: 0 0 12px; }
.rn-terms__txt p:last-child { margin-bottom: 0; }
.rn-terms__txt b { color: #fff; font-weight: 600; }
.rn-terms__txt a { color: var(--rn-green) !important; }
.rn-terms__txt ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
.rn-terms__txt ul + p { margin-top: 12px; }
.rn-terms__txt li { position: relative; padding-left: 20px; }
.rn-terms__txt li::before { content: ''; position: absolute; left: 2px; top: .68em; width: 7px; height: 7px; border-radius: 50%; background: var(--rn-green); }
.rn-terms__defs { display: grid; gap: 10px; margin: 0; }
.rn-terms__defs div { padding: 12px 14px; border: 1px solid #222327; border-radius: 14px; background: #141518; }
.rn-terms__defs dt { font-weight: 700; color: #fff; }
.rn-terms__defs dd { margin: 4px 0 0; }

.rn-terms__end { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-top: 26px; padding-top: 20px; border-top: 1px solid #26272c; }
.rn-terms__end p { margin: 0; font-size: 14px; color: #8d8e93; }
.rn-terms__back { display: inline-flex; padding: 12px 20px; border-radius: 14px; background: #22f26a; color: #04140a !important; font-weight: 700; text-decoration: none !important; }

