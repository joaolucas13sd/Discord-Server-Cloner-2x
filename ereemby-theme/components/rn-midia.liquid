  (function () {
    var img = document.getElementById('main-product-image');
    if (!img || img.dataset.rnMidia) return;
    img.dataset.rnMidia = '1';
    var box = img.parentElement;
    var PD = window.PRODUCT_DATA || {};
    function idDe(url) {
      var m = String(url || '').match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([A-Za-z0-9_-]{11})/);
      return m ? m[1] : (/^[A-Za-z0-9_-]{11}$/.test(String(url || '')) ? url : null);
    }
    function norm(t) { return String(t || '').trim().toLowerCase(); }
    function videos() {
      var lista = [];
      var doProduto = window.RN_MIDIA[norm(PD.title_base || PD.title)] || window.RN_MIDIA[norm(PD._nome)] || [];
      doProduto.forEach(function (v) { var i = idDe(v); if (i) lista.push(i); });
      var sv = PD.selectedVariant;
      var emb = (sv && sv.embed_video) || PD.embed_video;
      var e = idDe(emb); if (e && lista.indexOf(e) < 0) lista.push(e);
      if (sv && window.RN_MIDIA_JOGOS[norm(sv.name)]) { var t = window.RN_MIDIA_JOGOS[norm(sv.name)]; if (lista.indexOf(t) < 0) lista.unshift(t); }
      return lista.slice(0, Math.max(1, doProduto.length)); // 1 vídeo por produto, ou todos os da lista quando o produto tem vários
    }
    PD._nome = PD._nome || document.querySelector('[data-rn-pnome]') && document.querySelector('[data-rn-pnome]').getAttribute('data-rn-pnome');

    // camadas
    var stage = document.createElement('div'); stage.className = 'rn-md'; box.appendChild(stage);
    var strip = document.createElement('div'); strip.className = 'rn-md__strip'; box.insertAdjacentElement('afterend', strip);
    var slides = [], atual = 0;
    var NOMES = window.RN_MIDIA_NOMES || {};
    var PLAY = '<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 0 0 1.5.9l10.2-6.4a1 1 0 0 0 0-1.8L9.5 4.7A1 1 0 0 0 8 5.6Z"/></svg>';
    var YT = '<svg width="18" height="13" viewBox="0 0 28 20" aria-hidden="true"><rect width="28" height="20" rx="5" fill="#ff0033"/><path d="M11 5.5v9l7.5-4.5z" fill="#fff"/></svg>';

    function montar(irPara) {
      var vids = videos();
      slides = vids.map(function (id) { return { tipo: 'video', id: id }; }).concat([{ tipo: 'banner' }]);
      strip.innerHTML = slides.length < 2 ? '' : slides.map(function (s, i) {
        var bg = s.tipo === 'video' ? 'https://i.ytimg.com/vi/' + s.id + '/mqdefault.jpg' : img.src;
        return '<button type="button" class="rn-md__th' + (s.tipo === 'video' ? ' rn-md__th--v' : '') + '" data-i="' + i + '" aria-label="' + (s.tipo === 'video' ? (NOMES[s.id] ? 'Trailer ' + NOMES[s.id] : 'Vídeo ' + (i + 1)) : 'Imagem do produto') + '"><img src="' + bg + '" alt="" loading="lazy">' + (s.tipo === 'video' ? '<span class="rn-md__thp">' + PLAY + '</span>' : '') + '</button>';
      }).join('');
      strip.hidden = slides.length < 2;
      ir(irPara === 'banner' ? slides.length - 1 : Math.min(irPara || 0, slides.length - 1), false);
    }
    function ir(i, tocar) {
      atual = (i + slides.length) % slides.length;
      var s = slides[atual];
      if (!s || s.tipo === 'banner') { stage.innerHTML = slides.length > 1 ? setas() : ''; stage.classList.toggle('rn-md--banner', true); }
      else {
        stage.classList.remove('rn-md--banner');
        stage.innerHTML = tocar
          ? '<iframe src="https://www.youtube-nocookie.com/embed/' + s.id + '?autoplay=1&rel=0&playsinline=1&modestbranding=1" title="Vídeo do produto" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>' + setas()
          : '<button type="button" class="rn-md__poster" data-play="1" aria-label="Assistir ao vídeo"><img src="https://i.ytimg.com/vi/' + s.id + '/hqdefault.jpg" alt=""><span class="rn-md__play">' + PLAY + '</span><span class="rn-md__yt">' + YT + (NOMES[s.id] ? 'Trailer ' + NOMES[s.id] : 'Vídeo oficial') + '</span></button>' + setas();
      }
      strip.querySelectorAll('.rn-md__th').forEach(function (b, j) { b.classList.toggle('rn-md__th--on', j === atual); });
      var on = strip.querySelector('.rn-md__th--on'); if (on) strip.scrollTo({ left: on.offsetLeft - strip.clientWidth / 2 + on.offsetWidth / 2, behavior: 'smooth' });
    }
    function setas() {
      if (slides.length < 2) return '';
      return '<button type="button" class="rn-md__nav rn-md__nav--p" data-nav="-1" aria-label="Anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>' +
        '<button type="button" class="rn-md__nav rn-md__nav--n" data-nav="1" aria-label="Próximo"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>' +
        '<span class="rn-md__count">' + (atual + 1) + ' / ' + slides.length + '</span>';
    }
    stage.addEventListener('click', function (e) {
      var n = e.target.closest('[data-nav]'); if (n) { e.preventDefault(); ir(atual + (+n.dataset.nav), false); return; }
      if (e.target.closest('[data-play]')) { e.preventDefault(); ir(atual, true); }
    });
    strip.addEventListener('click', function (e) { var b = e.target.closest('.rn-md__th'); if (b) ir(+b.dataset.i, false); });
    // arrastar para o lado troca de mídia
    var x0 = null;
    stage.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', function (e) { if (x0 === null) return; var dx = e.changedTouches[0].clientX - x0; x0 = null; if (Math.abs(dx) > 50 && !stage.querySelector('iframe')) ir(atual + (dx < 0 ? 1 : -1), false); }, { passive: true });

    // quando a imagem do topo muda: outro jogo -> mostra o vídeo dele primeiro; jogo grátis escolhido -> mostra o banner
    function inicio() { return document.getElementById('rn-free-banner-tag') ? 'banner' : 0; }
    var ultimo = img.src, ultimaVar = PD.selectedVariant && PD.selectedVariant.id;
    new MutationObserver(function () {
      if (img.src === ultimo) return; ultimo = img.src; montar(inicio());
    }).observe(img, { attributes: true, attributeFilter: ['src'] });
    setInterval(function () {
      var v = PD.selectedVariant && PD.selectedVariant.id;
      if (v !== ultimaVar) { ultimaVar = v; montar(inicio()); }
    }, 400);
    montar(0);
  })();
