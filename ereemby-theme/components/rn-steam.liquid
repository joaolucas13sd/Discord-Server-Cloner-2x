<script>
  (function () {
    // Tudo aqui funciona mesmo quando a loja troca de página sem recarregar (voltar/avançar):
    // a vitrine é (re)montada sempre que aparece, e o rodízio/bolinhas/trailer olham sempre a vitrine atual.
    var POR_DIA = 5, DIA = 86400, BRT = 3 * 3600;
    var CATS = [['combos', 'Combos'], ['acao', 'Ação'], ['aventura', 'Aventura'], ['corrida', 'Corrida'], ['rpg', 'RPG'], ['simulacao', 'Simulação'], ['terror', 'Terror']];
    function esc(t) { return String(t).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }
    function brl(v) { return Number(v).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
    function norm(t) { return String(t || '').trim().toLowerCase(); }
    function diaHoje() { return Math.floor((Date.now() / 1000 - BRT) / DIA); }
    function el(id) { return document.getElementById(id); }

    function montar(sec) {
      var track = el('rn-steam-track'), dotsBox = el('rn-steam-dots');
      if (!track || !dotsBox || !window.RN_STEAM_JOGOS) return;
      sec.setAttribute('data-ok', '1');
      var base = sec.getAttribute('data-link');
      var vars = window.CATALOG_VARIANTS || [];
      function daLoja(nome) { var n = norm(nome); for (var i = 0; i < vars.length; i++) if (norm(vars[i].name) === n) return vars[i]; return null; }
      var lista = window.RN_STEAM_JOGOS.map(function (j) {
        var v = daLoja(j.n);
        var disp = !v ? true : (v.type === 'texto' || v.stock_amount > 0);
        return { j: j, v: v, disp: disp };
      });
      var disponiveis = lista.filter(function (x) { return x.disp; });
      var pool = disponiveis.length >= POR_DIA ? disponiveis : lista;
      var dia = Math.floor((Date.now() / 1000 - BRT) / DIA);
      var hoje = [];
      var MAPA = window.RN_CAT_JOGOS;
      if (MAPA && Object.keys(MAPA).length) {
        // 1 card por categoria; muda à meia-noite de Brasília. Dentro da categoria segue a ordem da loja
        // (mais jogados primeiro) e, a cada dia, passa para o próximo jogo dela. Esgotados ficam de fora.
        var ordem = function (x) { var i = x.v ? vars.indexOf(x.v) : -1; return i < 0 ? 1e6 : i; };
        CATS.forEach(function (c) {
          var daCat = lista.filter(function (x) {
            var n = norm(x.j.n);
            return c[0] === 'combos' ? n.indexOf('combo') === 0 : (n.indexOf('combo') !== 0 && MAPA[n] === c[0]);
          });
          var ok = daCat.filter(function (x) { return x.disp; });
          if (ok.length) daCat = ok;
          if (!daCat.length) return;
          daCat.sort(function (p, q) { return ordem(p) - ordem(q); });
          var x = daCat[dia % daCat.length];
          hoje.push({ j: x.j, v: x.v, disp: x.disp, cat: c[1] });
        });
      }
      if (!hoje.length) {
        // reserva (sem lista de categorias): 5 jogos seguidos da lista, avançando a cada dia
        var ini = (dia * POR_DIA) % pool.length;
        for (var k = 0; k < Math.min(POR_DIA, pool.length); k++) hoje.push(pool[(ini + k) % pool.length]);
      }

      track.innerHTML = hoje.map(function (x) {
        var j = x.j, v = x.v;
        var preco = v ? Number(v.price) : 15.99;
        var antigo = v && Number(v.comparison) > preco ? Number(v.comparison) : (j.p > preco ? j.p : 0);
        var off = antigo ? Math.round((1 - preco / antigo) * 100) : 0;
        var href = base + (v && base.indexOf('/product/') === 0 ? '/' + v.id : '');
        return '<article class="rn-steam__card" style="--rn-bg:url(\'' + esc(j.c) + '\')">' +
          '<a class="rn-steam__link" href="' + esc(href) + '" aria-label="' + esc(j.t) + ': comprar por ' + brl(preco) + '"></a>' +
          '<div class="rn-steam__hero"><img src="' + esc(j.c) + '" alt="' + esc(j.t) + '" loading="lazy">' +
            (j.y ? '<button type="button" class="rn-steam__trailer" data-trailer="' + esc(j.y) + '" data-title="' + esc(j.t) + '"><span class="rn-steam__play" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M3 1.6v8.8a.6.6 0 0 0 .9.5l7.2-4.4a.6.6 0 0 0 0-1L3.9 1.1a.6.6 0 0 0-.9.5Z" fill="currentColor"/></svg></span>Trailer</button>' : '') +
          '</div>' +
          '<div class="rn-steam__body">' +
            (x.cat ? '<span class="rn-steam__cat">' + esc(x.cat) + '</span>' : '') +
            '<h3 class="rn-steam__name">' + esc(j.t) + '</h3>' +
            '<div class="rn-steam__shots">' + j.s.map(function (s) { return '<button type="button" class="rn-steam__shot" data-src="' + esc(s) + '" aria-label="Ver imagem"><img src="' + esc(s) + '" alt="" loading="lazy"></button>'; }).join('') + '</div>' +
            '<div class="rn-steam__foot"><span class="rn-steam__logo"><svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-9.96 9.2l5.36 2.21a2.84 2.84 0 0 1 1.6-.49h.16l2.38-3.46v-.05a3.77 3.77 0 1 1 3.77 3.77h-.09l-3.4 2.43v.13a2.83 2.83 0 0 1-5.62.5L2.4 14.7A10 10 0 1 0 12 2Zm-4.34 15.2-1.23-.5a2.13 2.13 0 1 0 1.16-2.9l1.27.52a1.57 1.57 0 1 1-1.2 2.88Zm9.6-7.75a2.51 2.51 0 1 0-2.52 2.51 2.51 2.51 0 0 0 2.51-2.51Zm-4.4 0a1.89 1.89 0 1 1 1.89 1.89 1.89 1.89 0 0 1-1.89-1.89Z"/></svg></span><div class="rn-steam__prices">' +
              (antigo ? '<s class="rn-steam__old">' + brl(antigo) + '</s>' : '') +
              '<div class="rn-steam__now"><span class="rn-steam__price">' + brl(preco) + '</span>' + (off > 0 ? '<span class="rn-steam__off">-' + off + '%</span>' : '') + '</div>' +
              (x.disp ? '' : '<div class="rn-steam__esg">Esgotado</div>') +
            '</div></div>' +
          '</div></article>';
      }).join('');
      dotsBox.innerHTML = hoje.map(function (x, i) { return '<button type="button" class="rn-steam__dot' + (i === 0 ? ' rn-steam__dot--on' : '') + '" data-i="' + i + '" aria-label="' + (x.cat ? esc(x.cat) : 'Jogo ' + (i + 1)) + '"></button>'; }).join('');

      semRolagem();
    }

    function atual(track) {
      var cards = track.querySelectorAll('.rn-steam__card'), best = 0, dist = Infinity;
      if (track.scrollWidth <= track.clientWidth + 4) return 0;
      // no fim da faixa (vários cards visíveis, como no PC), marca a última bolinha
      if (cards.length && track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) return cards.length - 1;
      var tl = track.getBoundingClientRect().left;
      cards.forEach(function (c, i) { var d = Math.abs(c.getBoundingClientRect().left - tl); if (d < dist) { dist = d; best = i; } });
      return best;
    }
    function atualEsq(track) {
      var cards = track.querySelectorAll('.rn-steam__card'), best = 0, dist = Infinity, tl = track.getBoundingClientRect().left;
      cards.forEach(function (c, i) { var d = Math.abs(c.getBoundingClientRect().left - tl); if (d < dist) { dist = d; best = i; } });
      return best;
    }
    // posição de rolagem que deixa o card encostado no começo da faixa
    function posDe(track, c) { return track.scrollLeft + c.getBoundingClientRect().left - track.getBoundingClientRect().left; }
    function acender(i) {
      var box = el('rn-steam-dots'); if (!box) return;
      box.querySelectorAll('.rn-steam__dot').forEach(function (d, j) { d.classList.toggle('rn-steam__dot--on', i === j); });
    }
    function pintarDots() {
      var track = el('rn-steam-track'); if (!track) return;
      acender(atual(track));
    }
    function semRolagem() {
      var track = el('rn-steam-track'), box = el('rn-steam-dots'); if (!track || !box) return;
      box.style.display = track.scrollWidth <= track.clientWidth + 4 ? 'none' : '';
    }

    // a parte global só é ligada uma vez por visita
    if (window.__rnSteamOn) { var s0 = el('rn-steam'); if (s0 && !s0.getAttribute('data-ok')) montar(s0); return; }
    window.__rnSteamOn = true;

    // monta a vitrine sempre que ela aparece sem cards (primeira vez ou ao voltar para a página)
    function vigiar() { var sec = el('rn-steam'), t = el('rn-steam-track'); if (sec && t && (!sec.getAttribute('data-ok') || !t.children.length)) montar(sec); }
    vigiar(); setInterval(vigiar, 400);
    setInterval(function () { if (Date.now() > autoAte) pintarDots(); }, 700);

    // contador até os próximos jogos
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    var diaVisto = diaHoje();
    setInterval(function () {
      var novo = el('rn-steam-novo'); if (!novo) return;
      var dia = diaHoje();
      if (dia !== diaVisto) { diaVisto = dia; var sec = el('rn-steam'); if (sec) montar(sec); }
      var r = Math.max(0, Math.floor((dia + 1) * DIA + BRT - Date.now() / 1000));
      novo.innerHTML = '<span class="rn-steam__pulse"></span>Novos em <b>' + pad(Math.floor(r / 3600)) + ':' + pad(Math.floor(r % 3600 / 60)) + ':' + pad(r % 60) + '</b>';
    }, 1000);

    // bolinhas: acompanham a rolagem e levam ao card ao tocar
    document.addEventListener('scroll', function (e) { if (e.target && e.target.id === 'rn-steam-track') pintarDots(); }, true);
    window.addEventListener('resize', semRolagem);

    // passa sozinho: começa ~1s depois que a vitrine aparece na tela e depois avança 1 card a cada 3s;
    // no fim volta ao primeiro. Pausa quando o cliente arrasta a vitrine, com o mouse em cima ou com o trailer aberto.
    var pausaAte = 0, mouseDentro = false, autoAte = 0, proxEm = 0, viaAntes = false;
    function pausar(ms) { pausaAte = Date.now() + (ms || 5000); proxEm = 0; }
    // só o arrasto de lado (rolagem da faixa feita pelo cliente) pausa; rolar a página para baixo não pausa
    document.addEventListener('scroll', function (e) { if (e.target && e.target.id === 'rn-steam-track' && Date.now() > autoAte) pausar(); }, true);
    document.addEventListener('wheel', function (e) { if (e.target && e.target.closest && e.target.closest('#rn-steam-track') && Math.abs(e.deltaX) > Math.abs(e.deltaY)) pausar(); }, { passive: true, capture: true });
    document.addEventListener('mouseover', function (e) { mouseDentro = !!(e.target && e.target.closest && e.target.closest('#rn-steam-track')); });
    // encostou o dedo (ou o mouse) na vitrine: para de andar na hora, senão o celular cancela o toque como se fosse rolagem
    document.addEventListener('pointerdown', function (e) {
      var t = e.target && e.target.closest && e.target.closest('#rn-steam-track'); if (!t) return;
      pausar(e.target.closest('.rn-steam__shot') ? 15000 : 6000);
      if (Date.now() < autoAte) { autoAte = 0; t.scrollTo({ left: t.scrollLeft, behavior: 'auto' }); }
    }, { capture: true, passive: true });
    function naTela(t) { var r = t.getBoundingClientRect(); return r.bottom > 60 && r.top < window.innerHeight * 0.9; }
    setInterval(function () {
      var track = el('rn-steam-track');
      if (!track) { viaAntes = false; return; }
      var ve = naTela(track) && !document.hidden;
      if (!ve) { viaAntes = false; return; }
      var agora = Date.now();
      if (!viaAntes) { viaAntes = true; proxEm = agora + 1000; return; } // acabou de aparecer: primeiro pulo em 1s
      var modal = el('rn-trailer');
      if (mouseDentro || (modal && !modal.hidden) || agora < pausaAte) return;
      if (!proxEm) proxEm = agora + 1500;
      if (agora < proxEm) return;
      proxEm = agora + 3000;
      if (track.scrollWidth <= track.clientWidth + 4) return;
      var cards = track.querySelectorAll('.rn-steam__card');
      var fim = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      var prox = fim ? 0 : Math.min(cards.length - 1, atualEsq(track) + 1);
      var c = cards[prox]; if (!c) return;
      autoAte = agora + 1200;
      acender(prox);
      track.scrollTo({ left: prox === 0 ? 0 : posDe(track, c), behavior: 'smooth' });
    }, 200);

    // trailer do YouTube em janela por cima da loja
    function fechar() { var m = el('rn-trailer'), f = el('rn-trailer-frame'); if (!m) return; m.hidden = true; if (f) f.innerHTML = ''; document.body.style.overflow = ''; }
    function tocar(id, titulo) {
      var m = el('rn-trailer'), f = el('rn-trailer-frame'), y = el('rn-trailer-yt'); if (!m || !f) return;
      f.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&playsinline=1" title="' + esc(titulo || 'Trailer') + '" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>';
      if (y) y.href = 'https://www.youtube.com/watch?v=' + id;
      m.hidden = false; document.body.style.overflow = 'hidden';
    }
    document.addEventListener('click', function (e) {
      var t = e.target; if (!t || !t.closest) return;
      // tocar numa captura mostra ela grande no lugar do banner (tocar de novo volta a capa)
      var sh = t.closest('.rn-steam__shot');
      if (sh) {
        e.preventDefault(); e.stopPropagation(); pausar(12000);
        var card = sh.closest('.rn-steam__card'), hero = card && card.querySelector('.rn-steam__hero img');
        if (!hero) return;
        if (!hero.dataset.capa) hero.dataset.capa = hero.getAttribute('src');
        var ativo = sh.classList.contains('rn-steam__shot--on');
        card.querySelectorAll('.rn-steam__shot').forEach(function (o) { o.classList.remove('rn-steam__shot--on'); });
        if (!ativo) sh.classList.add('rn-steam__shot--on');
        card.classList.toggle('rn-steam__card--shot', !ativo);
        // mostra na hora a imagem que já está carregada (a da miniatura) e troca pela versão HD quando ela chegar
        var pedido = (hero._pedido || 0) + 1; hero._pedido = pedido;
        hero.src = ativo ? hero.dataset.capa : sh.dataset.src;
        if (!ativo) {
          var hd = new Image();
          hd.onload = function () { if (hero._pedido === pedido) hero.src = hd.src; };
          hd.src = sh.dataset.src.replace('.600x338.', '.1920x1080.');
        }
        return;
      }
      var b = t.closest('.rn-steam__trailer');
      if (b) { e.preventDefault(); e.stopPropagation(); tocar(b.dataset.trailer, b.dataset.title); return; }
      var d = t.closest('.rn-steam__dot');
      if (d) { var track = el('rn-steam-track'); var c = track && track.querySelectorAll('.rn-steam__card')[+d.dataset.i]; if (c) { pausar(); autoAte = Date.now() + 1200; acender(+d.dataset.i); track.scrollTo({ left: +d.dataset.i === 0 ? 0 : posDe(track, c), behavior: 'smooth' }); } return; }
      var m = el('rn-trailer');
      if (m && (t === m || t.closest('#rn-trailer-close'))) fechar();
    });
    document.addEventListener('keydown', function (e) { var m = el('rn-trailer'); if (e.key === 'Escape' && m && !m.hidden) fechar(); });
  })();
</script>
