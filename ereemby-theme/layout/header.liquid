<!-- Mobile Search Modal -->
<div id="mobile-search-modal" class="fixed inset-0 z-[60] hidden">
  <!-- Backdrop -->
  <div
    id="mobile-search-backdrop"
    class="absolute inset-0 bg-black/90 backdrop-blur-sm transition-opacity duration-300 opacity-0"
  ></div>

  <!-- Content -->
  <div
    id="mobile-search-content"
    class="relative bg-neutral-950 h-full flex flex-col transform translate-y-full transition-transform duration-300 ease-out"
  >
    <!-- Rei dos Nitros: busca que desce do topo -->
    <div class="rn-ms__bar">
      <div class="rn-ms__field">
        <svg class="rn-ms__lupa" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input
          id="mobile-search-input"
          type="search"
          placeholder="Buscar produto..."
          class="rn-ms__input"
          autocomplete="off"
          enterkeyhint="search"
        >
        <button id="mobile-search-clear" class="hidden rn-ms__clear" aria-label="Limpar busca">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <button id="mobile-search-close" class="rn-ms__cancel" aria-label="Fechar busca">Cancelar</button>
    </div>

    <div id="mobile-search-results" class="flex-1 overflow-y-auto px-4 py-4">
      <div class="rn-ms__label">Resultados</div>
      <div id="mobile-search-results-container" class="space-y-3"></div>
      <div id="mobile-search-empty-state" class="hidden py-16 text-center">
        <svg class="w-12 h-12 text-neutral-800 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="text-neutral-400 font-medium">Ops! Nada encontrado</p>
        <p class="text-neutral-600 text-sm mt-1">Tente pesquisar por outro nome.</p>
      </div>
    </div>
  </div>
</div>

