{% comment %} Rei dos Nitros: fitinha da Black Friday no topo {% endcomment %}
{% include 'rn-bf-fita' %}

<script>
  window.CATALOG_PRODUCTS = {{ catalog.products | json }};
  window.CATALOG_VARIANTS = {{ catalog.variants | json }};
</script>

<script src="{{ 'cart.js' | asset_url }}"></script>
<script src="{{ 'rn-brindes.js' | asset_url }}"></script>
<script src="{{ 'search.js' | asset_url }}"></script>
<script src="{{ 'wishlist.js' | asset_url }}"></script>
<script>window.RN_ASSET_JOGOS = "{{ 'rn-jogos.js' | asset_url }}"; window.RN_ASSET_SENSI = "{{ 'rn-sensi-art.js' | asset_url }}";</script>
<script src="{{ 'rn-extra.js' | asset_url }}"></script>
{% include 'rn-decos-dados' %}
<script src="{{ 'rn-mais.js' | asset_url }}"></script>
<script src="{{ 'rn-ideias.js' | asset_url }}"></script>

<style>
  @keyframes cartBadgePulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.35);
    }
    100% {
      transform: scale(1);
    }
  }
  .cart-badge-pulse {
    animation: cartBadgePulse 0.4s ease-in-out;
  }
  @keyframes dropdownIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .cart-dropdown-enter {
    animation: dropdownIn 0.2s ease-out forwards;
  }
  @keyframes cartItemSlide {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .cart-dropdown-item {
    animation: cartItemSlide 0.2s ease-out forwards;
  }
  @keyframes searchFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .search-results-active {
    animation: searchFadeIn 0.2s ease-out forwards;
  }

  /* Mobile-only: wishlist ancorada ao viewport (o carrinho virou painel próprio, ver rn-styles) */
  @media (max-width: 639px) {
    #wishlist-dropdown {
      position: fixed !important;
      top: 68px !important;
      left: 12px !important;
      right: 12px !important;
      width: auto !important;
      margin-top: 0 !important;
    }
  }
</style>

<script>
  (function () {
    function closeUser() {
      var d = document.getElementById('user-dropdown');
      if (!d || d.classList.contains('hidden')) return;
      d.classList.add('hidden');
      var b = document.getElementById('user-btn');
      if (b) b.setAttribute('aria-expanded', 'false');
      var c = document.getElementById('user-chevron');
      if (c) c.style.transform = '';
    }
    function closeCart() {
      if (window.EreembyCart && typeof window.EreembyCart.closeDropdown === 'function') {
        window.EreembyCart.closeDropdown();
      }
    }
    function closeWishlist() {
      if (window.EreembyWishlist && typeof window.EreembyWishlist.closeDropdown === 'function') {
        window.EreembyWishlist.closeDropdown();
      }
    }

    var BUTTONS = [
      { sel: '#cart-btn',     close: closeCart     },
      { sel: '#wishlist-btn', close: closeWishlist },
      { sel: '#user-btn',     close: closeUser     },
    ];

    document.addEventListener('click', function (e) {
      var clicked = null;
      for (var i = 0; i < BUTTONS.length; i++) {
        if (e.target.closest(BUTTONS[i].sel)) { clicked = BUTTONS[i]; break; }
      }
      if (!clicked) return;
      // Fecha todos os outros dropdowns antes de o botão clicado abrir o seu.
      for (var j = 0; j < BUTTONS.length; j++) {
        if (BUTTONS[j] !== clicked) BUTTONS[j].close();
      }
    }, true); // capture = true
  })();
</script>

<header class="bg-black border-b border-neutral-800 shadow-lg relative z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 rn-hrow">
      <div class="flex">
        <div class="flex items-center">
          <a href="/" class="flex items-center gap-2 pr-4">
            {% if store.icon %}
              <img src="{{ store.icon }}" alt="{{ store.name }}" class="rn-brand__logo object-cover flex-shrink-0">
            {% endif %}
            <span class="rn-brand line-clamp-2">
              {{- store.name | default: 'nome da loja' -}}
            </span>
          </a>
        </div>
      </div>

      <div class="hidden sm:flex flex-1 items-center justify-center px-4">
        <div class="max-w-lg w-full lg:max-w-xs relative group">
          <label for="search" class="sr-only">Pesquisar produtos</label>
          <div class="relative text-neutral-400 focus-within:text-white transition-all duration-300">
            <div class="pointer-events-none absolute inset-y-0 left-0 pl-3 flex items-center">
              <svg
                class="w-5 h-5 text-neutral-500 group-focus-within:text-white transition-colors"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <input
              id="search-input"
              name="search"
              class="block w-full bg-neutral-900/50 border border-neutral-800 rounded-xl py-2 pl-10 pr-10 text-sm placeholder-neutral-500 focus:outline-none focus:ring-1 focus:ring-white/30 focus:border-white/50 focus:bg-black transition-all"
              placeholder="Pesquisar produtos..."
              type="text"
              autocomplete="off"
            >
            <button
              id="search-clear"
              class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-neutral-500 hover:text-white transition-colors"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <!-- Search Results Dropdown -->
          <div
            id="search-results"
            class="hidden absolute left-0 sm:left-auto sm:right-0 mt-3 w-[calc(100vw-32px)] sm:w-96 bg-neutral-950 border border-neutral-800 rounded-2xl shadow-2xl shadow-black/80 backdrop-blur-md overflow-hidden z-50 transform origin-top transition-all duration-200"
          >
            <div class="px-4 py-2 border-b border-neutral-900 bg-neutral-900/40">
              <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest"
                >Resultado da pesquisa</span
              >
            </div>
            <div id="search-results-container" class="max-h-[70vh] sm:max-h-96 overflow-y-auto p-2 space-y-1">
              <!-- Results will be injected here -->
            </div>
            <div id="search-empty-state" class="hidden p-8 text-center bg-neutral-950">
              <svg
                class="w-10 h-10 text-neutral-800 mx-auto mb-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <p class="text-neutral-400 text-sm font-medium">Ops! Nada encontrado</p>
              <p class="text-neutral-600 text-xs mt-1">Tente pesquisar por outro nome.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Mobile Search Button -->
        <button
          id="mobile-search-btn"
          class="sm:hidden rn-hbtn"
          aria-label="Pesquisar"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        </button>

        <!-- Suporte (Rei dos Nitros): WhatsApp do painel, ou o Discord se não houver WhatsApp -->
        {% assign rn_support_link = 'https://discord.gg/dFr88Y8rJb' %}
        {% if social.whatsapp %}
          {% if social.whatsapp contains 'http' %}
            {% assign rn_support_link = social.whatsapp %}
          {% else %}
            {% assign rn_support_link = 'https://wa.me/' | append: social.whatsapp %}
          {% endif %}
        {% endif %}
        <a href="{{ rn_support_link }}" target="_blank" rel="noopener" class="rn-hbtn" aria-label="Suporte">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg>
        </a>

        <!-- Wishlist Button -->
        <div class="relative" id="wishlist-wrapper" style="display:none">
          <button
            id="wishlist-btn"
            class="relative group rn-hbtn"
            aria-label="Favoritos"
          >
            <svg
              class="w-6 h-6"
              stroke-width="2.2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            <span
              id="wishlist-badge"
              class="hidden absolute -top-1 -right-1 items-center justify-center w-5 h-5 text-[10px] font-extrabold text-black bg-white rounded-full shadow-lg shadow-white/20 border-2 border-black"
              >0</span
            >
          </button>

          <!-- Wishlist Dropdown -->
          <div
            id="wishlist-dropdown"
            class="hidden absolute right-0 top-full mt-2 w-96 bg-neutral-950 border border-neutral-800 rounded-2xl shadow-2xl shadow-black/80 overflow-hidden z-50"
          >
            <!-- Header -->
            <div class="flex items-center justify-between px-4 py-3 border-b border-neutral-800 bg-neutral-950">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                <span class="text-sm font-bold text-white">Favoritos</span>
                <span id="wishlist-dropdown-count" class="text-xs text-neutral-500">(0)</span>
              </div>
              <button
                id="wishlist-close-btn"
                class="p-1 rounded-lg text-neutral-500 hover:text-white hover:bg-neutral-800 transition-all duration-150 focus:outline-none"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>

            <!-- Items -->
            <div
              class="max-h-[calc(100vh-140px)] sm:max-h-[450px] overflow-y-auto overscroll-contain"
              style="scrollbar-width: thin; scrollbar-color: #404040 transparent;"
            >
              <!-- Empty state -->
              <div
                id="wishlist-empty-state"
                class="flex flex-col items-center justify-center py-10 px-4"
                style="display:flex;"
              >
                <svg class="w-10 h-10 text-neutral-700 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                <p class="text-neutral-500 text-sm font-medium">Nenhum favorito ainda</p>
                <p class="text-neutral-600 text-xs mt-0.5">Salve produtos que você gostou</p>
              </div>
              <!-- Items rendered by wishlist.js -->
              <div id="wishlist-items-container" class="p-2 space-y-2"></div>
            </div>
          </div>
        </div>

        <!-- Cart Button (wrapper for dropdown positioning) -->
        <div class="relative" id="cart-wrapper">
          <button
            id="cart-btn"
            class="relative group rn-hbtn rn-hbtn--green"
            aria-label="Carrinho"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7z"></path><path d="M9 10V6a3 3 0 0 1 6 0v4"></path></svg>
            <span
              id="cart-badge"
              class="hidden absolute -top-1 -right-1 items-center justify-center w-5 h-5 text-[10px] font-extrabold text-black bg-white rounded-full shadow-lg shadow-white/20 border-2 border-black"
              >0</span
            >
          </button>

          <!-- Cart Dropdown Menu (Rei dos Nitros: painel do carrinho) -->
          <div id="cart-dropdown" class="hidden rn-cart" role="dialog" aria-label="Seu carrinho">
            <div class="rn-cart__head">
              <h2 class="rn-cart__title">Seu carrinho</h2>
              <span id="cart-dropdown-count" class="rn-cart__count">0 itens</span>
              <button id="cart-close-btn" class="rn-cart__close" aria-label="Fechar carrinho">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </button>
            </div>

            <div id="cart-items-wrapper" class="rn-cart__body">
              <div id="cart-empty-state" class="rn-cart__empty" style="display:flex;">
                <span class="rn-cart__empty-ico"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1 13H7z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg></span>
                <p class="rn-cart__empty-t">Seu carrinho está vazio</p>
                <p class="rn-cart__empty-s">Comece por um dos favoritos da loja</p>
                <div class="rn-cart__sugs">
                  {% assign rn_cs_nomes = 'Discord Nitro|Conta Nitrada|Decorações de Perfil|Jogos Steam' | split: '|' %}
                  {% for nome in rn_cs_nomes %}{% for p in catalog.products %}{% if p.name == nome %}
                    <a class="rn-cart__sug" href="/product/{{ p.id }}">{% if p.images[0] %}<img src="{{ p.images[0] }}" alt="" loading="lazy">{% endif %}<span>{{ p.name }}</span><i aria-hidden="true">→</i></a>
                  {% endif %}{% endfor %}{% endfor %}
                </div>
              </div>
              <div id="cart-items-container" class="rn-cart__items"></div>
              <div id="rn-cart-promo"></div>
            </div>

            <div id="cart-dropdown-footer" class="rn-cart__foot" style="display:none;">
              <div class="rn-cart__total"><span>Total</span><strong id="cart-total-price">R$ 0,00</strong></div>
              <p class="rn-cart__note" id="rn-cart-note">Cupons de desconto são aplicados no checkout.</p>
              <button id="cart-checkout-btn" class="rn-cart__go">Ir para a compra <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="pointer-events:none"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
              <button type="button" class="rn-cart__keep" id="rn-cart-keep">Continuar comprando</button>
              <ul class="rn-cart__trust">
                <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>Pix com aprovação rápida</li>
                <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-8 9-4.500-1.5-8-4-8-9V6l8-3 8 3z"/><path d="m9 12 2 2 4-4"/></svg>7 dias de suporte</li>
                <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>Atendimento humano</li>
              </ul>
            </div>
          </div>
        </div>

        {% if user.name %}
          <!-- User Profile Button (wrapper for dropdown positioning) -->
          <div class="relative" id="user-wrapper">
            <button
              id="user-btn"
              class="rn-hbtn rn-hbtn--user"
              aria-label="Perfil"
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <span class="rn-hbtn__ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></span>
              <span class="hidden sm:flex flex-col items-start leading-tight min-w-0">
                <span class="text-[10px] font-bold uppercase tracking-widest text-neutral-500">Perfil</span>
                <span class="text-xs font-semibold text-white truncate max-w-[140px]">{{ user.name }}</span>
              </span>
              <svg id="user-chevron" class="hidden sm:block w-3 h-3 text-neutral-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- User Dropdown Menu -->
            <div
              id="user-dropdown"
              class="hidden absolute right-0 top-full mt-2 rn-um z-50"
              role="menu"
              aria-labelledby="user-btn"
            >
              <!-- Rei dos Nitros: cabeçalho do menu do perfil -->
              <div class="rn-um__head">
                <span class="rn-um__avatar" aria-hidden="true">{{ user.name | default: 'C' | slice: 0, 1 | upcase }}</span>
                <div class="rn-um__who">
                  <span class="rn-um__hi">Olá,</span>
                  <p class="rn-um__name">{{ user.name }}</p>
                  {% if user.email %}<p class="rn-um__mail">{{ user.email }}</p>{% endif %}
                </div>
              </div>

              <!-- Itens do menu -->
              <nav class="rn-um__list" role="none">
                <a href="/account/my_purchases" class="rn-um__item" role="menuitem">
                  <span class="rn-um__ico rn-um__ico--buy"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg></span>
                  <span class="rn-um__txt"><b>Minhas compras</b><small>Pedidos e produtos entregues</small></span>
                  <svg class="rn-um__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
                <a href="/account/affiliate" class="rn-um__item" role="menuitem">
                  <span class="rn-um__ico rn-um__ico--aff"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg></span>
                  <span class="rn-um__txt"><b>Área de afiliado</b><small>Ganhe indicando a loja</small></span>
                  <svg class="rn-um__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
                <a href="/cashback" class="rn-um__item" role="menuitem">
                  <span class="rn-um__ico rn-um__ico--cash"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="5"/><path d="M18.1 10.4A5 5 0 1 1 10.4 18.1"/><path d="M7 6h1v4"/><path d="m16.7 13.9.7.7-2.8 2.8"/></svg></span>
                  <span class="rn-um__txt"><b>Cashback</b><small>Dinheiro de volta nas compras</small></span>
                  <svg class="rn-um__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
                <a href="/regras" class="rn-um__item" role="menuitem">
                  <span class="rn-um__ico rn-um__ico--rules"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span>
                  <span class="rn-um__txt"><b>Regras e termos</b><small>Garantia, trocas e uso</small></span>
                  <svg class="rn-um__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
                <a href="https://discord.gg/dFr88Y8rJb" class="rn-um__item" role="menuitem" target="_blank" rel="noopener">
                  <span class="rn-um__ico rn-um__ico--dc"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.2a18.3 18.3 0 0 0-5.5 0L8.6 3a19.7 19.7 0 0 0-4.9 1.4C.5 9 -.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2a13.1 13.1 0 0 1-1.9-.9l.4-.3a14 14 0 0 0 12.2 0l.4.3c-.6.4-1.2.7-1.9.9l1.3 2a19.8 19.8 0 0 0 6-3c.5-5.2-.8-9.7-3.6-13.7ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg></span>
                  <span class="rn-um__txt"><b>Suporte no Discord</b><small>Tire dúvidas com a equipe</small></span>
                  <svg class="rn-um__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>

                <form action="/api/auth/logout" method="POST" class="m-0">
                  <button type="submit" class="rn-um__item rn-um__out" role="menuitem">
                    <span class="rn-um__ico rn-um__ico--out"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg></span>
                    <span class="rn-um__txt"><b>Sair da conta</b></span>
                  </button>
                </form>
              </nav>
            </div>
          </div>

          <script>
            (function () {
              var btn = document.getElementById('user-btn');
              var dropdown = document.getElementById('user-dropdown');
              var chevron = document.getElementById('user-chevron');
              if (!btn || !dropdown) return;

              function setOpen(open) {
                if (open) {
                  dropdown.classList.remove('hidden');
                  btn.setAttribute('aria-expanded', 'true');
                  if (chevron) chevron.style.transform = 'rotate(180deg)';
                } else {
                  dropdown.classList.add('hidden');
                  btn.setAttribute('aria-expanded', 'false');
                  if (chevron) chevron.style.transform = '';
                }
              }

              btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                setOpen(dropdown.classList.contains('hidden'));
              });

              document.addEventListener('click', function (e) {
                if (dropdown.classList.contains('hidden')) return;
                if (e.target.closest('#user-dropdown') || e.target.closest('#user-btn')) return;
                setOpen(false);
              });

              document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !dropdown.classList.contains('hidden')) setOpen(false);
              });
            })();
          </script>
        {% else %}
          <!-- Mobile: login icon (links direto p/ /login) -->
          <a
            href="/login"
            class="sm:hidden rn-hbtn"
            aria-label="Entrar"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
          </a>
          <!-- Desktop: botão "Entrar" -->
          <a href="/login" class="hidden sm:flex sm:items-center">
            <button class="bg-white p-1 rounded-full text-black hover:bg-neutral-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-black focus:ring-white px-4 py-2 text-sm transition-colors font-semibold">
              Entrar
            </button>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</header>

